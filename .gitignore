# ==========================================
# Archivo .gitignore para Proyecto Fullstack
# (Node.js / Astro, Java / Spring Boot, Python)
# ==========================================

# ------------------------------------------
# 1. Archivos de entorno y secretos
# ------------------------------------------
.env
.env.*
*.env
!.env.example
!.env.template

# ------------------------------------------
# 2. Node.js / Frontend (Astro / Vite / etc.)
# ------------------------------------------
node_modules/
dist/
.astro/
build/
.output/
.next/
.cache/
.parcel-cache/
.turbo/

# Logs de gestores de paquetes
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# 3. Java / Spring Boot / Maven / Gradle
# ------------------------------------------
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/

# ------------------------------------------
# 4. Python / Data Science
# ------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ------------------------------------------
# 5. IDEs y Editores de código
# ------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~
.classpath
.project
.settings/
.springBeans
.sts4-cache
.factorypath
.apt_generated

# ------------------------------------------
# 6. Sistema Operativo / Archivos Temporales
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*.tmp
*.temp
*.log
