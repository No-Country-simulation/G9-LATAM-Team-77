# Copia este archivo como .env.docker y reemplaza todos los valores change-me.
MYSQL_DATABASE=financeia
MYSQL_USER=financeia_app
MYSQL_PASSWORD=change-me-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=change-me-with-a-different-root-password
JWT_SECRET=change-me-with-at-least-64-random-characters
AUTH_SECRET=change-me-with-an-independent-random-secret
PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4321
DATA_SCIENCE_TIMEOUT_SECONDS=30
