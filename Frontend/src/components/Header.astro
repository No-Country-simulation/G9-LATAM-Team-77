---
import { API_URL } from '../lib/api';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
const hasServerSession = !!session;
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/^\/|\/$/g, '');
const isAuthPage = currentPath === 'login' || currentPath === 'logout';
const isLegalPage = currentPath === 'terminos' || currentPath === 'privacidad';
const hideTotalAhorrado = isAuthPage || isLegalPage;
const isLogoutPage = currentPath === 'logout';

const googleImage = session?.user?.image || '';
const googleName = session?.user?.name || '';
const googleEmail = session?.user?.email || '';
---

<header class="w-full border-b border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/90 backdrop-blur-md sticky top-0 z-50 transition-colors">
    <div class="px-3.5 sm:px-5 md:px-6 py-2 sm:py-2.5">
        
        <!-- Fila 1: Logo & Desktop Navigation a la izquierda; Controles a la derecha -->
        <div class="flex items-center justify-between gap-2 sm:gap-4">
            
            <!-- Left: Brand Logo & Desktop Navigation -->
            <div class="flex items-center gap-3 sm:gap-6 min-w-0 flex-shrink-0">
                <a href="/" class="flex items-center space-x-1.5 sm:space-x-2 group flex-shrink-0">
                    <div class="flex space-x-1 group-hover:scale-105 transition-transform">
                        <div class="w-2.5 h-2.5 rounded-full bg-blue-600"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-red-500"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
                    </div>
                    <span class="font-bold text-base sm:text-lg md:text-xl tracking-tight text-gray-900 dark:text-white font-josefin">FinanceAI</span>
                </a>

                <!-- Desktop Nav Links (Visible en pantallas medianas y grandes md+) -->
                {!isAuthPage && (
                    <nav id="desktopNav" class={`hidden md:flex items-center space-x-4 lg:space-x-6 text-xs sm:text-sm font-medium font-inter flex-shrink-0 ${isLegalPage && !hasServerSession ? 'hidden' : ''}`}>
                        <a href="/dashboard"
                            class={`pb-0.5 sm:pb-1 transition-colors ${currentPath === 'dashboard' || currentPath === '' ? 'border-b-2 border-blue-600 text-blue-600 dark:text-blue-400 font-semibold' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'}`}>
                            Dashboard
                        </a>
                        <a href="/historial"
                            class={`pb-0.5 sm:pb-1 transition-colors ${currentPath === 'historial' ? 'border-b-2 border-blue-600 text-blue-600 dark:text-blue-400 font-semibold' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'}`}>
                            Historial
                        </a>
                    </nav>
                )}
            </div>

            <!-- Right Controls: Desktop All Controls, Mobile Top Action Buttons -->
            {!isLogoutPage && (
                <div id="navRightControls" class="flex items-center gap-1.5 sm:gap-2.5 md:gap-3 flex-shrink-0">
                    
                    <!-- Desktop Total Ahorrado Badge (Visible en md+) -->
                    {!hideTotalAhorrado && (
                        <div id="navSaldoFavorPillDesktop" class="hidden md:flex items-center gap-1.5 px-2.5 sm:px-3 py-1 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 rounded-full text-xs font-semibold text-emerald-700 dark:text-emerald-300 shadow-sm cursor-pointer select-none transition hover:bg-emerald-100/70 dark:hover:bg-emerald-900/50 flex-shrink-0" title="Total Ahorrado General (Click para mostrar u ocultar)">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse flex-shrink-0 nav-saldo-dot"></span>
                            <span class="hidden xl:inline text-[10px] sm:text-xs text-emerald-700 dark:text-emerald-300 font-bold uppercase tracking-wider nav-saldo-label">Total Ahorrado:</span>
                            <span class="font-bold font-mono text-emerald-600 dark:text-emerald-400 text-xs sm:text-sm nav-saldo-text">••••••</span>
                            <button type="button" class="text-emerald-600 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-200 focus:outline-none flex items-center justify-center p-0.5 cursor-pointer btn-toggle-nav-eye" aria-label="Mostrar u ocultar saldo">
                                <svg class="w-3.5 h-3.5 hidden icon-nav-eye-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                <svg class="w-3.5 h-3.5 block icon-nav-eye-closed" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                </svg>
                            </button>
                            
                            <span class="text-emerald-300 dark:text-emerald-700/80 font-light select-none nav-saldo-sep">|</span>

                            <select class="nav-currency-select bg-transparent text-[10px] sm:text-xs font-bold text-emerald-700 dark:text-emerald-300 focus:outline-none cursor-pointer pr-0.5 border-none outline-none" title="Seleccionar divisa" aria-label="Seleccionar divisa" onclick="event.stopPropagation()">
                                <option value="USD" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">USD</option>
                                <option value="MXN" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">MXN</option>
                                <option value="EUR" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">EUR</option>
                                <option value="CRC" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">CRC</option>
                                <option value="COP" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">COP</option>
                                <option value="ARS" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">ARS</option>
                                <option value="CLP" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">CLP</option>
                                <option value="PEN" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">PEN</option>
                                <option value="HNL" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">HNL</option>
                                <option value="BRL" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">BRL</option>
                            </select>
                        </div>
                    )}

                    <!-- Backend Indicator (Desktop only) -->
                    <div id="backendIndicator" class={`items-center gap-1.5 text-[10px] sm:text-xs text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full flex-shrink-0 ${isLegalPage && !hasServerSession ? 'hidden' : 'hidden lg:flex'}`}>
                        <span id="backendDot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                        <span id="backendStatusText" class="hidden sm:inline">Backend...</span>
                    </div>

                    <!-- Dark mode toggle -->
                    <button type="button" id="themeToggle"
                        aria-label="Cambiar tema"
                        class="w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors text-gray-600 dark:text-gray-300 cursor-pointer flex-shrink-0">
                        <svg id="iconSun" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
                        </svg>
                        <svg id="iconMoon" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"/>
                        </svg>
                    </button>

                    <!-- User Profile Avatar & Logout Button -->
                    {!isAuthPage && (
                        <div id="userProfileSection" class={`relative items-center flex-shrink-0 ${isLegalPage && !hasServerSession ? 'hidden' : 'flex'}`}>
                            <button id="btnOpenProfileModal" onclick="window.openProfileModal && window.openProfileModal()" class="flex items-center p-0.5 rounded-full ring-2 ring-transparent hover:ring-blue-500 transition-all focus:outline-none cursor-pointer" title="Mi Perfil y Ajustes">
                                <img id="navUserAvatar" src={googleImage || "https://api.dicebear.com/7.x/bottts/svg?seed=FinanceAI1"} alt="Avatar de usuario" class="w-7 h-7 sm:w-8 sm:h-8 rounded-full object-cover border border-gray-200 dark:border-gray-700 shadow-sm" />
                            </button>
                        </div>

                        <button type="button" id="authNavBtn"
                            onclick="window.openLogoutModal && window.openLogoutModal()"
                            class={`text-[10px] sm:text-xs font-semibold px-2 py-1 sm:px-2.5 sm:py-1.5 bg-gray-100 dark:bg-gray-800 hover:bg-red-600 hover:text-white text-gray-700 dark:text-gray-200 rounded-xl transition-colors cursor-pointer flex items-center gap-1 flex-shrink-0 ${isLegalPage && !hasServerSession ? 'hidden' : 'flex'}`}
                            title="Cerrar Sesión">
                            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                            <span class="hidden sm:inline">Cerrar Sesión</span>
                        </button>
                    )}
                </div>
            )}
        </div>

        <!-- Fila 2 (Móviles < md): Links de navegación y Total Ahorrado -->
        {!isAuthPage && !isLogoutPage && (
            <div id="mobileSecondRow" class={`md:hidden flex items-center justify-between pt-2 mt-2 border-t border-gray-100 dark:border-gray-800/80 gap-2 ${isLegalPage && !hasServerSession ? 'hidden' : 'flex'}`}>
                <!-- Navigation Tabs -->
                <nav id="mobileNav" class="flex items-center space-x-4 text-xs font-medium font-inter flex-shrink-0">
                    <a href="/dashboard"
                        class={`pb-0.5 transition-colors ${currentPath === 'dashboard' || currentPath === '' ? 'border-b-2 border-blue-600 text-blue-600 dark:text-blue-400 font-semibold' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'}`}>
                        Dashboard
                    </a>
                    <a href="/historial"
                        class={`pb-0.5 transition-colors ${currentPath === 'historial' ? 'border-b-2 border-blue-600 text-blue-600 dark:text-blue-400 font-semibold' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'}`}>
                        Historial
                    </a>
                </nav>

                <!-- Mobile Total Ahorrado Badge -->
                {!hideTotalAhorrado && (
                    <div id="navSaldoFavorPillMobile" class="flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 rounded-full text-xs font-semibold text-emerald-700 dark:text-emerald-300 shadow-sm cursor-pointer select-none transition hover:bg-emerald-100/70 dark:hover:bg-emerald-900/50 flex-shrink-0" title="Total Ahorrado General (Click para mostrar u ocultar)">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse flex-shrink-0 nav-saldo-dot"></span>
                        <span class="font-bold font-mono text-emerald-600 dark:text-emerald-400 text-xs nav-saldo-text">••••••</span>
                        <button type="button" class="text-emerald-600 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-200 focus:outline-none flex items-center justify-center p-0.5 cursor-pointer btn-toggle-nav-eye" aria-label="Mostrar u ocultar saldo">
                            <svg class="w-3.5 h-3.5 hidden icon-nav-eye-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                            <svg class="w-3.5 h-3.5 block icon-nav-eye-closed" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                            </svg>
                        </button>
                        
                        <span class="text-emerald-300 dark:text-emerald-700/80 font-light select-none">|</span>

                        <select class="nav-currency-select bg-transparent text-[10px] font-bold text-emerald-700 dark:text-emerald-300 focus:outline-none cursor-pointer pr-0.5 border-none outline-none" title="Seleccionar divisa" aria-label="Seleccionar divisa" onclick="event.stopPropagation()">
                            <option value="USD" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">USD</option>
                            <option value="MXN" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">MXN</option>
                            <option value="EUR" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">EUR</option>
                            <option value="CRC" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">CRC</option>
                            <option value="COP" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">COP</option>
                            <option value="ARS" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">ARS</option>
                            <option value="CLP" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">CLP</option>
                            <option value="PEN" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">PEN</option>
                            <option value="HNL" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">HNL</option>
                            <option value="BRL" class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white">BRL</option>
                        </select>
                    </div>
                )}
            </div>
        )}
    </div>
</header>

<!-- Modal Centrado de Confirmación de Cierre de Sesión (Overlay Difuminado) -->
<div id="headerLogoutModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-gray-900/70 backdrop-blur-xl animate-fade-in font-inter p-3 sm:p-4">
    <div class="bg-white/95 dark:bg-gray-900/95 backdrop-blur-2xl rounded-2xl sm:rounded-3xl shadow-2xl p-6 sm:p-10 max-w-md w-full border border-gray-200 dark:border-gray-800 text-center animate-scale-in">
        <div class="w-14 h-14 sm:w-16 sm:h-16 mx-auto bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-2xl flex items-center justify-center mb-4 sm:mb-5 shadow-inner border border-gray-200 dark:border-gray-700">
            <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
        </div>
        
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-gray-900 dark:text-white mb-2 font-josefin">¿Cerrar Sesión?</h2>
        
        <p class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm mb-5 sm:mb-6 leading-relaxed">
            ¿Estás seguro de que deseas salir de tu cuenta? Tendrás que volver a iniciar sesión para acceder a tu panel.
        </p>
        
        <div class="space-y-2.5">
            <button id="btnHeaderConfirmSignout" onclick="window.confirmHeaderSignout && window.confirmHeaderSignout()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 sm:py-3 px-4 rounded-xl transition shadow-md hover:shadow-lg text-xs sm:text-sm cursor-pointer">
                Sí, salir de mi cuenta
            </button>
            <button id="btnHeaderCancelSignout" onclick="window.closeLogoutModal && window.closeLogoutModal()" class="w-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold py-2 sm:py-2.5 px-4 rounded-xl transition text-xs sm:text-sm cursor-pointer">
                Cancelar
            </button>
        </div>
    </div>
</div>

<!-- Modal de Perfil de Usuario y Ajustes (Con Cierre al Hacer Clic Afuera y Botón Grande) -->
<div id="userProfileModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-gray-900/70 backdrop-blur-md animate-fade-in font-inter p-3 sm:p-4">
    <div id="userProfileCard" class="bg-white dark:bg-gray-900 w-full max-w-lg rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-2xl border border-gray-200 dark:border-gray-800 text-left animate-scale-in max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="flex justify-between items-center pb-3 sm:pb-4 border-b border-gray-100 dark:border-gray-800">
            <div>
                <h3 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white font-josefin">Mi Perfil y Ajustes</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400">Personaliza tu cuenta</p>
            </div>
            <!-- Botón de Cerrar Grande -->
            <button id="btnCloseProfileModal" onclick="window.closeProfileModal && window.closeProfileModal()" class="text-gray-400 hover:text-gray-900 dark:hover:text-white text-2xl sm:text-3xl font-bold w-9 h-9 sm:w-10 sm:h-10 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center transition-all leading-none cursor-pointer" title="Cerrar">&times;</button>
        </div>

        <div class="py-4 sm:py-6 space-y-4 sm:space-y-6">
            <!-- User Basic Info -->
            <div class="flex items-center gap-3 sm:gap-4 p-3.5 sm:p-4 bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-200/60 dark:border-gray-700/60">
                <img id="modalCurrentAvatar" src={googleImage || "https://api.dicebear.com/7.x/bottts/svg?seed=FinanceAI1"} alt="Foto de perfil actual" class="w-12 h-12 sm:w-16 sm:h-16 rounded-full object-cover border-2 border-blue-500 shadow-md flex-shrink-0" />
                <div class="min-w-0 flex-1">
                    <h4 id="modalUserName" class="text-sm sm:text-base font-bold text-blue-600 dark:text-blue-400 truncate">{googleName || "Usuario FinanceAI"}</h4>
                    <p id="modalUserEmail" class="text-xs text-gray-500 dark:text-gray-400 truncate">{googleEmail || "usuario@correo.com"}</p>
                    <span class="inline-block mt-1 text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">Cuenta Activa</span>
                </div>
            </div>

            <!-- Selector de Avatares -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2">Selecciona tu Foto de Perfil</label>
                <div class="grid grid-cols-4 sm:grid-cols-6 gap-2 sm:gap-2.5 pt-1" id="avatarGrid">
                    <!-- Dynamic avatar grid -->
                </div>
            </div>

            <!-- Selector de Moneda Predeterminada -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Moneda Base</label>
                <p class="text-[11px] text-gray-500 mb-2">Tus análisis y presupuestos se calcularán automáticamente en esta divisa.</p>
                <select id="profileCurrencySelect" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
                    <option value="USD">USD ($) - Dólar Estadounidense</option>
                    <option value="CRC">CRC (₡) - Colón Costarricense</option>
                    <option value="MXN">MXN ($) - Peso Mexicano</option>
                    <option value="EUR">EUR (€) - Euro</option>
                    <option value="COP">COP ($) - Peso Colombiano</option>
                    <option value="ARS">ARS ($) - Peso Argentino</option>
                    <option value="CLP">CLP ($) - Peso Chileno</option>
                    <option value="PEN">PEN (S/) - Sol Peruano</option>
                    <option value="HNL">HNL (L) - Lempira Hondureño</option>
                    <option value="BRL">BRL (R$) - Real Brasileño</option>
                </select>
            </div>

            <!-- Save Profile Button -->
            <button id="btnSaveProfileSettings" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition text-sm shadow-sm">
                Guardar Cambios
            </button>

            <!-- Sección: Privacidad y Derechos ARCO (LFPDPPP & GDPR) -->
            <div class="pt-5 border-t border-gray-100 dark:border-gray-800 space-y-3.5">
                <div class="flex items-center justify-between">
                    <h5 class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white font-josefin flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                        Privacidad y Derechos
                    </h5>
                </div>
                
                <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
                    Como titular de tus datos personales, puedes ejercer tus derechos de Acceso, Rectificación, Cancelación y Oposición:
                </p>

                <!-- Grid de Acciones ARCO -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
                    <!-- 1. Acceso: Descargar Copia de Datos -->
                    <button type="button" id="btnArcoExportData" class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-2xl bg-gray-50 dark:bg-gray-800/70 hover:bg-gray-100 dark:hover:bg-gray-800 border border-gray-200/80 dark:border-gray-700/80 text-left transition group cursor-pointer">
                        <div class="w-8 h-8 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                        </div>
                        <div>
                            <strong class="text-xs font-semibold text-gray-900 dark:text-white block">Derecho de Acceso</strong>
                            <span class="text-[10px] text-gray-500 dark:text-gray-400">Descargar expediente (.PDF)</span>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Danger Zone: Eliminar Cuenta (Letra más grande y legible) -->
            <div class="pt-5 border-t border-red-100 dark:border-red-900/30">
                <h5 class="text-sm sm:text-base font-bold text-red-600 dark:text-red-400 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    ZONA DE PELIGRO
                </h5>
                <p class="text-xs text-gray-600 dark:text-gray-400 mb-3.5 leading-relaxed">
                    Eliminar tu cuenta borrará todos tus datos financieros, transacciones, registros y configuraciones de forma permanente e irreversible de la base de datos (Derecho de Cancelación).
                </p>
                <button id="btnOpenDeleteAccountModal" onclick="window.openDeleteAccountModal && window.openDeleteAccountModal()" class="px-4 py-2.5 text-xs sm:text-sm font-bold text-red-600 hover:text-white bg-red-50 dark:bg-red-900/20 hover:bg-red-600 border border-red-200 dark:border-red-800 rounded-xl transition-colors shadow-sm cursor-pointer">
                    Eliminar mi cuenta
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmación Eliminar Cuenta -->
<div id="deleteAccountConfirmModal" class="hidden fixed inset-0 z-[110] flex items-center justify-center bg-gray-900/80 backdrop-blur-md font-inter">
    <div id="deleteAccountCard" class="bg-white dark:bg-gray-900 max-w-sm w-full mx-4 rounded-3xl p-8 shadow-2xl border border-red-300 dark:border-red-800 text-center animate-scale-in">
        <div class="w-16 h-16 mx-auto bg-red-100 dark:bg-red-900/30 text-red-600 rounded-full flex items-center justify-center mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white font-josefin mb-2">¿Eliminar Cuenta Definitivamente?</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-6 leading-relaxed">
            Esta acción es irreversible. Se eliminará tu acceso, historial y transacciones asociadas en la base de datos.
        </p>
        
        <div class="space-y-2.5">
            <button id="btnConfirmDeleteAccount" onclick="window.confirmDeleteAccount && window.confirmDeleteAccount()" class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-3 rounded-xl transition text-xs sm:text-sm cursor-pointer">
                Sí, eliminar definitivamente
            </button>
            <button id="btnCancelDeleteAccount" onclick="window.closeDeleteAccountModal && window.closeDeleteAccountModal()" class="w-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 text-gray-700 dark:text-gray-300 font-semibold py-2.5 rounded-xl transition text-xs sm:text-sm cursor-pointer">
                Cancelar
            </button>
        </div>
    </div>
</div>

<!-- Modal para Seleccionar Divisa del PDF ARCO -->
<div id="pdfCurrencyExportModal" class="hidden fixed inset-0 z-[120] flex items-center justify-center bg-gray-900/70 backdrop-blur-md p-4 font-inter">
    <div class="bg-white dark:bg-gray-900 max-w-md w-full rounded-3xl p-6 sm:p-7 shadow-2xl border border-gray-200 dark:border-gray-800 animate-scale-in">
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-gray-100 dark:border-gray-800">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg font-bold flex-shrink-0 border border-emerald-200 dark:border-emerald-800">
                    📄
                </div>
                <div>
                    <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white font-josefin">Exportar Expediente PDF</h3>
                    <p class="text-[11px] text-gray-500 dark:text-gray-400">Certificado Oficial ARCO de Acceso a Datos</p>
                </div>
            </div>
            <button type="button" id="btnClosePdfExportModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-white text-xl font-bold p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition">&times;</button>
        </div>

        <p class="text-xs text-gray-600 dark:text-gray-300 mb-4 leading-relaxed">
            Selecciona la divisa en la que deseas que se calculen, conviertan y expresen todos los balances, ingresos, gastos y transacciones en tu documento oficial:
        </p>

        <div class="mb-5">
            <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Moneda del Documento</label>
            <select id="pdfTargetCurrencySelect" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 dark:text-white cursor-pointer font-medium">
                <option value="USD">USD ($) - Dólar Estadounidense</option>
                <option value="MXN">MXN ($) - Peso Mexicano</option>
                <option value="EUR">EUR (€) - Euro</option>
                <option value="CRC">CRC (₡) - Colón Costarricense</option>
                <option value="COP">COP ($) - Peso Colombiano</option>
                <option value="ARS">ARS ($) - Peso Argentino</option>
                <option value="CLP">CLP ($) - Peso Chileno</option>
                <option value="PEN">PEN (S/) - Sol Peruano</option>
                <option value="HNL">HNL (L) - Lempira Hondureño</option>
                <option value="BRL">BRL (R$) - Real Brasileño</option>
            </select>
        </div>

        <div class="flex gap-2.5">
            <button type="button" id="btnCancelPdfExportModal" class="flex-1 px-4 py-2.5 text-xs font-semibold text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-xl transition cursor-pointer">
                Cancelar
            </button>
            <button type="button" id="btnConfirmGeneratePdf" class="flex-1 px-4 py-2.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl transition shadow-sm flex items-center justify-center gap-1.5 cursor-pointer shadow-emerald-600/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Descargar PDF
            </button>
        </div>
    </div>
</div>

<script define:vars={{ API_URL, hasServerSession, googleImage, googleName, googleEmail, isLogoutPage, isLegalPage }}>
    // Theme toggle
    function updateThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        const sun = document.getElementById('iconSun');
        const moon = document.getElementById('iconMoon');
        if (sun) sun.style.display = isDark ? 'block' : 'none';
        if (moon) moon.style.display = isDark ? 'none' : 'block';
    }

    window.toggleTheme = function() {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
            html.classList.remove('dark');
            localStorage.setItem('theme', 'light');
        } else {
            html.classList.add('dark');
            localStorage.setItem('theme', 'dark');
        }
        updateThemeIcons();
    };
    document.getElementById('themeToggle')?.addEventListener('click', window.toggleTheme);
    updateThemeIcons();

    // 12 Avatares Robots (Femeninos y Masculinos con fondos de diferentes colores)
    const predefinedAvatars = [
        ...(googleImage ? [googleImage] : []),
        // Robots Femeninos (Fondos rosas, lilas, magenta, coral)
        "https://api.dicebear.com/7.x/bottts/svg?seed=Luna&backgroundColor=ffd5dc",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Sophie&backgroundColor=c0aede",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Bella&backgroundColor=ffc6ff",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Chloe&backgroundColor=f3c4fb",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Mia&backgroundColor=ffd1dc",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Zoe&backgroundColor=ffb5a7",
        // Robots Masculinos (Fondos azul cielo, índigo, ámbar, esmeralda, turquesa, menta)
        "https://api.dicebear.com/7.x/bottts/svg?seed=Leo&backgroundColor=b6e3f4",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Max&backgroundColor=d1d4f9",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Felix&backgroundColor=ffdfbf",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Alex&backgroundColor=bbecb8",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Titan&backgroundColor=c5e3f6",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Nova&backgroundColor=d0f4de"
    ].slice(0, 12);

    let selectedAvatar = localStorage.getItem('financeai_avatar') || (googleImage || predefinedAvatars[0]);

    function renderAvatarGrid() {
        const avatarGrid = document.getElementById('avatarGrid');
        if (!avatarGrid) return;
        avatarGrid.innerHTML = predefinedAvatars.map(av => `
            <button type="button" class="avatar-option p-1 rounded-2xl border-2 transition-all cursor-pointer ${av === selectedAvatar ? 'border-blue-600 bg-blue-50 dark:bg-blue-900/30 scale-105' : 'border-gray-200 dark:border-gray-700 hover:border-gray-400'}" data-avatar="${av}">
                <img src="${av}" alt="Opción de avatar predefinido" class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl object-cover" />
            </button>
        `).join('');

        avatarGrid.querySelectorAll('.avatar-option').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                selectedAvatar = btn.getAttribute('data-avatar');
                const modalCurAv = document.getElementById('modalCurrentAvatar');
                if (modalCurAv) modalCurAv.src = selectedAvatar;
                avatarGrid.querySelectorAll('.avatar-option').forEach(b => {
                    b.className = `avatar-option p-1 rounded-2xl border-2 transition-all cursor-pointer ${b.getAttribute('data-avatar') === selectedAvatar ? 'border-blue-600 bg-blue-50 dark:bg-blue-900/30 scale-105' : 'border-gray-200 dark:border-gray-700 hover:border-gray-400'}`;
                });
            });
        });
    }

    // Modal Handlers
    window.openProfileModal = function() {
        const userProfileModal = document.getElementById('userProfileModal');
        const cur = localStorage.getItem('financeai_preferred_currency') || 'USD';
        const curSelect = document.getElementById('profileCurrencySelect');
        if (curSelect) curSelect.value = cur;
        
        try {
            const cachedUser = JSON.parse(localStorage.getItem('financeai_user') || '{}');
            const nameEl = document.getElementById('modalUserName');
            const emailEl = document.getElementById('modalUserEmail');
            if (cachedUser.name && nameEl) nameEl.textContent = cachedUser.name;
            if (cachedUser.email && emailEl) emailEl.textContent = cachedUser.email;
        } catch(e) {}
        
        renderAvatarGrid();
        if (userProfileModal) userProfileModal.classList.remove('hidden');
    };

    window.closeProfileModal = function() {
        document.getElementById('userProfileModal')?.classList.add('hidden');
    };

    window.openLogoutModal = function() {
        document.getElementById('headerLogoutModal')?.classList.remove('hidden');
    };

    window.closeLogoutModal = function() {
        document.getElementById('headerLogoutModal')?.classList.add('hidden');
    };

    window.confirmHeaderSignout = async function() {
        const btn = document.getElementById('btnHeaderConfirmSignout');
        if (btn) {
            btn.textContent = 'Cerrando sesión...';
            btn.classList.add('opacity-70', 'cursor-not-allowed');
        }

        localStorage.clear();
        sessionStorage.clear();

        try {
            const { signOut } = await import("auth-astro/client");
            await signOut({ redirect: false });
        } catch (_) {}

        try {
            await fetch('/api/auth/logout', { method: 'POST' });
        } catch (_) {}

        window.location.replace('/login');
    };

    window.openDeleteAccountModal = function() {
        document.getElementById('deleteAccountConfirmModal')?.classList.remove('hidden');
    };

    window.closeDeleteAccountModal = function() {
        document.getElementById('deleteAccountConfirmModal')?.classList.add('hidden');
    };

    window.confirmDeleteAccount = async function() {
        const btn = document.getElementById('btnConfirmDeleteAccount');
        if (btn) {
            btn.disabled = true;
            btn.textContent = 'Eliminando cuenta...';
        }

        const token = localStorage.getItem('financeai_token');
        if (token) {
            try {
                await fetch(`${API_URL}/api/v1/users/profile`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
            } catch (e) {
                console.error("Error eliminando cuenta:", e);
            }
        }

        localStorage.clear();
        sessionStorage.clear();
        if (window.showToast) {
            window.showToast('Cuenta Eliminada', 'Tu cuenta y todos sus registros han sido eliminados de la base de datos.', '⚠️');
        }

        try {
            const { signOut } = await import("auth-astro/client");
            await signOut({ redirect: false });
        } catch (_) {}

        try {
            await fetch('/api/auth/logout', { method: 'POST' });
        } catch (_) {}

        setTimeout(() => { window.location.replace('/login'); }, 600);
    };

    // Listeners directos para botones del Header y Modales
    document.getElementById('btnOpenProfileModal')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.openProfileModal();
    });

    document.getElementById('btnCloseProfileModal')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.closeProfileModal();
    });

    document.getElementById('authNavBtn')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.openLogoutModal();
    });

    document.getElementById('btnHeaderCancelSignout')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.closeLogoutModal();
    });

    document.getElementById('btnHeaderConfirmSignout')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.confirmHeaderSignout();
    });

    document.getElementById('btnOpenDeleteAccountModal')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.openDeleteAccountModal();
    });

    document.getElementById('btnCancelDeleteAccount')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.closeDeleteAccountModal();
    });

    document.getElementById('btnConfirmDeleteAccount')?.addEventListener('click', (e) => {
        e.preventDefault();
        window.confirmDeleteAccount();
    });

    // Cerrar modales al hacer clic en el backdrop exterior
    window.addEventListener('click', (e) => {
        const userProfileModal = document.getElementById('userProfileModal');
        const headerLogoutModal = document.getElementById('headerLogoutModal');
        const deleteAccountConfirmModal = document.getElementById('deleteAccountConfirmModal');

        if (userProfileModal && e.target === userProfileModal) {
            window.closeProfileModal();
        }
        if (headerLogoutModal && e.target === headerLogoutModal) {
            window.closeLogoutModal();
        }
        if (deleteAccountConfirmModal && e.target === deleteAccountConfirmModal) {
            window.closeDeleteAccountModal();
        }
    });

    const token = localStorage.getItem('financeai_token');
    const isAuthenticated = !!token || hasServerSession;
    const desktopNav = document.getElementById('desktopNav');
    const mobileSecondRow = document.getElementById('mobileSecondRow');
    const navRightControls = document.getElementById('navRightControls');
    const userProfileSection = document.getElementById('userProfileSection');
    const authNavBtn = document.getElementById('authNavBtn');

    // Sincronizar datos de Google al almacenamiento local si aplica
    if (hasServerSession && googleName) {
        try {
            const cachedUser = JSON.parse(localStorage.getItem('financeai_user') || '{}');
            if (!cachedUser.name) {
                localStorage.setItem('financeai_user', JSON.stringify({
                    name: googleName,
                    email: googleEmail,
                    image: googleImage
                }));
            }
        } catch (e) {}
    }

    if (isLegalPage) {
        const backendIndicator = document.getElementById('backendIndicator');
        if (!isAuthenticated) {
            if (desktopNav) desktopNav.style.display = 'none';
            if (mobileSecondRow) mobileSecondRow.style.display = 'none';
            if (backendIndicator) backendIndicator.style.display = 'none';
            if (userProfileSection) userProfileSection.style.display = 'none';
            if (authNavBtn) authNavBtn.style.display = 'none';
        } else {
            if (desktopNav) desktopNav.style.display = '';
            if (mobileSecondRow) mobileSecondRow.style.display = '';
            if (backendIndicator) backendIndicator.style.display = '';
            if (userProfileSection) userProfileSection.style.display = '';
            if (authNavBtn) authNavBtn.style.display = '';
        }
    } else if (isAuthenticated && !isLogoutPage) {
        if (desktopNav) desktopNav.style.display = '';
        if (mobileSecondRow) mobileSecondRow.style.display = '';
        if (userProfileSection) userProfileSection.style.display = '';
        if (authNavBtn) authNavBtn.style.display = '';
    }

    // Ticker de tipo de cambio
    const savedCurrency = localStorage.getItem('financeai_preferred_currency') || 'USD';
    const rateTickerText = document.getElementById('rateTickerText');
    if (rateTickerText) {
        if (savedCurrency === 'USD') {
            rateTickerText.textContent = `1 USD ≈ $18.25 MXN`;
        } else {
            const approximateRates = { 'MXN': 18.25, 'CRC': 515.0, 'EUR': 0.92, 'COP': 4050.0, 'ARS': 950.0, 'CLP': 930.0, 'PEN': 3.75, 'HNL': 24.75, 'BRL': 5.65 };
            const rate = approximateRates[savedCurrency] || 1.0;
            rateTickerText.textContent = `1 USD ≈ ${rate} ${savedCurrency}`;
        }
    }

    // Update Avatar Image in Nav
    const navUserAvatar = document.getElementById('navUserAvatar');
    if (navUserAvatar) {
        navUserAvatar.src = selectedAvatar;
    }

    renderAvatarGrid();

    // Guardar Ajustes de Perfil
    document.getElementById('btnSaveProfileSettings')?.addEventListener('click', async () => {
        const curSelect = document.getElementById('profileCurrencySelect');
        const currency = curSelect ? curSelect.value : 'USD';
        localStorage.setItem('financeai_preferred_currency', currency);
        localStorage.setItem('financeai_avatar', selectedAvatar);
        
        if (navUserAvatar) navUserAvatar.src = selectedAvatar;

        const currentTok = localStorage.getItem('financeai_token');
        if (currentTok) {
            const currencyToId = { 'CRC': 1, 'MXN': 2, 'USD': 3, 'EUR': 4, 'COP': 5, 'ARS': 6, 'CLP': 7, 'PEN': 8, 'HNL': 9, 'BRL': 10 };
            try {
                await fetch(`${API_URL}/api/v1/users/profile`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${currentTok}` },
                    body: JSON.stringify({
                        paisId: 1,
                        monedaId: currencyToId[currency] || 1
                    })
                });
            } catch (_) {}
        }

        window.closeProfileModal();
        if (window.showToast) {
            window.showToast('¡Guardado!', 'Preferencias de perfil y moneda actualizadas con éxito.', '💾');
        }
        setTimeout(() => { window.location.reload(); }, 900);
    });

    // ─── Gestión de Derechos ARCO (LFPDPPP / GDPR) ───
    
    // 1. Derecho de Acceso: Abrir modal para elegir divisa y descargar Expediente PDF
    const pdfExportModal = document.getElementById('pdfCurrencyExportModal');
    const pdfCurrencySelect = document.getElementById('pdfTargetCurrencySelect');
    const btnClosePdfModal = document.getElementById('btnClosePdfExportModal');
    const btnCancelPdfModal = document.getElementById('btnCancelPdfExportModal');
    const btnConfirmPdf = document.getElementById('btnConfirmGeneratePdf');

    document.getElementById('btnArcoExportData')?.addEventListener('click', () => {
        const preferredCurrency = (localStorage.getItem('financeai_preferred_currency') || 'USD').toUpperCase();
        if (pdfCurrencySelect) {
            pdfCurrencySelect.value = preferredCurrency;
        }
        pdfExportModal?.classList.remove('hidden');
    });

    const closePdfModal = () => {
        pdfExportModal?.classList.add('hidden');
    };

    btnClosePdfModal?.addEventListener('click', closePdfModal);
    btnCancelPdfModal?.addEventListener('click', closePdfModal);

    btnConfirmPdf?.addEventListener('click', async () => {
        closePdfModal();

        const selectedPdfCurrency = (pdfCurrencySelect?.value || localStorage.getItem('financeai_preferred_currency') || 'USD').toUpperCase();
        const cachedUser = JSON.parse(localStorage.getItem('financeai_user') || '{}');
        const currentToken = localStorage.getItem('financeai_token');
        
        if (window.showToast) {
            window.showToast('Generando PDF', `Preparando tu expediente financiero en ${selectedPdfCurrency}...`, '⏳');
        }

        let transacciones = [];
        let fetchedFromBackend = false;

        if (currentToken) {
            try {
                const res = await fetch(`${API_URL}/api/v1/transactions`, {
                    headers: { 'Authorization': `Bearer ${currentToken}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    if (Array.isArray(data) && data.length > 0) {
                        transacciones = data;
                        fetchedFromBackend = true;
                    }
                }
            } catch (_) {}
        }

        if (!fetchedFromBackend) {
            const savedLocal = localStorage.getItem('financeai_all_transactions');
            if (savedLocal) {
                try {
                    transacciones = JSON.parse(savedLocal);
                } catch (_) {
                    transacciones = [];
                }
            } else {
                transacciones = [];
            }
        }

        // Normalizar transacciones para que coincidan con el formato esperado por PDF
        const normalizedTx = (Array.isArray(transacciones) ? transacciones : []).map((t, idx) => ({
            id: t.id || idx + 1,
            description: t.description || t.descripcion || 'Transacción',
            category: t.category || t.categoria || (t.type === 'INCOME' ? 'Ingresos' : 'General'),
            amount: parseFloat(t.amount || t.monto || t.valor || 0) || 0,
            originalCurrency: t.originalCurrency || t.moneda || 'USD',
            type: t.type || (t.category === 'Ingresos' || t.categoria === 'Ingresos' ? 'INCOME' : 'EXPENSE'),
            date: (t.date || t.fecha || new Date().toISOString()).toString().slice(0, 10)
        }));

        try {
            if (typeof window.generateExpedientePDF === 'function') {
                window.generateExpedientePDF({
                    userName: cachedUser.name || googleName || 'Usuario FinanceAI',
                    userEmail: cachedUser.email || googleEmail || 'N/A',
                    currency: selectedPdfCurrency,
                    transactions: normalizedTx
                });
                if (window.showToast) {
                    window.showToast('¡Descarga Lista!', `Tu expediente financiero ha sido generado en ${selectedPdfCurrency}.`, '📄');
                }
            } else {
                console.error('generateExpedientePDF no está disponible en window');
            }
        } catch (pdfErr) {
            console.error('Error generando PDF:', pdfErr);
            if (window.showToast) {
                window.showToast('Error', 'No se pudo generar el PDF. Inténtalo nuevamente.', '⚠️');
            }
        }
    });

    // 2. Derecho de Rectificación: Enfocar formulario
    document.getElementById('btnArcoRectify')?.addEventListener('click', () => {
        const select = document.getElementById('profileCurrencySelect');
        if (select) {
            select.scrollIntoView({ behavior: 'smooth', block: 'center' });
            select.focus();
            if (window.showToast) {
                window.showToast('Rectificación', 'Puedes modificar tu divisa base o preferencias arriba.', '✏️');
            }
        }
    });

    // 3. Derecho de Oposición: Toggle de procesamiento analítico
    const toggleArcoOpposition = document.getElementById('toggleArcoOpposition');
    if (toggleArcoOpposition) {
        const savedOpp = localStorage.getItem('financeai_arco_opposition');
        if (savedOpp !== null) {
            toggleArcoOpposition.checked = savedOpp === 'true';
        }
        toggleArcoOpposition.addEventListener('change', () => {
            localStorage.setItem('financeai_arco_opposition', toggleArcoOpposition.checked);
            if (toggleArcoOpposition.checked) {
                if (window.showToast) {
                    window.showToast('Derecho de Oposición', 'Has limitado el procesamiento de datos para estadísticas globales.', '🛡️');
                }
            } else {
                if (window.showToast) {
                    window.showToast('Procesamiento Permitido', 'Has habilitado el procesamiento de métricas agregadas anónimas.', '📊');
                }
            }
        });
    }

    // Health check polling
    function checkBackendHealth() {
        fetch(`${API_URL}/api/v1/health`)
            .then(res => {
                if (!res.ok) throw new Error('Backend HTTP error');
                return res.json();
            })
            .then(data => {
                const dot = document.getElementById('backendDot');
                const text = document.getElementById('backendStatusText');
                if (dot && text && (data.status === 'UP' || data.status === 'ONLINE' || data.service)) {
                    dot.className = 'w-2 h-2 rounded-full bg-emerald-500';
                    text.textContent = 'Backend Online';
                }
            })
            .catch(() => {
                const dot = document.getElementById('backendDot');
                const text = document.getElementById('backendStatusText');
                if (dot && text) {
                    dot.className = 'w-2 h-2 rounded-full bg-red-500';
                    text.textContent = 'Backend Offline';
                }
            });
    }

    // ─── Saldo General Total Ahorrado (Consistente con Balance Neto Historial) ───
    let isNavSaldoCensored = true;
    let globalBaseNetUSD = 0;

    const OFFICIAL_USD_VALUES = {
        USD: 1.00,
        MXN: 0.0591,
        EUR: 1.1687,
        CRC: 0.0022,
        COP: 0.000326,
        ARS: 0.000667,
        CLP: 0.001093,
        PEN: 0.2982,
        HNL: 0.0404,
        BRL: 0.1770
    };

    const CURRENCY_SYMBOLS_MAP = {
        USD: '$',
        MXN: '$',
        EUR: '€',
        CRC: '₡',
        COP: '$',
        ARS: '$',
        CLP: '$',
        PEN: 'S/',
        HNL: 'L',
        BRL: 'R$'
    };

    function convertAmount(amount, fromCur, toCur) {
        if (!amount || isNaN(amount)) return 0;
        const from = (fromCur || 'USD').toUpperCase();
        const to = (toCur || 'USD').toUpperCase();
        if (from === to) return Number(amount);

        const fromVal = OFFICIAL_USD_VALUES[from] || 1.0;
        const toVal = OFFICIAL_USD_VALUES[to] || 1.0;

        const inUSD = Number(amount) * fromVal;
        const converted = inUSD / toVal;
        return Math.round(converted * 100) / 100;
    }

    function renderNavSaldoDisplay() {
        const saldoTexts = document.querySelectorAll('.nav-saldo-text');
        const eyeOpens = document.querySelectorAll('.icon-nav-eye-open');
        const eyeCloseds = document.querySelectorAll('.icon-nav-eye-closed');
        const eyeBtns = document.querySelectorAll('.btn-toggle-nav-eye');
        const labels = document.querySelectorAll('.nav-saldo-label');
        const seps = document.querySelectorAll('.nav-saldo-sep');
        const pillDesktop = document.getElementById('navSaldoFavorPillDesktop');
        const pillMobile = document.getElementById('navSaldoFavorPillMobile');
        const dots = document.querySelectorAll('.nav-saldo-dot');
        const navCurSelects = document.querySelectorAll('.nav-currency-select');

        if (saldoTexts.length === 0) return;

        const activeCur = (navCurSelects[0]?.value || localStorage.getItem('financeai_preferred_currency') || 'USD').toUpperCase();
        navCurSelects.forEach(sel => {
            if (sel.value !== activeCur) sel.value = activeCur;
        });

        const symbol = CURRENCY_SYMBOLS_MAP[activeCur] || '$';
        const convertedAmt = convertAmount(globalBaseNetUSD, 'USD', activeCur);

        if (isNavSaldoCensored) {
            saldoTexts.forEach(el => {
                el.textContent = '••••••';
                el.className = 'font-bold font-mono text-emerald-600 dark:text-emerald-400 text-xs sm:text-sm nav-saldo-text';
            });
            labels.forEach(el => {
                el.textContent = 'Total Ahorrado:';
                el.className = 'hidden xl:inline text-[10px] sm:text-xs font-bold uppercase tracking-wider nav-saldo-label text-emerald-700 dark:text-emerald-300';
            });
            eyeBtns.forEach(el => {
                el.className = 'text-emerald-600 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-200 focus:outline-none flex items-center justify-center p-0.5 cursor-pointer btn-toggle-nav-eye';
            });
            seps.forEach(el => {
                el.className = 'text-emerald-300 dark:text-emerald-700/80 font-light select-none nav-saldo-sep';
            });
            navCurSelects.forEach(el => {
                el.className = 'nav-currency-select bg-transparent text-[10px] sm:text-xs font-bold text-emerald-700 dark:text-emerald-300 focus:outline-none cursor-pointer pr-0.5 border-none outline-none';
            });
            eyeOpens.forEach(el => { el.classList.add('hidden'); el.classList.remove('block'); });
            eyeCloseds.forEach(el => { el.classList.remove('hidden'); el.classList.add('block'); });
            
            if (pillDesktop) {
                pillDesktop.className = 'hidden md:flex items-center gap-1.5 px-2.5 sm:px-3 py-1 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 rounded-full text-xs font-semibold text-emerald-700 dark:text-emerald-300 shadow-sm cursor-pointer select-none transition hover:bg-emerald-100/70 dark:hover:bg-emerald-900/50 flex-shrink-0';
            }
            if (pillMobile) {
                pillMobile.className = 'flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 rounded-full text-xs font-semibold text-emerald-700 dark:text-emerald-300 shadow-sm cursor-pointer select-none transition hover:bg-emerald-100/70 dark:hover:bg-emerald-900/50 flex-shrink-0';
            }
            dots.forEach(dot => { dot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse flex-shrink-0 nav-saldo-dot'; });
        } else {
            const isNegative = convertedAmt < 0;
            const formattedNumber = Math.abs(Math.round(convertedAmt)).toLocaleString('es-MX');

            if (isNegative) {
                saldoTexts.forEach(el => {
                    el.textContent = `-${symbol}${formattedNumber}`;
                    el.className = 'font-bold font-mono text-red-600 dark:text-red-400 text-xs sm:text-sm nav-saldo-text';
                });
                labels.forEach(el => {
                    el.textContent = 'Déficit:';
                    el.className = 'hidden xl:inline text-[10px] sm:text-xs font-bold uppercase tracking-wider nav-saldo-label text-red-700 dark:text-red-300';
                });
                eyeBtns.forEach(el => {
                    el.className = 'text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-200 focus:outline-none flex items-center justify-center p-0.5 cursor-pointer btn-toggle-nav-eye';
                });
                seps.forEach(el => {
                    el.className = 'text-red-300 dark:text-red-700/80 font-light select-none nav-saldo-sep';
                });
                navCurSelects.forEach(el => {
                    el.className = 'nav-currency-select bg-transparent text-[10px] sm:text-xs font-bold text-red-700 dark:text-red-300 focus:outline-none cursor-pointer pr-0.5 border-none outline-none';
                });
                if (pillDesktop) {
                    pillDesktop.className = 'hidden md:flex items-center gap-1.5 px-2.5 sm:px-3 py-1 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800/60 rounded-full text-xs font-semibold text-red-700 dark:text-red-300 shadow-sm cursor-pointer select-none transition hover:bg-red-100/70 dark:hover:bg-red-900/50 flex-shrink-0';
                }
                if (pillMobile) {
                    pillMobile.className = 'flex items-center gap-1.5 px-2.5 py-1 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800/60 rounded-full text-xs font-semibold text-red-700 dark:text-red-300 shadow-sm cursor-pointer select-none transition hover:bg-red-100/70 dark:hover:bg-red-900/50 flex-shrink-0';
                }
                dots.forEach(dot => { dot.className = 'w-2 h-2 rounded-full bg-red-500 animate-pulse flex-shrink-0 nav-saldo-dot'; });
            } else {
                saldoTexts.forEach(el => {
                    el.textContent = `${symbol}${formattedNumber}`;
                    el.className = 'font-bold font-mono text-emerald-600 dark:text-emerald-400 text-xs sm:text-sm nav-saldo-text';
                });
                labels.forEach(el => {
                    el.textContent = 'Total Ahorrado:';
                    el.className = 'hidden xl:inline text-[10px] sm:text-xs font-bold uppercase tracking-wider nav-saldo-label text-emerald-700 dark:text-emerald-300';
                });
                eyeBtns.forEach(el => {
                    el.className = 'text-emerald-600 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-200 focus:outline-none flex items-center justify-center p-0.5 cursor-pointer btn-toggle-nav-eye';
                });
                seps.forEach(el => {
                    el.className = 'text-emerald-300 dark:text-emerald-700/80 font-light select-none nav-saldo-sep';
                });
                navCurSelects.forEach(el => {
                    el.className = 'nav-currency-select bg-transparent text-[10px] sm:text-xs font-bold text-emerald-700 dark:text-emerald-300 focus:outline-none cursor-pointer pr-0.5 border-none outline-none';
                });
                if (pillDesktop) {
                    pillDesktop.className = 'hidden md:flex items-center gap-1.5 px-2.5 sm:px-3 py-1 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 rounded-full text-xs font-semibold text-emerald-700 dark:text-emerald-300 shadow-sm cursor-pointer select-none transition hover:bg-emerald-100/70 dark:hover:bg-emerald-900/50 flex-shrink-0';
                }
                if (pillMobile) {
                    pillMobile.className = 'flex items-center gap-1.5 px-2.5 py-1 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 rounded-full text-xs font-semibold text-emerald-700 dark:text-emerald-300 shadow-sm cursor-pointer select-none transition hover:bg-emerald-100/70 dark:hover:bg-emerald-900/50 flex-shrink-0';
                }
                dots.forEach(dot => { dot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse flex-shrink-0 nav-saldo-dot'; });
            }

            eyeOpens.forEach(el => { el.classList.remove('hidden'); el.classList.add('block'); });
            eyeCloseds.forEach(el => { el.classList.add('hidden'); el.classList.remove('block'); });
        }
    }

    function toggleNavSaldoCensor(e) {
        if (e) e.preventDefault();
        isNavSaldoCensored = !isNavSaldoCensored;
        renderNavSaldoDisplay();
    }

    document.getElementById('navSaldoFavorPillDesktop')?.addEventListener('click', toggleNavSaldoCensor);
    document.getElementById('navSaldoFavorPillMobile')?.addEventListener('click', toggleNavSaldoCensor);

    // Evento de selección de divisa en Navbar (desktop y mobile sincronizados)
    document.querySelectorAll('.nav-currency-select').forEach(sel => {
        sel.addEventListener('change', (e) => {
            const newCur = e.target.value;
            localStorage.setItem('financeai_preferred_currency', newCur);
            document.querySelectorAll('.nav-currency-select').forEach(other => {
                if (other !== e.target) other.value = newCur;
            });
            const profSelect = document.getElementById('profileCurrencySelect');
            if (profSelect) profSelect.value = newCur;
            renderNavSaldoDisplay();
            window.dispatchEvent(new CustomEvent('financeai_currency_changed', { detail: { currency: newCur } }));
            window.dispatchEvent(new CustomEvent('financeai_global_balance_updated'));
        });
    });

    // Saldo General de todos los meses sincronizado (calculado desde base de datos / historial)
    async function updateNavSaldoFavor() {
        const preferredCurrency = (localStorage.getItem('financeai_preferred_currency') || 'USD').toUpperCase();
        document.querySelectorAll('.nav-currency-select').forEach(sel => {
            sel.value = preferredCurrency;
        });

        const token = localStorage.getItem('financeai_token');
        let transactions = [];
        let fetchedFromBackend = false;

        if (token) {
            try {
                const res = await fetch(`${API_URL}/api/v1/transactions`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    if (Array.isArray(data) && data.length > 0) {
                        transactions = data;
                        fetchedFromBackend = true;
                    }
                }
            } catch (_) {}
        }

        if (!fetchedFromBackend) {
            const savedLocal = localStorage.getItem('financeai_all_transactions');
            if (savedLocal) {
                try {
                    transactions = JSON.parse(savedLocal);
                } catch (_) {
                    transactions = [];
                }
            } else {
                transactions = [];
            }
        }

        let incUSD = 0;
        let expUSD = 0;
        if (Array.isArray(transactions)) {
            transactions.forEach(t => {
                const a = parseFloat(t.amount || t.monto || t.valor || 0) || 0;
                const originCur = (t.originalCurrency || t.moneda || preferredCurrency).toUpperCase();
                const amtInUSD = convertAmount(a, originCur, 'USD');
                const typ = (t.type || '').toUpperCase();
                const cat = (t.category || t.categoria || '').toUpperCase();
                if (typ === 'INCOME' || typ === 'INGRESO' || cat === 'INGRESOS') {
                    incUSD += amtInUSD;
                } else {
                    expUSD += amtInUSD;
                }
            });
        }

        globalBaseNetUSD = incUSD - expUSD;
        renderNavSaldoDisplay();
    }

    // Escuchar eventos globales de sincronización de balance general
    window.addEventListener('financeai_global_balance_updated', (e) => {
        if (e && e.detail && typeof e.detail.balanceUSD === 'number') {
            globalBaseNetUSD = e.detail.balanceUSD;
            renderNavSaldoDisplay();
        } else {
            updateNavSaldoFavor();
        }
    });
    window.addEventListener('storage', (e) => {
        if (e.key === 'financeai_all_transactions' || e.key === 'financeai_preferred_currency' || e.key === 'financeai_history_cleared') {
            updateNavSaldoFavor();
        }
    });

    checkBackendHealth();
    updateNavSaldoFavor();
    setInterval(checkBackendHealth, 15000);
</script>

<script>
    import { generateExpedientePDF } from '../lib/pdfReport';
    if (typeof window !== 'undefined') {
        (window as any).generateExpedientePDF = generateExpedientePDF;
    }
</script>
