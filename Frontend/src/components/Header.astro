---
import { API_URL } from '../lib/api';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
const hasServerSession = !!session;
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/^\/|\/$/g, '');
const isAuthPage = currentPath === 'login' || currentPath === 'logout';
const isLogoutPage = currentPath === 'logout';

const googleImage = session?.user?.image || '';
const googleName = session?.user?.name || '';
const googleEmail = session?.user?.email || '';
---

<header class="w-full flex items-center justify-between px-3 sm:px-6 py-2.5 sm:py-3 border-b border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/80 backdrop-blur-md sticky top-0 z-50 transition-colors">
    <!-- Left: Brand & Nav Links -->
    <div class="flex items-center gap-2.5 sm:gap-6 min-w-0">
        <a href="/" class="flex items-center space-x-1.5 sm:space-x-2 group flex-shrink-0">
            <div class="flex space-x-1 group-hover:scale-105 transition-transform">
                <div class="w-2.5 h-2.5 rounded-full bg-blue-600"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-red-500"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
            </div>
            <span class="font-bold text-base sm:text-xl tracking-tight text-gray-900 dark:text-white font-josefin">FinanceAI</span>
        </a>

        <!-- Main Nav (Oculto solo en Login y Logout) -->
        {!isAuthPage && (
            <nav id="mainNav" class="flex items-center space-x-2 sm:space-x-5 text-xs sm:text-sm font-medium font-inter flex-shrink-0">
                <a href="/dashboard"
                    class={`pb-0.5 sm:pb-1 transition-colors ${currentPath === 'dashboard' || currentPath === '' ? 'border-b-2 border-blue-600 text-blue-600 dark:text-blue-400 font-semibold' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'}`}>
                    Dashboard
                </a>
                <a href="/historial"
                    class={`pb-0.5 sm:pb-1 transition-colors ${currentPath === 'historial' ? 'border-b-2 border-blue-600 text-blue-600 dark:text-blue-400 font-semibold' : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'}`}>
                    Historial
                </a>
            </nav>
        )}
    </div>

    <!-- Right Controls -->
    {!isLogoutPage && (
        <div class="flex items-center space-x-1.5 sm:space-x-3 flex-shrink-0">
            
            <!-- Backend Health Indicator -->
            <div id="backendIndicator" class="hidden md:flex items-center gap-1.5 text-[10px] sm:text-xs text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full">
                <span id="backendDot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                <span id="backendStatusText" class="hidden sm:inline">Backend...</span>
            </div>

            <!-- Dark mode toggle -->
            <button type="button" id="themeToggle"
                aria-label="Cambiar tema"
                class="w-7 h-7 sm:w-9 sm:h-9 flex items-center justify-center rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors text-gray-600 dark:text-gray-300 cursor-pointer flex-shrink-0">
                <svg id="iconSun" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
                </svg>
                <svg id="iconMoon" xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"/>
                </svg>
            </button>

            <!-- User Profile Avatar Button & Auth Button -->
            {!isAuthPage && (
                <div id="userProfileSection" class="relative flex items-center flex-shrink-0">
                    <button id="btnOpenProfileModal" onclick="window.openProfileModal && window.openProfileModal()" class="flex items-center p-0.5 rounded-full ring-2 ring-transparent hover:ring-blue-500 transition-all focus:outline-none cursor-pointer" title="Mi Perfil y Ajustes">
                        <img id="navUserAvatar" src={googleImage || "https://api.dicebear.com/7.x/bottts/svg?seed=FinanceAI1"} alt="Avatar de usuario" class="w-7 h-7 sm:w-9 sm:h-9 rounded-full object-cover border border-gray-200 dark:border-gray-700 shadow-sm" />
                    </button>
                </div>

                <button type="button" id="authNavBtn"
                    onclick="window.openLogoutModal && window.openLogoutModal()"
                    class="text-[10px] sm:text-xs font-semibold px-2 py-1 sm:px-3 sm:py-1.5 bg-gray-100 dark:bg-gray-800 hover:bg-red-600 hover:text-white text-gray-700 dark:text-gray-200 rounded-xl transition-colors cursor-pointer flex-shrink-0">
                    <span class="hidden xs:inline">Cerrar Sesión</span>
                    <span class="xs:hidden">Cerrar Sesión</span>
                </button>
            )}
        </div>
    )}
</header>

<!-- Modal Centrado de Confirmación de Cierre de Sesión (Overlay Difuminado) -->
<div id="headerLogoutModal" class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-gray-900/70 backdrop-blur-xl animate-fade-in font-inter p-3 sm:p-4">
    <div class="bg-white/95 dark:bg-gray-900/95 backdrop-blur-2xl rounded-2xl sm:rounded-3xl shadow-2xl p-6 sm:p-10 max-w-md w-full border border-gray-200 dark:border-gray-800 text-center animate-scale-in">
        <div class="w-14 h-14 sm:w-16 sm:h-16 mx-auto bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-2xl flex items-center justify-center mb-4 sm:mb-5 shadow-inner border border-gray-200 dark:border-gray-700">
            <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
        </div>
        
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-gray-900 dark:text-white mb-2 font-josefin">¿Cerrar Sesión?</h2>
        
        <p class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm mb-5 sm:mb-6 leading-relaxed">
            ¿Estás seguro de que deseas salir de tu cuenta? Tendrás que volver a iniciar sesión para acceder a tu panel.
        </p>
        
        <div class="space-y-2.5">
            <button id="btnHeaderConfirmSignout" onclick="window.confirmHeaderSignout && window.confirmHeaderSignout()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 sm:py-3 px-4 rounded-xl transition shadow-md hover:shadow-lg text-xs sm:text-sm cursor-pointer">
                Sí, salir de mi cuenta
            </button>
            <button id="btnHeaderCancelSignout" onclick="window.closeLogoutModal && window.closeLogoutModal()" class="w-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold py-2 sm:py-2.5 px-4 rounded-xl transition text-xs sm:text-sm cursor-pointer">
                Cancelar
            </button>
        </div>
    </div>
</div>

<!-- Modal de Perfil de Usuario y Ajustes (Con Cierre al Hacer Clic Afuera y Botón Grande) -->
<div id="userProfileModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-gray-900/70 backdrop-blur-md animate-fade-in font-inter p-3 sm:p-4">
    <div id="userProfileCard" class="bg-white dark:bg-gray-900 w-full max-w-lg rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-2xl border border-gray-200 dark:border-gray-800 text-left animate-scale-in max-h-[90vh] overflow-y-auto">
        <!-- Modal Header -->
        <div class="flex justify-between items-center pb-3 sm:pb-4 border-b border-gray-100 dark:border-gray-800">
            <div>
                <h3 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white font-josefin">Mi Perfil y Ajustes</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400">Personaliza tu cuenta y moneda predeterminada</p>
            </div>
            <!-- Botón de Cerrar Grande -->
            <button id="btnCloseProfileModal" onclick="window.closeProfileModal && window.closeProfileModal()" class="text-gray-400 hover:text-gray-900 dark:hover:text-white text-2xl sm:text-3xl font-bold w-9 h-9 sm:w-10 sm:h-10 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center transition-all leading-none cursor-pointer" title="Cerrar">&times;</button>
        </div>

        <div class="py-4 sm:py-6 space-y-4 sm:space-y-6">
            <!-- User Basic Info -->
            <div class="flex items-center gap-3 sm:gap-4 p-3.5 sm:p-4 bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-200/60 dark:border-gray-700/60">
                <img id="modalCurrentAvatar" src={googleImage || "https://api.dicebear.com/7.x/bottts/svg?seed=FinanceAI1"} alt="Foto de perfil actual" class="w-12 h-12 sm:w-16 sm:h-16 rounded-full object-cover border-2 border-blue-500 shadow-md flex-shrink-0" />
                <div class="min-w-0 flex-1">
                    <h4 id="modalUserName" class="text-sm sm:text-base font-bold text-gray-900 dark:text-white truncate">{googleName || "Usuario FinanceAI"}</h4>
                    <p id="modalUserEmail" class="text-xs text-gray-500 dark:text-gray-400 truncate">{googleEmail || "usuario@correo.com"}</p>
                    <span class="inline-block mt-1 text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-md">Cuenta Activa</span>
                </div>
            </div>

            <!-- Selector de 9 Avatares -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2">Selecciona tu Foto de Perfil (9 Avatares)</label>
                <div class="grid grid-cols-3 sm:grid-cols-5 gap-2 sm:gap-2.5 pt-1" id="avatarGrid">
                    <!-- Dynamic avatar grid -->
                </div>
            </div>

            <!-- Selector de Moneda Predeterminada -->
            <div>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Moneda Base Predeterminada</label>
                <p class="text-[11px] text-gray-500 mb-2">Tus análisis y presupuestos se calcularán automáticamente en esta divisa.</p>
                <select id="profileCurrencySelect" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
                    <option value="USD">USD ($) - Dólar Estadounidense</option>
                    <option value="CRC">CRC (₡) - Colón Costarricense</option>
                    <option value="MXN">MXN ($) - Peso Mexicano</option>
                    <option value="EUR">EUR (€) - Euro</option>
                    <option value="COP">COP ($) - Peso Colombiano</option>
                    <option value="ARS">ARS ($) - Peso Argentino</option>
                    <option value="CLP">CLP ($) - Peso Chileno</option>
                    <option value="PEN">PEN (S/) - Sol Peruano</option>
                </select>
            </div>

            <!-- Save Profile Button -->
            <button id="btnSaveProfileSettings" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition text-sm shadow-sm">
                Guardar Cambios
            </button>

            <!-- Sección: Privacidad y Derechos ARCO (LFPDPPP & GDPR) -->
            <div class="pt-5 border-t border-gray-100 dark:border-gray-800 space-y-3.5">
                <div class="flex items-center justify-between">
                    <h5 class="text-xs sm:text-sm font-bold text-gray-900 dark:text-white font-josefin flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                        Privacidad y Derechos ARCO
                    </h5>
                    <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 rounded-md">
                        Gobernanza Activa
                    </span>
                </div>
                
                <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed">
                    Como titular de tus datos personales, puedes ejercer tus derechos de Acceso, Rectificación, Cancelación y Oposición:
                </p>

                <!-- Grid de Acciones ARCO -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
                    <!-- 1. Acceso: Descargar Copia de Datos -->
                    <button type="button" id="btnArcoExportData" class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-2xl bg-gray-50 dark:bg-gray-800/70 hover:bg-gray-100 dark:hover:bg-gray-800 border border-gray-200/80 dark:border-gray-700/80 text-left transition group cursor-pointer">
                        <div class="w-8 h-8 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                        </div>
                        <div>
                            <strong class="text-xs font-semibold text-gray-900 dark:text-white block">Derecho de Acceso</strong>
                            <span class="text-[10px] text-gray-500 dark:text-gray-400">Descargar expediente (.JSON)</span>
                        </div>
                    </button>

                    <!-- 2. Rectificación: Actualizar Perfil -->
                    <button type="button" id="btnArcoRectify" class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-2xl bg-gray-50 dark:bg-gray-800/70 hover:bg-gray-100 dark:hover:bg-gray-800 border border-gray-200/80 dark:border-gray-700/80 text-left transition group cursor-pointer">
                        <div class="w-8 h-8 rounded-xl bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        </div>
                        <div>
                            <strong class="text-xs font-semibold text-gray-900 dark:text-white block">Rectificación</strong>
                            <span class="text-[10px] text-gray-500 dark:text-gray-400">Modificar datos y moneda</span>
                        </div>
                    </button>
                </div>

                <!-- 3. Oposición: Toggle de Procesamiento Agregado -->
                <div class="p-3 bg-gray-50 dark:bg-gray-800/50 rounded-2xl border border-gray-200/60 dark:border-gray-700/60 flex items-center justify-between">
                    <div class="pr-3">
                        <strong class="text-xs font-semibold text-gray-900 dark:text-white block">Derecho de Oposición</strong>
                        <p class="text-[11px] text-gray-500 dark:text-gray-400 leading-snug">Limitar procesamiento analítico estadístico agregado.</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
                        <input type="checkbox" id="toggleArcoOpposition" class="sr-only peer" checked />
                        <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600"></div>
                    </label>
                </div>
            </div>

            <!-- Danger Zone: Eliminar Cuenta (Letra más grande y legible) -->
            <div class="pt-5 border-t border-red-100 dark:border-red-900/30">
                <h5 class="text-sm sm:text-base font-bold text-red-600 dark:text-red-400 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    ZONA DE PELIGRO
                </h5>
                <p class="text-xs text-gray-600 dark:text-gray-400 mb-3.5 leading-relaxed">
                    Eliminar tu cuenta borrará todos tus datos financieros, transacciones, registros y configuraciones de forma permanente e irreversible de la base de datos (Derecho de Cancelación).
                </p>
                <button id="btnOpenDeleteAccountModal" class="px-4 py-2.5 text-xs sm:text-sm font-bold text-red-600 hover:text-white bg-red-50 dark:bg-red-900/20 hover:bg-red-600 border border-red-200 dark:border-red-800 rounded-xl transition-colors shadow-sm cursor-pointer">
                    Eliminar mi cuenta
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmación Eliminar Cuenta -->
<div id="deleteAccountConfirmModal" class="hidden fixed inset-0 z-[110] flex items-center justify-center bg-gray-900/80 backdrop-blur-md font-inter">
    <div id="deleteAccountCard" class="bg-white dark:bg-gray-900 max-w-sm w-full mx-4 rounded-3xl p-8 shadow-2xl border border-red-300 dark:border-red-800 text-center animate-scale-in">
        <div class="w-16 h-16 mx-auto bg-red-100 dark:bg-red-900/30 text-red-600 rounded-full flex items-center justify-center mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white font-josefin mb-2">¿Eliminar Cuenta Definitivamente?</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-6 leading-relaxed">
            Esta acción es irreversible. Se eliminará tu acceso, historial y transacciones asociadas en la base de datos.
        </p>
        
        <div class="space-y-2.5">
            <button id="btnConfirmDeleteAccount" onclick="window.confirmDeleteAccount && window.confirmDeleteAccount()" class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-3 rounded-xl transition text-xs sm:text-sm cursor-pointer">
                Sí, eliminar definitivamente
            </button>
            <button id="btnCancelDeleteAccount" onclick="window.closeDeleteAccountModal && window.closeDeleteAccountModal()" class="w-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 text-gray-700 dark:text-gray-300 font-semibold py-2.5 rounded-xl transition text-xs sm:text-sm cursor-pointer">
                Cancelar
            </button>
        </div>
    </div>
</div>

<script define:vars={{ API_URL, hasServerSession, googleImage, googleName, googleEmail, isLogoutPage }}>
    // Theme toggle
    function updateThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        const sun = document.getElementById('iconSun');
        const moon = document.getElementById('iconMoon');
        if (sun) sun.style.display = isDark ? 'block' : 'none';
        if (moon) moon.style.display = isDark ? 'none' : 'block';
    }

    window.toggleTheme = function() {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
            html.classList.remove('dark');
            localStorage.setItem('theme', 'light');
        } else {
            html.classList.add('dark');
            localStorage.setItem('theme', 'dark');
        }
        updateThemeIcons();
    };
    document.getElementById('themeToggle')?.addEventListener('click', window.toggleTheme);
    updateThemeIcons();

    // 9 Avatares Predefinidos
    const predefinedAvatars = [
        ...(googleImage ? [googleImage] : []),
        "https://api.dicebear.com/7.x/bottts/svg?seed=Felix",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Bella",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Max",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Luna",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Charlie",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Milo",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Coco",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Rocky",
        "https://api.dicebear.com/7.x/bottts/svg?seed=Sophie"
    ].slice(0, 9);

    let selectedAvatar = localStorage.getItem('financeai_avatar') || (googleImage || predefinedAvatars[0]);

    function renderAvatarGrid() {
        const avatarGrid = document.getElementById('avatarGrid');
        if (!avatarGrid) return;
        avatarGrid.innerHTML = predefinedAvatars.map(av => `
            <button type="button" class="avatar-option p-1 rounded-2xl border-2 transition-all cursor-pointer ${av === selectedAvatar ? 'border-blue-600 bg-blue-50 dark:bg-blue-900/30 scale-105' : 'border-gray-200 dark:border-gray-700 hover:border-gray-400'}" data-avatar="${av}">
                <img src="${av}" alt="Opción de avatar predefinido" class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl object-cover" />
            </button>
        `).join('');

        avatarGrid.querySelectorAll('.avatar-option').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                selectedAvatar = btn.getAttribute('data-avatar');
                const modalCurAv = document.getElementById('modalCurrentAvatar');
                if (modalCurAv) modalCurAv.src = selectedAvatar;
                avatarGrid.querySelectorAll('.avatar-option').forEach(b => {
                    b.className = `avatar-option p-1 rounded-2xl border-2 transition-all cursor-pointer ${b.getAttribute('data-avatar') === selectedAvatar ? 'border-blue-600 bg-blue-50 dark:bg-blue-900/30 scale-105' : 'border-gray-200 dark:border-gray-700 hover:border-gray-400'}`;
                });
            });
        });
    }

    // Modal Handlers
    window.openProfileModal = function() {
        const userProfileModal = document.getElementById('userProfileModal');
        const cur = localStorage.getItem('financeai_preferred_currency') || 'USD';
        const curSelect = document.getElementById('profileCurrencySelect');
        if (curSelect) curSelect.value = cur;
        
        try {
            const cachedUser = JSON.parse(localStorage.getItem('financeai_user') || '{}');
            const nameEl = document.getElementById('modalUserName');
            const emailEl = document.getElementById('modalUserEmail');
            if (cachedUser.name && nameEl) nameEl.textContent = cachedUser.name;
            if (cachedUser.email && emailEl) emailEl.textContent = cachedUser.email;
        } catch(e) {}
        
        renderAvatarGrid();
        if (userProfileModal) userProfileModal.classList.remove('hidden');
    };

    window.closeProfileModal = function() {
        document.getElementById('userProfileModal')?.classList.add('hidden');
    };

    window.openLogoutModal = function() {
        document.getElementById('headerLogoutModal')?.classList.remove('hidden');
    };

    window.closeLogoutModal = function() {
        document.getElementById('headerLogoutModal')?.classList.add('hidden');
    };

    window.confirmHeaderSignout = async function() {
        const btn = document.getElementById('btnHeaderConfirmSignout');
        if (btn) {
            btn.textContent = 'Cerrando sesión...';
            btn.classList.add('opacity-70', 'cursor-not-allowed');
        }

        localStorage.clear();
        sessionStorage.clear();

        try {
            const { signOut } = await import("auth-astro/client");
            await signOut({ redirect: false });
        } catch (_) {}

        try {
            await fetch('/api/auth/logout', { method: 'POST' });
        } catch (_) {}

        window.location.replace('/login');
    };

    window.openDeleteAccountModal = function() {
        document.getElementById('deleteAccountConfirmModal')?.classList.remove('hidden');
    };

    window.closeDeleteAccountModal = function() {
        document.getElementById('deleteAccountConfirmModal')?.classList.add('hidden');
    };

    window.confirmDeleteAccount = async function() {
        const btn = document.getElementById('btnConfirmDeleteAccount');
        if (btn) {
            btn.disabled = true;
            btn.textContent = 'Eliminando cuenta...';
        }

        const token = localStorage.getItem('financeai_token');
        if (token) {
            try {
                await fetch(`${API_URL}/api/v1/users/profile`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
            } catch (e) {
                console.error("Error eliminando cuenta:", e);
            }
        }

        localStorage.clear();
        sessionStorage.clear();
        if (window.showToast) {
            window.showToast('Cuenta Eliminada', 'Tu cuenta y todos sus registros han sido eliminados de la base de datos.', '⚠️');
        }

        try {
            const { signOut } = await import("auth-astro/client");
            await signOut({ redirect: false });
        } catch (_) {}

        try {
            await fetch('/api/auth/logout', { method: 'POST' });
        } catch (_) {}

        setTimeout(() => { window.location.replace('/login'); }, 600);
    };

    const token = localStorage.getItem('financeai_token');
    const isAuthenticated = !!token || hasServerSession;
    const mainNav = document.getElementById('mainNav');
    const userProfileSection = document.getElementById('userProfileSection');
    const authNavBtn = document.getElementById('authNavBtn');

    // Sincronizar datos de Google al almacenamiento local si aplica
    if (hasServerSession && googleName) {
        try {
            const cachedUser = JSON.parse(localStorage.getItem('financeai_user') || '{}');
            if (!cachedUser.name) {
                localStorage.setItem('financeai_user', JSON.stringify({
                    name: googleName,
                    email: googleEmail,
                    image: googleImage
                }));
            }
        } catch (e) {}
    }

    if (isAuthenticated && !isLogoutPage) {
        if (mainNav) {
            mainNav.classList.remove('hidden');
            mainNav.classList.add('flex');
        }
        if (userProfileSection) {
            userProfileSection.classList.remove('hidden');
        }
        if (authNavBtn) {
            authNavBtn.classList.remove('hidden');
        }
    }

    // Ticker de tipo de cambio
    const savedCurrency = localStorage.getItem('financeai_preferred_currency') || 'USD';
    const rateTickerText = document.getElementById('rateTickerText');
    if (rateTickerText) {
        if (savedCurrency === 'USD') {
            rateTickerText.textContent = `1 USD ≈ $18.25 MXN`;
        } else {
            const approximateRates = { 'MXN': 18.25, 'CRC': 515.0, 'EUR': 0.92, 'COP': 4050.0, 'ARS': 950.0, 'CLP': 930.0, 'PEN': 3.75 };
            const rate = approximateRates[savedCurrency] || 1.0;
            rateTickerText.textContent = `1 USD ≈ ${rate} ${savedCurrency}`;
        }
    }

    // Update Avatar Image in Nav
    const navUserAvatar = document.getElementById('navUserAvatar');
    if (navUserAvatar) {
        navUserAvatar.src = selectedAvatar;
    }

    renderAvatarGrid();

    // Guardar Ajustes de Perfil
    document.getElementById('btnSaveProfileSettings')?.addEventListener('click', async () => {
        const curSelect = document.getElementById('profileCurrencySelect');
        const currency = curSelect ? curSelect.value : 'USD';
        localStorage.setItem('financeai_preferred_currency', currency);
        localStorage.setItem('financeai_avatar', selectedAvatar);
        
        if (navUserAvatar) navUserAvatar.src = selectedAvatar;

        const currentTok = localStorage.getItem('financeai_token');
        if (currentTok) {
            const currencyToId = { 'CRC': 1, 'MXN': 2, 'USD': 3, 'EUR': 4, 'COP': 5, 'ARS': 6, 'CLP': 7, 'PEN': 8 };
            try {
                await fetch(`${API_URL}/api/v1/users/profile`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${currentTok}` },
                    body: JSON.stringify({
                        paisId: 1,
                        monedaId: currencyToId[currency] || 1
                    })
                });
            } catch (_) {}
        }

        window.closeProfileModal();
        if (window.showToast) {
            window.showToast('¡Guardado!', 'Preferencias de perfil y moneda actualizadas con éxito.', '💾');
        }
        setTimeout(() => { window.location.reload(); }, 900);
    });

    // ─── Gestión de Derechos ARCO (LFPDPPP / GDPR) ───
    
    // 1. Derecho de Acceso: Descargar Expediente de Datos en JSON
    document.getElementById('btnArcoExportData')?.addEventListener('click', async () => {
        const cachedUser = JSON.parse(localStorage.getItem('financeai_user') || '{}');
        const preferredCurrency = localStorage.getItem('financeai_preferred_currency') || 'USD';
        const currentToken = localStorage.getItem('financeai_token');
        
        let transacciones = [];
        if (currentToken) {
            try {
                const res = await fetch(`${API_URL}/api/v1/transactions`, {
                    headers: { 'Authorization': `Bearer ${currentToken}` }
                });
                if (res.ok) {
                    transacciones = await res.json();
                }
            } catch (_) {}
        }

        const expedienteARCO = {
            titulo: "Expediente de Datos Personales y Financieros - FinanceAI",
            marcoLegal: "Cumplimiento con Artículos 22 al 35 de la LFPDPPP (México) y Artículos 15 al 20 del GDPR (UE)",
            fechaGeneracion: new Date().toISOString(),
            titular: {
                id: cachedUser.id || "N/A",
                nombre: cachedUser.name || googleName || "Usuario FinanceAI",
                correo: cachedUser.email || googleEmail || "N/A",
                monedaBase: preferredCurrency
            },
            derechoAccesoEjercido: true,
            totalTransaccionesRegistradas: Array.isArray(transacciones) ? transacciones.length : 0,
            registrosFinancieros: transacciones,
            garantiaNoVentaDatos: "FinanceAI certifica que estos datos no han sido vendidos ni compartidos con fines comerciales."
        };

        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(expedienteARCO, null, 2));
        const downloadAnchor = document.createElement('a');
        downloadAnchor.setAttribute("href", dataStr);
        downloadAnchor.setAttribute("download", `expediente_datos_financeai_${Date.now()}.json`);
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        downloadAnchor.remove();

        if (window.showToast) {
            window.showToast('Derecho de Acceso', 'Tu expediente de datos personales ha sido descargado en formato .JSON.', '📥');
        }
    });

    // 2. Derecho de Rectificación: Enfocar formulario
    document.getElementById('btnArcoRectify')?.addEventListener('click', () => {
        const select = document.getElementById('profileCurrencySelect');
        if (select) {
            select.scrollIntoView({ behavior: 'smooth', block: 'center' });
            select.focus();
            if (window.showToast) {
                window.showToast('Rectificación', 'Puedes modificar tu divisa base o preferencias arriba.', '✏️');
            }
        }
    });

    // 3. Derecho de Oposición: Toggle de procesamiento analítico
    const toggleArcoOpposition = document.getElementById('toggleArcoOpposition');
    if (toggleArcoOpposition) {
        const savedOpp = localStorage.getItem('financeai_arco_opposition');
        if (savedOpp !== null) {
            toggleArcoOpposition.checked = savedOpp === 'true';
        }
        toggleArcoOpposition.addEventListener('change', () => {
            localStorage.setItem('financeai_arco_opposition', toggleArcoOpposition.checked);
            if (toggleArcoOpposition.checked) {
                if (window.showToast) {
                    window.showToast('Derecho de Oposición', 'Has limitado el procesamiento de datos para estadísticas globales.', '🛡️');
                }
            } else {
                if (window.showToast) {
                    window.showToast('Procesamiento Permitido', 'Has habilitado el procesamiento de métricas agregadas anónimas.', '📊');
                }
            }
        });
    }

    // Health check polling
    function checkBackendHealth() {
        fetch(`${API_URL}/api/v1/health`)
            .then(res => {
                if (!res.ok) throw new Error('Backend HTTP error');
                return res.json();
            })
            .then(data => {
                const dot = document.getElementById('backendDot');
                const text = document.getElementById('backendStatusText');
                if (dot && text && (data.status === 'UP' || data.status === 'ONLINE' || data.service)) {
                    dot.className = 'w-2 h-2 rounded-full bg-emerald-500';
                    text.textContent = 'Backend Online';
                }
            })
            .catch(() => {
                const dot = document.getElementById('backendDot');
                const text = document.getElementById('backendStatusText');
                if (dot && text) {
                    dot.className = 'w-2 h-2 rounded-full bg-red-500';
                    text.textContent = 'Backend Offline';
                }
            });
    }

    checkBackendHealth();
    setInterval(checkBackendHealth, 15000);
</script>
