---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="FinanceAI - Asistente Inteligente de Salud Financiera" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Ciberseguridad: Meta tags de protección OWASP en el cliente -->
		<meta http-equiv="X-Content-Type-Options" content="nosniff" />
		<meta http-equiv="X-Frame-Options" content="DENY" />
		<meta http-equiv="X-XSS-Protection" content="1; mode=block" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' http://localhost:* http://127.0.0.1:* https:;" />

		<!-- Tipografía Josefin Sans & Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Josefin+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600;1,700&display=swap" rel="stylesheet" />
		<title>{title}</title>

		<style is:global>
			body {
				font-family: 'Josefin Sans', system-ui, -apple-system, sans-serif;
			}
			
			/* Tipografía Josefin Sans e Inter */
			.font-josefin, .font-ristela, .font-playfair, h1, h2, h3 {
				font-family: 'Josefin Sans', system-ui, -apple-system, sans-serif;
				letter-spacing: -0.01em;
			}
			.font-inter { 
				font-family: 'Inter', system-ui, -apple-system, sans-serif; 
			}
			
			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(6px); }
				to { opacity: 1; transform: translateY(0); }
			}
			@keyframes scaleIn {
				from { opacity: 0; transform: scale(0.96); }
				to { opacity: 1; transform: scale(1); }
			}
			.animate-fade-in { animation: fadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
			.animate-scale-in { animation: scaleIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
			
			/* Suavizado de transiciones globales */
			* {
				transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;
				transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
				transition-duration: 150ms;
			}
		</style>

		<!-- Prevenir salto de tema y sanitizar tema inicial -->
		<script is:inline>
			(function() {
				try {
					const saved = localStorage.getItem('theme');
					const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					if (saved === 'dark' || (!saved && prefersDark)) {
						document.documentElement.classList.add('dark');
					}
				} catch (e) {
					console.warn('Proteccion de almacenamiento activada');
				}
			})();
		</script>
	</head>
	<body class="bg-gray-50 dark:bg-gray-950 min-h-screen font-sans text-gray-900 dark:text-gray-100 flex flex-col transition-colors duration-300 antialiased selection:bg-blue-600 selection:text-white">
		<!-- Toast Notification Global en Esquina Superior Derecha -->
		<div id="globalToast" class="fixed top-5 right-5 z-[300] hidden max-w-sm w-full bg-white/95 dark:bg-gray-900/95 backdrop-blur-2xl border border-blue-200 dark:border-blue-900/50 shadow-2xl rounded-2xl p-4 transition-all duration-300 transform translate-y-[-20px] opacity-0 font-inter">
			<div class="flex items-start gap-3">
				<div id="globalToastIcon" class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl flex-shrink-0 border border-blue-100 dark:border-blue-900/40">
					
				</div>
				<div class="flex-1 pr-2">
					<h4 id="globalToastTitle" class="text-sm font-bold text-gray-900 dark:text-white font-josefin">Notificación</h4>
					<p id="globalToastMessage" class="text-xs text-gray-600 dark:text-gray-400 mt-0.5 leading-relaxed"></p>
				</div>
				<button id="btnGlobalCloseToast" class="text-gray-400 hover:text-gray-600 dark:hover:text-white text-lg font-bold">&times;</button>
			</div>
		</div>

		<script is:inline>
			let toastTimeout = null;
			window.showToast = function(title, message, icon = "🔔") {
				const toast = document.getElementById('globalToast');
				const toastTitle = document.getElementById('globalToastTitle');
				const toastMessage = document.getElementById('globalToastMessage');
				const toastIcon = document.getElementById('globalToastIcon');

				if (!toast) return;
				if (toastTimeout) clearTimeout(toastTimeout);

				toastTitle.textContent = title;
				toastMessage.textContent = message;
				toastIcon.textContent = icon || "🔔";

				toast.classList.remove('hidden');
				setTimeout(() => {
					toast.classList.remove('translate-y-[-20px]', 'opacity-0');
					toast.classList.add('translate-y-0', 'opacity-100');
				}, 10);

				toastTimeout = setTimeout(() => {
					window.hideToast();
				}, 5000);
			};

			window.hideToast = function() {
				const toast = document.getElementById('globalToast');
				if (!toast) return;
				toast.classList.remove('translate-y-0', 'opacity-100');
				toast.classList.add('translate-y-[-20px]', 'opacity-0');
				setTimeout(() => {
					toast.classList.add('hidden');
				}, 300);
			};

			document.getElementById('btnGlobalCloseToast')?.addEventListener('click', () => {
				window.hideToast();
			});
		</script>

		<Header />
		<main class="flex-grow flex flex-col">
			<slot />
		</main>

		<!-- Footer Institucional FinanceAI -->
		<footer class="mt-auto w-full border-t border-gray-200 dark:border-gray-800/80 bg-white/90 dark:bg-gray-950/90 backdrop-blur-md transition-colors duration-300 font-inter">
			<div class="max-w-7xl mx-auto px-6 py-8 md:py-10 flex flex-col md:flex-row items-center justify-between gap-6">
				
				<!-- Identidad Institucional y Copyright -->
				<div class="flex flex-col items-center md:items-start text-center md:text-left gap-1.5">
					<div class="flex items-center space-x-2">
						<div class="flex space-x-1">
							<div class="w-2 h-2 rounded-full bg-blue-600"></div>
							<div class="w-2 h-2 rounded-full bg-red-500"></div>
							<div class="w-2 h-2 rounded-full bg-yellow-400"></div>
						</div>
						<span class="font-bold text-base tracking-tight text-gray-900 dark:text-white font-josefin">FinanceAI</span>
					</div>
					<p class="text-xs text-gray-500 dark:text-gray-400">
						&copy; 2026 FinanceAI Inc. Todos los derechos reservados.
					</p>
					<p class="text-[11px] text-gray-400 dark:text-gray-500 max-w-sm">
						Plataforma desarrollada bajo estándares de seguridad OWASP y gobernanza de privacidad en Latinoamérica.
					</p>
				</div>

				<!-- Enlaces Legales y de Cumplimiento -->
				<nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs font-medium text-gray-600 dark:text-gray-400" aria-label="Enlaces legales">
					<a href="/terminos" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Términos de Servicio</a>
					<a href="/privacidad" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Aviso de Privacidad</a>
					<button type="button" class="btn-open-no-sale hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer">No Venta de Datos</button>
					<button type="button" class="btn-open-ai-ethics hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer">Transparencia de IA</button>
				</nav>

				<!-- Badges de Certificación & Seguridad Técnica -->
				<div class="flex items-center gap-2">
					<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
						<svg class="w-3 h-3 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
						SSL 256-Bit
					</span>
					<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">
						<svg class="w-3 h-3 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
						IA Auditada
					</span>
				</div>
			</div>
		</footer>

		<!-- Modal Glassmorphic Global Legal -->
		<div id="globalLegalModal" class="hidden fixed inset-0 z-[250] flex items-center justify-center bg-gray-900/75 backdrop-blur-md animate-fade-in font-inter">
			<div class="bg-white dark:bg-gray-900 w-full max-w-2xl mx-4 rounded-3xl p-6 sm:p-8 shadow-2xl border border-gray-200 dark:border-gray-800 text-left animate-scale-in max-h-[85vh] flex flex-col">
				<!-- Header Modal -->
				<div class="flex justify-between items-center pb-4 border-b border-gray-100 dark:border-gray-800">
					<div>
						<h3 id="legalModalTitle" class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white font-josefin">Documento Legal</h3>
						<p class="text-xs text-gray-500 dark:text-gray-400">FinanceAI &bull; Marco de Cumplimiento Normativo</p>
					</div>
					<button id="btnCloseLegalModal" class="text-gray-400 hover:text-gray-900 dark:hover:text-white text-3xl font-bold w-10 h-10 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 flex items-center justify-center transition-all leading-none">&times;</button>
				</div>

				<!-- Contenido Escroleable -->
				<div id="legalModalBody" class="py-4 space-y-4 text-xs text-gray-600 dark:text-gray-300 overflow-y-auto leading-relaxed pr-2">
					<!-- Contenido inyectado dinámicamente -->
				</div>

				<!-- Footer Modal -->
				<div class="pt-4 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between">
					<a id="legalModalFullLink" href="/terminos" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
						Ver página completa &rarr;
					</a>
					<button id="btnDismissLegalModal" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl text-xs transition">
						Entendido
					</button>
				</div>
			</div>
		</div>

		<!-- Script Global de Modales Legales -->
		<script is:inline>
			(function() {
				const modal = document.getElementById('globalLegalModal');
				const title = document.getElementById('legalModalTitle');
				const body = document.getElementById('legalModalBody');
				const fullLink = document.getElementById('legalModalFullLink');
				const btnClose = document.getElementById('btnCloseLegalModal');
				const btnDismiss = document.getElementById('btnDismissLegalModal');

				const legalContents = {
					terminos: {
						title: "Términos y Condiciones de Uso",
						url: "/terminos",
						html: `
							<p><strong>FinanceAI</strong> es una plataforma tecnológica orientada al registro ordenado de finanzas, analítica histórica y diagnósticos de salud financiera basados en la regla 50-30-20.</p>
							<p><strong>Exclusión de la Ley Fintech:</strong> FinanceAI NO capta recursos del público, NO custodia fondos, NO es una Wallet y NO realiza transferencias de dinero.</p>
							<p><strong>Disclaimer Financiero:</strong> Los scores y reportes NO constituyen asesoramiento financiero ni bursátil regulado. Toda decisión patrimonial es responsabilidad exclusiva del usuario.</p>
							<p><strong>Autenticación con Google:</strong> El inicio de sesión con Google cumple estrictamente con los requisitos de Uso Limitado de las APIs de Google.</p>
						`
					},
					privacidad: {
						title: "Aviso de Privacidad Integral",
						url: "/privacidad",
						html: `
							<p><strong>Cumplimiento LFPDPPP (INAI) & GDPR:</strong> FinanceAI trata tus datos personales y financieros exclusivamente para emitir tus diagnósticos y gestionar tu panel.</p>
							<p><strong>Consentimiento Expreso:</strong> Al registrarte, consientes expresamente el tratamiento de tus datos financieros bajo cifrado de alto nivel.</p>
							<p><strong>Cero Venta de Datos:</strong> NUNCA vendemos, alquilamos ni transferimos tus datos a terceros ni agencias de publicidad comercial.</p>
							<p><strong>Derechos ARCO:</strong> Puedes ejercer en cualquier momento tus derechos de Acceso, Rectificación, Cancelación y Oposición directamente en tu perfil o vía <code>privacidad@financeai.app</code>.</p>
						`
					},
					nosell: {
						title: "Garantía de Cero Venta de Datos (CCPA / CPRA)",
						url: "/privacidad",
						html: `
							<div class="p-3 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 rounded-xl text-emerald-900 dark:text-emerald-200 font-semibold mb-2">
								Do Not Sell or Share My Personal Information
							</div>
							<p>En cumplimiento con la <em>California Consumer Privacy Act</em> (CCPA) y las leyes de privacidad mexicanas, FinanceAI garantiza que:</p>
							<ul class="list-disc pl-5 space-y-1">
								<li>No comercializamos tus datos con corredores de datos (*data brokers*).</li>
								<li>No compartimos tu información transaccional con redes de publicidad programática ni aseguradoras.</li>
								<li>Tus datos financieros son tratados con la más alta categoría de Sensibilidad (*Sensitive Personal Information*).</li>
							</ul>
						`
					},
					ai: {
						title: "Transparencia y Gobernanza de Inteligencia Artificial",
						url: "/terminos",
						html: `
							<p><strong>1. Diagnósticos con IA Explicable (XAI):</strong> El análisis de salud financiera procesa ratios adimensionales matemáticos ($R_{GI}, R_{Ahorro}, R_{Deuda}$) garantizando neutralidad multidivisa e interpretabilidad.</p>
							<p><strong>2. Desarrollo Asistido por IA bajo Supervisión Humana:</strong> El código y la arquitectura del sistema fueron asistidos por herramientas de IA, pero <strong>auditados, validados y testeados exhaustivamente por ingenieros de software humanos calificados</strong>.</p>
							<p><strong>3. Intervención Humana (GDPR Art. 22):</strong> Puedes solicitar la revisión humana de cualquier diagnóstico comunicándote a <code>soporte@financeai.app</code>.</p>
						`
					}
				};

				window.openLegalModal = function(type) {
					const data = legalContents[type] || legalContents.terminos;
					if (title) title.textContent = data.title;
					if (body) body.innerHTML = data.html;
					if (fullLink) {
						fullLink.href = data.url;
						fullLink.textContent = `Ver documento completo en ${data.url} \u2192`;
					}
					if (modal) modal.classList.remove('hidden');
				};

				window.closeLegalModal = function() {
					if (modal) modal.classList.add('hidden');
				};

				btnClose?.addEventListener('click', window.closeLegalModal);
				btnDismiss?.addEventListener('click', window.closeLegalModal);
				modal?.addEventListener('click', (e) => {
					if (e.target === modal) window.closeLegalModal();
				});

				// Event delegation para botones legales
				document.addEventListener('click', (e) => {
					const target = e.target;
					if (target && target.closest('.btn-open-legal')) {
						const btn = target.closest('.btn-open-legal');
						const type = btn.getAttribute('data-legal') || 'terminos';
						window.openLegalModal(type);
					} else if (target && target.closest('.btn-open-no-sale')) {
						window.openLegalModal('nosell');
					} else if (target && target.closest('.btn-open-ai-ethics')) {
						window.openLegalModal('ai');
					}
				});
			})();
		</script>
	</body>
</html>
