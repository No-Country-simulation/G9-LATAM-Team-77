</Layout>

<script define:vars={{ API_URL, session }}>
    // Protección de ruta
    if (!session && !localStorage.getItem('financeai_token')) {
        window.location.href = '/login';
    }

    // Google Sync Trick
    if (session && !localStorage.getItem('financeai_token')) {
        fetch(`${API_URL}/api/v1/auth/google-sync`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                email: session.user?.email || "google@example.com",
                name: session.user?.name || "Usuario de Google"
            })
        }).then(res => res.json()).then(data => {
            if (data && data.token) {
                localStorage.setItem('financeai_token', data.token);
                localStorage.setItem('financeai_user', JSON.stringify(data));
                window.location.reload(); 
            }
        }).catch(err => console.error("Error en sincronizacion con Google:", err));
    }

    // Sincronizar nombre de usuario en el encabezado de bienvenida
    function setGreetingName() {
        const nameHeader = document.getElementById('dashboardUserNameHeader');
        if (!nameHeader) return;
        try {
            const cachedUser = JSON.parse(localStorage.getItem('financeai_user') || '{}');
            const fullName = cachedUser.nombre ? `${cachedUser.nombre} ${cachedUser.apellido || ''}`.trim() : (cachedUser.name || '');
            if (fullName) {
                nameHeader.textContent = fullName;
            }
        } catch (_) {}
    }
    setGreetingName();

    // Verificar perfil para pais/moneda
    const currentToken = localStorage.getItem('financeai_token');
    if (currentToken) {
        fetch(`${API_URL}/api/v1/users/profile`, {
            headers: { 'Authorization': `Bearer ${currentToken}` }
        }).then(res => {
            if (!res.ok) {
                if (res.status === 401) {
                    localStorage.removeItem('financeai_token');
                }
                return null;
            }
            return res.json();
        }).then(user => {
            if (user) {
                const fullName = user.nombre ? `${user.nombre} ${user.apellido || ''}`.trim() : (user.name || '');
                const nameHeader = document.getElementById('dashboardUserNameHeader');
                if (nameHeader && fullName) {
                    nameHeader.textContent = fullName;
                }

                // Sincronizar moneda oficial elegida por el usuario en BD
                const userCur = (user.codigoMoneda || user.monedaCodigo || user.moneda || '').toUpperCase();
                if (userCur) {
                    localStorage.setItem('financeai_preferred_currency', userCur);
                    if (activeCurrency !== userCur) {
                        activeCurrency = userCur;
                        if (activeCurrencyDisplay) activeCurrencyDisplay.textContent = activeCurrency;
                        document.querySelectorAll('.currencySymbol').forEach(el => el.textContent = activeCurrency);
                        syncDashboardLiveBalance();
                        window.dispatchEvent(new CustomEvent('financeai_currency_changed', { detail: { currency: userCur } }));
                    }
                }
            }
            if (!user.paisId || !user.monedaId) {
                document.getElementById('completeProfileModal')?.classList.remove('hidden');
                
                document.getElementById('btnSaveProfile')?.addEventListener('click', async () => {
                    const btn = document.getElementById('btnSaveProfile');
                    btn.disabled = true;
                    btn.textContent = 'Guardando...';
                    
                    const pId = parseInt(document.getElementById('modalPaisId').value);
                    const mId = parseInt(document.getElementById('modalMonedaId').value);
                    const currencyCodes = { 1: 'CRC', 2: 'MXN', 3: 'USD', 4: 'EUR', 5: 'COP', 6: 'ARS', 7: 'CLP', 8: 'PEN', 9: 'HNL', 10: 'BRL' };
                    localStorage.setItem('financeai_preferred_currency', currencyCodes[mId] || 'USD');

                    const updateRes = await fetch(`${API_URL}/api/v1/users/profile`, {
                        method: 'PUT',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${currentToken}`
                        },
                        body: JSON.stringify({ paisId: pId, monedaId: mId })
                    });
                    
                    if (updateRes.ok) {
                        window.location.reload();
                    } else {
                        btn.disabled = false;
                        btn.textContent = 'Error al guardar';
                    }
                });
            }
        }).catch(err => console.error("Error al obtener perfil", err));
    }

    // Moneda activa
    let activeCurrency = (localStorage.getItem('financeai_preferred_currency') || 'USD').toUpperCase();
    const activeCurrencyDisplay = document.getElementById('activeCurrencyDisplay');
    if (activeCurrencyDisplay) activeCurrencyDisplay.textContent = activeCurrency;
    document.querySelectorAll('.currencySymbol').forEach(el => el.textContent = activeCurrency);

    const OFFICIAL_USD_VALUES = {
        USD: 1.00,
        MXN: 0.0591,
        EUR: 1.1687,
        CRC: 0.0022,
        COP: 0.000326,
        ARS: 0.000667,
        CLP: 0.001093,
        PEN: 0.2982,
        HNL: 0.0404,
        BRL: 0.1770
    };

    function convertAmount(amount, fromCur, toCur) {
        if (!amount || isNaN(amount)) return 0;
        const from = (fromCur || 'USD').toUpperCase();
        const to = (toCur || 'USD').toUpperCase();
        if (from === to) return Number(amount);

        const fromVal = OFFICIAL_USD_VALUES[from] || 1.0;
        const toVal = OFFICIAL_USD_VALUES[to] || 1.0;

        const inUSD = Number(amount) * fromVal;
        const converted = inUSD / toVal;
        return Math.round(converted * 100) / 100;
    }

    function syncDashboardLiveBalance() {
        const currentIngreso = parseFloat(document.getElementById('ingreso')?.value) || 0;
        const currentExpTotal = (typeof transacciones !== 'undefined' && Array.isArray(transacciones))
            ? transacciones.reduce((acc, t) => acc + (parseFloat(t.monto) || 0), 0)
            : 0;

        const ingresoUSD = convertAmount(currentIngreso, activeCurrency, 'USD');
        const expUSD = convertAmount(currentExpTotal, activeCurrency, 'USD');

        let existingHistory = [];
        const isHistoryExplicitlyCleared = localStorage.getItem('financeai_history_cleared') === 'true';
        try {
            const raw = localStorage.getItem('financeai_all_transactions');
            if (raw) existingHistory = JSON.parse(raw);
        } catch (_) {
            existingHistory = [];
        }

        let histIncUSD = 0;
        let histExpUSD = 0;
        if (Array.isArray(existingHistory) && existingHistory.length > 0) {
            existingHistory.forEach(t => {
                const a = parseFloat(t.amount || t.monto || t.valor || 0) || 0;
                const originCur = (t.originalCurrency || t.moneda || activeCurrency).toUpperCase();
                const amtInUSD = convertAmount(a, originCur, 'USD');
                const typ = (t.type || '').toUpperCase();
                const cat = (t.category || t.categoria || '').toUpperCase();
                if (typ === 'INCOME' || typ === 'INGRESO' || cat === 'INGRESOS') {
                    histIncUSD += amtInUSD;
                } else {
                    histExpUSD += amtInUSD;
                }
            });
            const netTotalUSD = histIncUSD - histExpUSD;
            window.dispatchEvent(new CustomEvent('financeai_global_balance_updated', { detail: { balanceUSD: netTotalUSD } }));
        } else {
            const liveTotalUSD = ingresoUSD - expUSD;
            window.dispatchEvent(new CustomEvent('financeai_global_balance_updated', { detail: { balanceUSD: liveTotalUSD } }));
        }
    }

    window.addEventListener('financeai_currency_changed', (e) => {
        if (e.detail?.currency) {
            activeCurrency = e.detail.currency.toUpperCase();
            if (activeCurrencyDisplay) activeCurrencyDisplay.textContent = activeCurrency;
            document.querySelectorAll('.currencySymbol').forEach(el => el.textContent = activeCurrency);
            syncDashboardLiveBalance();
        }
    });

    // 12 Categorías Oficiales (PR-02)
    const OFFICIAL_CATEGORIES = [
        "Vivienda",
        "Alimentación",
        "Transporte",
        "Servicios",
        "Salud y bienestar",
        "Educación",
        "Entretenimiento",
        "Compras",
        "Cuidado personal",
        "Regalos",
        "Viajes",
        "Otros"
    ];

    // ─── GESTIÓN DE PERIODICIDAD & CALENDARIO UNIVERSAL ───
    const now = new Date();
    const todayISO = now.toISOString().slice(0, 10);
    
    let currentMinDate = todayISO.slice(0, 7) + "-01";
    let currentMaxDate = todayISO;
    let dashCalYear = now.getFullYear();
    let dashCalMonth = now.getMonth(); // 0-11
    let dashPickerYear = now.getFullYear();
    let selectedQuincena = now.getDate() >= 16 ? 2 : 1;

    const selectPeriodicity = document.getElementById('selectPeriodicity');
    const selectSubPeriod = document.getElementById('selectSubPeriod');
    const periodBadge = document.getElementById('periodBadge');
    const dateRangeNotice = document.getElementById('dateRangeNotice');

    const btnCustomSubPeriodTrigger = document.getElementById('btnCustomSubPeriodTrigger');
    const customSubPeriodDisplay = document.getElementById('customSubPeriodDisplay');
    const customSubPeriodDropdown = document.getElementById('customSubPeriodDropdown');
    const dashCalMonthlyView = document.getElementById('dashCalMonthlyView');
    const dashCalDaysView = document.getElementById('dashCalDaysView');
    const dashYearLabel = document.getElementById('dashYearLabel');
    const dashMonthsGrid = document.getElementById('dashMonthsGrid');
    const btnDashPrevYear = document.getElementById('btnDashPrevYear');
    const btnDashNextYear = document.getElementById('btnDashNextYear');
    const dashCalMonthLabel = document.getElementById('dashCalMonthLabel');
    const dashCalYearLabel = document.getElementById('dashCalYearLabel');
    const btnDashPrevMonth = document.getElementById('btnDashPrevMonth');
    const btnDashNextMonth = document.getElementById('btnDashNextMonth');
    const dashCalContextBanner = document.getElementById('dashCalContextBanner');
    const dashCalQuincenaButtons = document.getElementById('dashCalQuincenaButtons');
    const btnQ1 = document.getElementById('btnQ1');
    const btnQ2 = document.getElementById('btnQ2');
    const dashCalDaysGrid = document.getElementById('dashCalDaysGrid');

    // Variables de cálculo
    let lastCalculatedAhorro = 0;

    const MONTH_NAMES = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
    const MONTH_ABBR = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];

    function formatWeeklyLabel(dStart, dEnd) {
        const startDay = dStart.getDate();
        const endDay = dEnd.getDate();
        const startMonth = MONTH_NAMES[dStart.getMonth()];
        const endMonth = MONTH_NAMES[dEnd.getMonth()];
        const endYear = dEnd.getFullYear();

        if (dStart.getMonth() === dEnd.getMonth()) {
            return `Semana del ${startDay} al ${endDay} de ${endMonth} ${endYear}`;
        } else {
            return `Semana del ${startDay} de ${startMonth} al ${endDay} de ${endMonth} ${endYear}`;
        }
    }

    function updateSubPeriods() {
        const periodicity = selectPeriodicity.value;
        periodBadge.textContent = periodicity.charAt(0).toUpperCase() + periodicity.slice(1);
        
        dashCalYear = now.getFullYear();
        dashCalMonth = now.getMonth();
        dashPickerYear = now.getFullYear();
        
        setDefaultPeriodBounds(periodicity);
        refreshCalendarUI();
    }

    function refreshCalendarUI() {
        const periodicity = selectPeriodicity.value;
        if (periodicity === 'mensual') {
            dashCalMonthlyView?.classList.remove('hidden');
            dashCalDaysView?.classList.add('hidden');
            renderDashMonthlyGrid();
        } else {
            dashCalMonthlyView?.classList.add('hidden');
            dashCalDaysView?.classList.remove('hidden');
            renderUniversalCalendar();
        }
    }

    function setDefaultPeriodBounds(periodicity) {
        const year = now.getFullYear();
        const month = now.getMonth();
        const mStr = String(month + 1).padStart(2, '0');
        const lastDay = new Date(year, month + 1, 0).getDate();

        if (periodicity === 'mensual') {
            const start = `${year}-${mStr}-01`;
            let end = `${year}-${mStr}-${String(lastDay).padStart(2, '0')}`;
            if (end > todayISO) end = todayISO;
            setPeriodSelection(start, end, `${MONTH_NAMES[month]} ${year}`);
        } else if (periodicity === 'quincenal') {
            if (now.getDate() >= 16) {
                selectedQuincena = 2;
                setPeriodSelection(`${year}-${mStr}-16`, todayISO, `2da Quincena ${MONTH_NAMES[month].slice(0, 3)} ${year}`);
            } else {
                selectedQuincena = 1;
                setPeriodSelection(`${year}-${mStr}-01`, `${year}-${mStr}-15`, `1ra Quincena ${MONTH_NAMES[month].slice(0, 3)} ${year}`);
            }
        } else if (periodicity === 'semanal') {
            const dayOfWeek = (now.getDay() + 6) % 7;
            const dStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() - dayOfWeek);
            const dEnd = new Date(dStart.getFullYear(), dStart.getMonth(), dStart.getDate() + 6);
            const startStr = dStart.toISOString().slice(0, 10);
            let endStr = dEnd.toISOString().slice(0, 10);
            if (endStr > todayISO) endStr = todayISO;
            setPeriodSelection(startStr, endStr, formatWeeklyLabel(dStart, dEnd));
        } else if (periodicity === 'diario') {
            setPeriodSelection(todayISO, todayISO, `${now.getDate()} de ${MONTH_NAMES[month]} ${year}`);
        }
    }

    // 1. RENDER VISTA MENSUAL (Solo los 12 meses, sin números de días)
    function renderDashMonthlyGrid() {
        if (!dashYearLabel || !dashMonthsGrid) return;
        dashYearLabel.textContent = dashPickerYear.toString();

        const currentYear = now.getFullYear();
        const currentMonth = now.getMonth();

        dashMonthsGrid.innerHTML = MONTH_ABBR.map((mName, idx) => {
            const mStr = String(idx + 1).padStart(2, '0');
            const start = `${dashPickerYear}-${mStr}-01`;
            const lastDay = new Date(dashPickerYear, idx + 1, 0).getDate();
            let end = `${dashPickerYear}-${mStr}-${String(lastDay).padStart(2, '0')}`;
            if (dashPickerYear === currentYear && idx === currentMonth && end > todayISO) {
                end = todayISO;
            }

            const val = `${start}|${end}`;
            const isFuture = (dashPickerYear === currentYear && idx > currentMonth) || (dashPickerYear > currentYear);
            const isTooOld = dashPickerYear < currentYear - 2;
            const isDisabled = isFuture || isTooOld;
            
            const isSelected = currentMinDate === start;

            return `
                <button type="button" class="dash-month-tile py-2.5 px-2 text-xs font-semibold rounded-xl transition-all ${
                    isSelected 
                        ? 'bg-blue-600 text-white font-bold shadow-md scale-[1.02]'
                        : isDisabled
                            ? 'text-gray-300 dark:text-gray-700 cursor-not-allowed bg-transparent'
                            : 'text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-800 hover:bg-blue-50 dark:hover:bg-blue-900/40 hover:text-blue-600 cursor-pointer'
                }" data-start="${start}" data-end="${end}" data-label="${MONTH_NAMES[idx]} ${dashPickerYear}" ${isDisabled ? 'disabled' : ''}>
                    ${mName}
                </button>
            `;
        }).join('');

        dashMonthsGrid.querySelectorAll('.dash-month-tile:not([disabled])').forEach(btn => {
            btn.onclick = (e) => {
                e.stopPropagation();
                const start = btn.getAttribute('data-start');
                const end = btn.getAttribute('data-end');
                const label = btn.getAttribute('data-label');
                setPeriodSelection(start, end, label);
                customSubPeriodDropdown?.classList.add('hidden');
                renderDashMonthlyGrid();
            };
        });
    }

    btnDashPrevYear?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (dashPickerYear > now.getFullYear() - 2) {
            dashPickerYear--;
            renderDashMonthlyGrid();
        }
    });

    btnDashNextYear?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (dashPickerYear < now.getFullYear()) {
            dashPickerYear++;
            renderDashMonthlyGrid();
        }
    });

    // 2. RENDER VISTA DÍAS (Para Quincenal, Semanal y Diario)
    function renderUniversalCalendar() {
        if (!dashCalMonthLabel || !dashCalYearLabel || !dashCalDaysGrid) return;

        dashCalMonthLabel.textContent = MONTH_NAMES[dashCalMonth];
        dashCalYearLabel.textContent = dashCalYear.toString();

        const periodicity = selectPeriodicity.value;

        if (dashCalContextBanner) {
            if (periodicity === 'quincenal') {
                dashCalContextBanner.textContent = 'Selecciona la 1ra o 2da quincena del mes';
                dashCalQuincenaButtons?.classList.remove('hidden');
                updateQuincenaButtonsUI();
            } else if (periodicity === 'semanal') {
                dashCalContextBanner.textContent = 'Haz clic en cualquier día para seleccionar su semana completa';
                dashCalQuincenaButtons?.classList.add('hidden');
            } else if (periodicity === 'diario') {
                dashCalContextBanner.textContent = 'Haz clic en el día exacto que deseas evaluar';
                dashCalQuincenaButtons?.classList.add('hidden');
            }
        }

        const daysInMonth = new Date(dashCalYear, dashCalMonth + 1, 0).getDate();
        const firstDayIndex = (new Date(dashCalYear, dashCalMonth, 1).getDay() + 6) % 7;

        let gridHTML = '';

        for (let i = 0; i < firstDayIndex; i++) {
            gridHTML += `<div class="p-1 text-[11px] text-gray-300 dark:text-gray-700 select-none"></div>`;
        }

        const mStr = String(dashCalMonth + 1).padStart(2, '0');

        for (let d = 1; d <= daysInMonth; d++) {
            const dStr = String(d).padStart(2, '0');
            const dayISO = `${dashCalYear}-${mStr}-${dStr}`;
            const isFuture = dayISO > todayISO;
            const isTooOld = dashCalYear < now.getFullYear() - 2;
            const isDisabled = isFuture || isTooOld;

            const isInCurrentRange = (dayISO >= currentMinDate && dayISO <= currentMaxDate);

            gridHTML += `
                <button type="button" class="cal-day-cell p-1.5 text-[11px] font-semibold transition-all ${
                    isDisabled 
                        ? 'text-gray-300 dark:text-gray-700 cursor-not-allowed bg-transparent'
                        : isInCurrentRange
                            ? 'bg-blue-600 text-white font-bold rounded-lg shadow-sm scale-105 z-10'
                            : 'text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-800/80 hover:bg-blue-100 dark:hover:bg-blue-900/50 hover:text-blue-600 rounded-lg cursor-pointer'
                }" data-day="${d}" data-date="${dayISO}" ${isDisabled ? 'disabled' : ''}>
                    ${d}
                </button>
            `;
        }

        dashCalDaysGrid.innerHTML = gridHTML;

        dashCalDaysGrid.querySelectorAll('.cal-day-cell:not([disabled])').forEach(btn => {
            btn.onclick = (e) => {
                e.stopPropagation();
                const d = parseInt(btn.getAttribute('data-day'));
                const dayISO = btn.getAttribute('data-date');
                handleDaySelection(d, dayISO);
            };
        });
    }

    function updateQuincenaButtonsUI() {
        if (!btnQ1 || !btnQ2) return;
        if (selectedQuincena === 1) {
            btnQ1.className = 'py-1.5 px-2 text-[10px] font-bold rounded-lg transition-all border border-blue-600 bg-blue-600 text-white shadow-sm cursor-pointer';
            btnQ2.className = 'py-1.5 px-2 text-[10px] font-bold rounded-lg transition-all border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer';
        } else {
            btnQ2.className = 'py-1.5 px-2 text-[10px] font-bold rounded-lg transition-all border border-blue-600 bg-blue-600 text-white shadow-sm cursor-pointer';
            btnQ1.className = 'py-1.5 px-2 text-[10px] font-bold rounded-lg transition-all border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer';
        }
    }

    btnQ1?.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedQuincena = 1;
        const mStr = String(dashCalMonth + 1).padStart(2, '0');
        const start = `${dashCalYear}-${mStr}-01`;
        let end = `${dashCalYear}-${mStr}-15`;
        if (end > todayISO) end = todayISO;
        setPeriodSelection(start, end, `1ra Quincena ${MONTH_NAMES[dashCalMonth].slice(0, 3)} ${dashCalYear}`);
        customSubPeriodDropdown?.classList.add('hidden');
        renderUniversalCalendar();
    });

    btnQ2?.addEventListener('click', (e) => {
        e.stopPropagation();
        selectedQuincena = 2;
        const mStr = String(dashCalMonth + 1).padStart(2, '0');
        const lastDay = new Date(dashCalYear, dashCalMonth + 1, 0).getDate();
        const start = `${dashCalYear}-${mStr}-16`;
        let end = `${dashCalYear}-${mStr}-${String(lastDay).padStart(2, '0')}`;
        if (end > todayISO) end = todayISO;
        setPeriodSelection(start, end, `2da Quincena ${MONTH_NAMES[dashCalMonth].slice(0, 3)} ${dashCalYear}`);
        customSubPeriodDropdown?.classList.add('hidden');
        renderUniversalCalendar();
    });

    function handleDaySelection(d, dayISO) {
        const periodicity = selectPeriodicity.value;
        const mStr = String(dashCalMonth + 1).padStart(2, '0');
        const lastDay = new Date(dashCalYear, dashCalMonth + 1, 0).getDate();

        if (periodicity === 'quincenal') {
            if (d <= 15) {
                selectedQuincena = 1;
                const start = `${dashCalYear}-${mStr}-01`;
                let end = `${dashCalYear}-${mStr}-15`;
                if (end > todayISO) end = todayISO;
                setPeriodSelection(start, end, `1ra Quincena ${MONTH_NAMES[dashCalMonth].slice(0, 3)} ${dashCalYear}`);
            } else {
                selectedQuincena = 2;
                const start = `${dashCalYear}-${mStr}-16`;
                let end = `${dashCalYear}-${mStr}-${String(lastDay).padStart(2, '0')}`;
                if (end > todayISO) end = todayISO;
                setPeriodSelection(start, end, `2da Quincena ${MONTH_NAMES[dashCalMonth].slice(0, 3)} ${dashCalYear}`);
            }
        } else if (periodicity === 'semanal') {
            const selectedDate = new Date(dashCalYear, dashCalMonth, d);
            const dayOfWeek = (selectedDate.getDay() + 6) % 7;
            const dStart = new Date(dashCalYear, dashCalMonth, d - dayOfWeek);
            const dEnd = new Date(dStart.getFullYear(), dStart.getMonth(), dStart.getDate() + 6);

            const startStr = dStart.toISOString().slice(0, 10);
            let endStr = dEnd.toISOString().slice(0, 10);
            if (endStr > todayISO) endStr = todayISO;

            setPeriodSelection(startStr, endStr, formatWeeklyLabel(dStart, dEnd));
        } else if (periodicity === 'diario') {
            setPeriodSelection(dayISO, dayISO, `${d} de ${MONTH_NAMES[dashCalMonth]} ${dashCalYear}`);
        }

        customSubPeriodDropdown?.classList.add('hidden');
        renderUniversalCalendar();
    }

    function setPeriodSelection(start, end, label) {
        currentMinDate = start;
        currentMaxDate = end;
        selectSubPeriod.value = `${start}|${end}`;
        if (customSubPeriodDisplay) customSubPeriodDisplay.textContent = label;
        applyDateBounds();
    }

    btnDashPrevMonth?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (dashCalMonth === 0) {
            if (dashCalYear > now.getFullYear() - 2) {
                dashCalYear--;
                dashCalMonth = 11;
                renderUniversalCalendar();
            }
        } else {
            dashCalMonth--;
            renderUniversalCalendar();
        }
    });

    btnDashNextMonth?.addEventListener('click', (e) => {
        e.stopPropagation();
        const currentYear = now.getFullYear();
        const currentMonth = now.getMonth();
        if (dashCalYear === currentYear && dashCalMonth >= currentMonth) return;

        if (dashCalMonth === 11) {
            if (dashCalYear < currentYear) {
                dashCalYear++;
                dashCalMonth = 0;
                renderUniversalCalendar();
            }
        } else {
            dashCalMonth++;
            renderUniversalCalendar();
        }
    });

    btnCustomSubPeriodTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        customSubPeriodDropdown?.classList.toggle('hidden');
        refreshCalendarUI();
    });

    document.addEventListener('click', (e) => {
        if (!customSubPeriodDropdown?.contains(e.target) && e.target !== btnCustomSubPeriodTrigger) {
            customSubPeriodDropdown?.classList.add('hidden');
        }
    });

    function applyDateBounds() {
        if (!currentMinDate || !currentMaxDate) return;

        if (currentMaxDate > todayISO) {
            currentMaxDate = todayISO;
        }

        dateRangeNotice.textContent = currentMinDate === currentMaxDate 
            ? `Día seleccionado: ${currentMinDate}` 
            : `${currentMinDate} al ${currentMaxDate}`;

        transacciones.forEach(tx => {
            if (tx.fecha < currentMinDate) tx.fecha = currentMinDate;
            if (tx.fecha > currentMaxDate) tx.fecha = currentMaxDate;
        });

        renderTransacciones();
    }

    selectPeriodicity?.addEventListener('change', updateSubPeriods);
    selectSubPeriod?.addEventListener('change', applyDateBounds);

    // Estado inicial de transacciones
    let transacciones = [];

    function renderTransacciones() {
        const list = document.getElementById('txList');
        if (!list) return;

        const selectedCategories = transacciones.map(t => t.descripcion);

        list.innerHTML = transacciones.map((tx, idx) => `
            <div class="grid grid-cols-12 gap-1.5 sm:gap-2 items-center bg-gray-50 dark:bg-gray-800/80 p-2 rounded-2xl border border-gray-200 dark:border-gray-700 animate-fade-in" data-id="${tx.id}">
                <div class="col-span-12 sm:col-span-5">
                    <select class="tx-category w-full px-2.5 py-2 text-xs bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white">
                        ${OFFICIAL_CATEGORIES.map(cat => {
                            const isCurrent = tx.descripcion === cat;
                            const isTaken = selectedCategories.includes(cat) && !isCurrent;
                            return `<option value="${cat}" ${isCurrent ? 'selected' : ''} ${isTaken ? 'disabled class="text-gray-400 dark:text-gray-600 bg-gray-100 dark:bg-gray-800"' : ''}>${cat}${isTaken ? ' (Ya seleccionada)' : ''}</option>`;
                        }).join('')}
                    </select>
                </div>
                <div class="col-span-5 sm:col-span-3">
                    <input type="number" min="1" value="${tx.monto !== undefined && tx.monto !== '' ? tx.monto : ''}" placeholder="Monto"
                        class="tx-amount w-full px-2.5 py-2 text-xs bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white" />
                </div>
                <div class="col-span-5 sm:col-span-3">
                    <input type="date" min="${currentMinDate}" max="${currentMaxDate}" value="${tx.fecha || currentMinDate}"
                        class="tx-date w-full px-2 py-2 text-[11px] bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white" />
                </div>
                <div class="col-span-2 sm:col-span-1 flex justify-center">
                    <button type="button" class="btn-remove-tx p-1.5 text-gray-400 hover:text-red-500 transition rounded-lg" data-id="${tx.id}" title="Eliminar">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
            </div>
        `).join('');

        document.getElementById('txCount').textContent = `${transacciones.length} agregada(s)`;

        // Controlar estado del botón de agregar si se alcanzaron las 12 categorías
        const btnAddTx = document.getElementById('btnAddTx');
        if (btnAddTx) {
            if (transacciones.length >= OFFICIAL_CATEGORIES.length) {
                btnAddTx.classList.add('opacity-50', 'cursor-not-allowed');
            } else {
                btnAddTx.classList.remove('opacity-50', 'cursor-not-allowed');
            }
        }

        // Eventos
        document.querySelectorAll('.btn-remove-tx').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = parseInt(btn.getAttribute('data-id'));
                transacciones = transacciones.filter(t => t.id !== id);
                renderTransacciones();
                syncDashboardLiveBalance();
            });
        });

        document.querySelectorAll('.tx-category').forEach((sel, idx) => {
            sel.addEventListener('change', () => {
                transacciones[idx].descripcion = sel.value;
                renderTransacciones();
            });
        });

        document.querySelectorAll('.tx-amount').forEach((inp, idx) => {
            inp.addEventListener('input', () => {
                transacciones[idx].monto = parseFloat(inp.value) || 0;
                syncDashboardLiveBalance();
            });
        });

        document.querySelectorAll('.tx-date').forEach((inp, idx) => {
            inp.addEventListener('change', () => {
                let val = inp.value;
                if (val > currentMaxDate) val = currentMaxDate;
                if (val < currentMinDate) val = currentMinDate;
                transacciones[idx].fecha = val;
                inp.value = val;
            });
        });
    }

    document.getElementById('btnAddTx')?.addEventListener('click', () => {
        const selectedCategories = transacciones.map(t => t.descripcion);
        const availableCategory = OFFICIAL_CATEGORIES.find(cat => !selectedCategories.includes(cat));

        if (!availableCategory) {
            if (window.showToast) {
                window.showToast('Límite Alcanzado', 'Ya has agregado todas las 12 categorías disponibles.', 'ℹ️');
            }
            return;
        }

        const nextId = transacciones.length > 0 ? Math.max(...transacciones.map(t => t.id)) + 1 : 1;
        transacciones.push({ id: nextId, descripcion: availableCategory, monto: '', fecha: currentMinDate });
        renderTransacciones();
        syncDashboardLiveBalance();
    });

    document.getElementById('ingreso')?.addEventListener('input', () => {
        syncDashboardLiveBalance();
    });

    updateSubPeriods();

    // ─── HELPER DE ANIMACIÓN NUMÉRICA SUAVE (COUNT-UP) ───
    function animateValue(elementId, start, end, duration, prefix = '', suffix = '') {
        const obj = document.getElementById(elementId);
        if (!obj) return;
        let startTimestamp = null;
        const step = (timestamp) => {
            if (!startTimestamp) startTimestamp = timestamp;
            const progress = Math.min((timestamp - startTimestamp) / duration, 1);
            // Curva easeOutCubic para desaceleración natural
            const ease = 1 - Math.pow(1 - progress, 3);
            const currentVal = Math.round(start + (end - start) * ease);
            obj.textContent = `${prefix}${currentVal.toLocaleString()}${suffix}`;
            if (progress < 1) {
                window.requestAnimationFrame(step);
            } else {
                obj.textContent = `${prefix}${end.toLocaleString()}${suffix}`;
            }
        };
        window.requestAnimationFrame(step);
    }

    // ─── ESTADO VISUAL DE CÁLCULO (PARPADEO SUAVE SIN ROTACIÓN) ───
    function setCalculatingState(isCalculating) {
        const scoreRing = document.getElementById('scoreRing');
        const scoreText = document.getElementById('scoreText');
        const badge = document.getElementById('scoreBadge');
        const badgeText = document.getElementById('scoreBadgeText');
        const statGastos = document.getElementById('statGastos');
        const statAhorroEst = document.getElementById('statAhorroEst');
        const statDeuda = document.getElementById('statDeuda');
        const statFrecuencia = document.getElementById('statFrecuencia');
        const statTotalAhorradoTop = document.getElementById('statTotalAhorradoTop');

        if (isCalculating) {
            scoreRing.classList.add('animate-pulse', 'text-blue-500');
            scoreText.textContent = '...';
            scoreText.classList.add('animate-pulse');

            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800 animate-pulse';
            badgeText.textContent = 'Calculando IA...';

            [statGastos, statAhorroEst, statDeuda, statFrecuencia, statTotalAhorradoTop].forEach(el => {
                if (el) el.classList.add('animate-pulse', 'opacity-60');
            });
        } else {
            scoreRing.classList.remove('animate-pulse');
            scoreText.classList.remove('animate-pulse');
            [statGastos, statAhorroEst, statDeuda, statFrecuencia, statTotalAhorradoTop].forEach(el => {
                if (el) el.classList.remove('animate-pulse', 'opacity-60');
            });
        }
    }

    // ─── EJECUTAR ANÁLISIS CON IA ───
    document.getElementById('btnAnalizar')?.addEventListener('click', async () => {
        const btn = document.getElementById('btnAnalizar');
        btn.disabled = true;
        btn.innerHTML = `
            <svg class="animate-spin w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            Procesando IA...`;

        setCalculatingState(true);

        const ingreso = parseFloat(document.getElementById('ingreso').value) || 0;
        const periodicity = selectPeriodicity.value;
        const txns = transacciones.map(t => ({ descripcion: t.descripcion, valor: t.monto }));

        const payload = {
            ingresoMensual: ingreso,
            nivelEndeudamiento: 0,
            frecuenciaAhorro: "AUTO",
            periodicidad: periodicity,
            moneda: activeCurrency,
            transacciones: txns
        };

        try {
            const token = localStorage.getItem('financeai_token');
            const headers = { 'Content-Type': 'application/json' };
            if (token) headers['Authorization'] = `Bearer ${token}`;

            const res = await fetch(`${API_URL}/api/v1/analisis-financiero`, {
                method: 'POST',
                headers: headers,
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                const data = await res.json();
                setCalculatingState(false);
                updateDashboardResults(data);

                // Acumular transacciones permanentemente en el historial sin borrar meses anteriores
                let existingHistory = [];
                try {
                    existingHistory = JSON.parse(localStorage.getItem('financeai_all_transactions') || '[]');
                } catch (_) {
                    existingHistory = [];
                }

                const periodLabel = customSubPeriodDisplay?.textContent?.trim() || `${MONTH_NAMES[now.getMonth()]} ${now.getFullYear()}`;
                const timestampBase = Date.now();
                const newTxns = [
                    {
                        id: timestampBase,
                        description: `Ingreso (${periodLabel})`,
                        amount: ingreso,
                        originalCurrency: activeCurrency,
                        category: 'Ingresos',
                        type: 'INCOME',
                        date: currentMinDate
                    },
                    ...transacciones.map((t, idx) => ({
                        id: timestampBase + idx + 1,
                        description: t.descripcion,
                        amount: t.monto,
                        originalCurrency: activeCurrency,
                        category: t.descripcion,
                        type: 'EXPENSE',
                        date: t.fecha || currentMinDate
                    }))
                ];

                const updatedHistory = [...existingHistory, ...newTxns];
                localStorage.setItem('financeai_all_transactions', JSON.stringify(updatedHistory));
                localStorage.setItem('financeai_dashboard_txns', JSON.stringify(updatedHistory));

                // Persistir cada transacción e ingreso en la base de datos MySQL (tabla transacciones)
                if (token) {
                    newTxns.forEach(async (tx) => {
                        try {
                            await fetch(`${API_URL}/api/v1/transactions`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Authorization': `Bearer ${token}`
                                },
                                body: JSON.stringify({
                                    description: tx.description || 'Transacción',
                                    amount: Math.max(0.01, parseFloat(tx.amount) || 0.01),
                                    category: tx.category || 'Otros',
                                    type: (tx.type === 'INCOME' || tx.type === 'INGRESO') ? 'INGRESO' : 'GASTO',
                                    date: tx.date || currentMinDate
                                })
                            });
                        } catch (_) {}
                    });
                }

                window.dispatchEvent(new CustomEvent('financeai_global_balance_updated'));

                window.showToast('¡Análisis Completado!', 'Resultados y transacciones guardadas exitosamente', '✨');
            } else {
                setCalculatingState(false);
                window.showToast('Error en Análisis', `No fue posible completar el análisis (HTTP ${res.status}).`, '⚠️');
            }
        } catch (e) {
            setCalculatingState(false);
            window.showToast('Error de Conexión', 'No fue posible contactar con el backend.', '📡');
        } finally {
            btn.disabled = false;
            btn.innerHTML = `
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                Ejecutar Análisis con IA`;
        }
    });

    function updateDashboardResults(data) {
        const score = Math.round(data.score_financiero || data.score || 0);
        
        // 1. Conteo Progresivo Suave del Score
        animateValue('scoreText', 0, score, 1200);
        
        // 2. Transición fluida del Anillo Gauge
        const scoreRing = document.getElementById('scoreRing');
        const offset = 314.159 - (314.159 * score) / 100;
        scoreRing.style.strokeDashoffset = offset;

        const badge = document.getElementById('scoreBadge');
        const badgeText = document.getElementById('scoreBadgeText');

        if (score >= 70) {
            scoreRing.setAttribute('class', 'text-emerald-500 transition-all duration-1000 ease-out');
            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 animate-scale-in';
            badgeText.textContent = 'Saludable';
        } else if (score >= 40) {
            scoreRing.setAttribute('class', 'text-amber-500 transition-all duration-1000 ease-out');
            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 dark:bg-amber-950/70 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800 animate-scale-in';
            badgeText.textContent = 'En Riesgo';
        } else {
            scoreRing.setAttribute('class', 'text-red-500 transition-all duration-1000 ease-out');
            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-100 dark:bg-red-950/70 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800 animate-scale-in';
            badgeText.textContent = 'Crítico';
        }

        // 3. Conteo Progresivo de Métricas Clave
        const totalGastos = Math.round(data.total_gastos || 0);
        const ahorroEst = Math.round(data.ahorro_estimado || 0);
        const ingresoInput = document.getElementById('ingreso');
        const ingresoVal = data.ingreso_mensual || (ingresoInput ? parseFloat(ingresoInput.value) || 0 : 0);
        lastCalculatedAhorro = Math.max(0, ingresoVal - totalGastos);
        const deudaPct = Math.round(data.nivel_endeudamiento || 0);

        animateValue('statGastos', 0, totalGastos, 1000, `${activeCurrency} `);
        animateValue('statAhorroEst', 0, ahorroEst, 1000, `${activeCurrency} `);
        animateValue('statDeuda', 0, deudaPct, 900, '', '%');
        
        const statDeudaNote = document.getElementById('statDeudaNote');
        if (statDeudaNote) {
            const ingTotal = data.ingreso_mensual || 0;
            if (deudaPct > 0) {
                statDeudaNote.textContent = `${deudaPct}% en pasivos fijos`;
            } else if (totalGastos > ingTotal && ingTotal > 0) {
                statDeudaNote.textContent = 'Déficit (0% deuda fija)';
            } else {
                statDeudaNote.textContent = '0% pasivos fijos';
            }
        }
        
        const statFrec = document.getElementById('statFrecuencia');
        if (statFrec) {
            statFrec.textContent = data.frecuencia_ahorro || 'Automática';
            statFrec.classList.add('animate-scale-in');
            setTimeout(() => statFrec.classList.remove('animate-scale-in'), 500);
        }

        // 4. Explicabilidad DS-08 en 3 Capas
        if (data.explicabilidad_ds08) {
            document.getElementById('capa1Text').textContent = data.explicabilidad_ds08.diagnostico || '';
            document.getElementById('capa2Text').textContent = data.explicabilidad_ds08.causa_principal || '';
            document.getElementById('capa3Text').textContent = data.explicabilidad_ds08.accion_recomendada || '';
        }

        // 5. Lista de Consejos y Alertas con Efecto Cascada
        const alertsList = document.getElementById('alertsList');
        const consejos = data.consejos_financieros || data.recomendaciones || [];

        if (consejos.length > 0) {
            alertsList.innerHTML = consejos.map((c, idx) => `
                <li class="p-3 bg-gray-50 dark:bg-gray-800/70 text-gray-700 dark:text-gray-300 rounded-2xl border border-gray-200/60 dark:border-gray-700/50 flex items-start gap-3 animate-fade-in" style="animation-delay: ${idx * 100}ms">
                    <div class="w-5 h-5 rounded-lg bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0 mt-0.5 text-[10px] font-bold">
                        ${idx + 1}
                    </div>
                    <span class="leading-relaxed font-medium">${c}</span>
                </li>
            `).join('');
        }
    }
</script>
