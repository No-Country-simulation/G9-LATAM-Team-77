---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';
---

<Layout title="Dashboard de Análisis | FinanceAI" description="Panel principal de análisis de salud financiera con IA explicable (Motor DS-08), cálculo de ratios adimensionales y simulador presupuestal.">
    <!-- Guardia de Protección de Ruta Seguro -->
    <script is:inline>
        if (!localStorage.getItem('financeai_token')) {
            window.location.replace('/login');
        }
        window.addEventListener('pageshow', function(e) {
            if (e.persisted && !localStorage.getItem('financeai_token')) {
                window.location.replace('/login');
            }
        });
    </script>

    <div class="w-full max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6 md:py-8 flex flex-col gap-4 sm:gap-6 font-inter">

        <!-- Welcome & Controls Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-gray-200 dark:border-gray-800 pb-4">
            <div class="space-y-0.5 sm:space-y-1">
                <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-gray-900 dark:text-white font-josefin leading-snug">
                    <span>Bienvenido, </span><span id="dashboardUserNameHeader" class="text-blue-600 dark:text-blue-400 font-extrabold">Usuario</span>
                </h1>
                <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 font-inter">
                    Evaluación patrimonial inteligente con algoritmos de IA explicable.
                </p>
            </div>
            <div class="flex items-center gap-2 self-start sm:self-auto">
                <div id="currencyBadge" class="flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-xl text-xs font-semibold text-blue-700 dark:text-blue-300">
                    <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Divisa: <strong id="activeCurrencyDisplay">HNL</strong></span>
                </div>
                <a href="/historial" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition shadow-sm dark:bg-slate-800 dark:hover:bg-slate-700">
                    <span>Historial</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </a>
            </div>
        </div>

        <!-- Resumen de Transacciones Backend (Summary Cards) -->
        <section class="surface-card soft-lift rounded-3xl p-5 sm:p-6" aria-labelledby="summaryTitle">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 id="summaryTitle" class="text-base sm:text-lg font-bold text-gray-900 dark:text-white font-josefin">Resumen de Transacciones Persistidas</h2>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Consolidado en tiempo real desde el Backend con tus movimientos oficiales.</p>
                </div>
                <button id="retrySummaryBtn" type="button" class="hidden text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline cursor-pointer">Reintentar</button>
            </div>

            <div id="summaryContent" class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="metric-tile soft-lift rounded-2xl border border-emerald-100 bg-emerald-50 dark:border-emerald-900/60 dark:bg-emerald-950/40 p-4 text-emerald-800 dark:text-emerald-200">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">Ingresos del Mes</p>
                    <p id="summaryIncome" class="mt-1 text-xl font-black font-mono">0.00</p>
                </div>
                <div class="metric-tile soft-lift rounded-2xl border border-red-100 bg-red-50 dark:border-red-900/60 dark:bg-red-950/40 p-4 text-red-800 dark:text-red-200">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-red-700 dark:text-red-300">Gastos del Mes</p>
                    <p id="summaryExpenses" class="mt-1 text-xl font-black font-mono">0.00</p>
                </div>
                <div class="metric-tile soft-lift rounded-2xl border border-blue-100 bg-blue-50 dark:border-blue-900/60 dark:bg-blue-950/40 p-4 text-blue-800 dark:text-blue-200">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-blue-700 dark:text-blue-300">Balance del Mes</p>
                    <p id="summaryBalance" class="mt-1 text-xl font-black font-mono">0.00</p>
                </div>
            </div>
        </section>

        <!-- Main Layout: 2 Columns Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 items-start">

            <!-- Columna Izquierda: Entrada de Datos & Simulación (5 Columnas) -->
            <div class="lg:col-span-5 bg-white dark:bg-gray-900 rounded-3xl p-5 sm:p-6 shadow-sm border border-gray-200 dark:border-gray-800 space-y-4">
                <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                        <h2 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white font-josefin">Diagnóstico Financiero</h2>
                    </div>
                    <span id="periodBadge" class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-lg">Mensual</span>
                </div>

                <form id="financialAnalysisForm" class="space-y-4">
                    <!-- Ingreso Mensual -->
                    <div>
                        <label for="inputIngresoMensual" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">
                            Ingreso Total (<span class="currency-symbol">$</span>)
                        </label>
                        <input type="number" step="0.01" min="1" id="inputIngresoMensual" required value="25000" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white font-mono" placeholder="Ej. 25000" />
                    </div>

                    <!-- Frecuencia de Ahorro & Nivel Endeudamiento -->
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label for="selectFrecuencia" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Frecuencia</label>
                            <select id="selectFrecuencia" class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white font-semibold">
                                <option value="Mensual" selected>Mensual</option>
                                <option value="Quincenal">Quincenal</option>
                                <option value="Semanal">Semanal</option>
                            </select>
                        </div>
                        <div>
                            <label for="inputEndeudamiento" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Endeudamiento (%)</label>
                            <input type="number" step="0.1" min="0" max="100" id="inputEndeudamiento" required value="20" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white font-mono" placeholder="20%" />
                        </div>
                    </div>

                    <!-- Movimientos de Ejemplo para el Motor de IA -->
                    <div class="pt-2">
                        <div class="flex justify-between items-center mb-2">
                            <label class="block text-xs font-bold text-gray-700 dark:text-gray-300">Movimientos / Conceptos Representativos</label>
                            <span class="text-[11px] text-gray-400">4 elementos</span>
                        </div>
                        <div class="space-y-2 text-xs">
                            <div class="flex gap-2">
                                <input type="text" value="Alquiler de vivienda" class="flex-1 px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white tx-desc" />
                                <input type="number" value="6500" class="w-24 px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-mono tx-val" />
                            </div>
                            <div class="flex gap-2">
                                <input type="text" value="Supermercado y despensa" class="flex-1 px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white tx-desc" />
                                <input type="number" value="4000" class="w-24 px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-mono tx-val" />
                            </div>
                            <div class="flex gap-2">
                                <input type="text" value="Servicios de luz e internet" class="flex-1 px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white tx-desc" />
                                <input type="number" value="1800" class="w-24 px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-mono tx-val" />
                            </div>
                            <div class="flex gap-2">
                                <input type="text" value="Combustible y transporte" class="flex-1 px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white tx-desc" />
                                <input type="number" value="1500" class="w-24 px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-mono tx-val" />
                            </div>
                        </div>
                    </div>

                    <!-- Botón de Análisis -->
                    <button id="btnRunAnalysis" type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition shadow-md shadow-blue-600/20 text-sm flex items-center justify-center gap-2 cursor-pointer">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                        <span>Calcular Salud Financiera con IA</span>
                    </button>
                </form>
            </div>

            <!-- Columna Derecha: Diagnóstico con IA & Recomendaciones (7 Columnas) -->
            <div class="lg:col-span-7 bg-white dark:bg-gray-900 rounded-3xl p-5 sm:p-6 shadow-sm border border-gray-200 dark:border-gray-800 space-y-5">
                <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
                    <div>
                        <h3 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white font-josefin">Resultados del Modelo de IA</h3>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Diagnóstico explicable XAI y clasificación multidimensional</p>
                    </div>
                    <span id="analysisProfileBadge" class="text-xs font-bold px-3 py-1 bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 rounded-full border border-emerald-300 dark:border-emerald-800">
                        Excelente
                    </span>
                </div>

                <!-- Score Meter Circle -->
                <div class="flex flex-col sm:flex-row items-center gap-6 p-4 bg-gray-50 dark:bg-gray-800/50 rounded-2xl border border-gray-100 dark:border-gray-800">
                    <div class="relative w-28 h-28 flex items-center justify-center rounded-full border-[6px] border-emerald-500 shadow-sm flex-shrink-0" id="circleScoreIndicator">
                        <div class="text-center">
                            <span class="text-3xl font-black text-gray-900 dark:text-white font-mono" id="scoreValueDisplay">88</span>
                            <span class="text-[9px] text-gray-400 font-bold block -mt-1 uppercase">Puntos</span>
                        </div>
                    </div>
                    <div class="space-y-1.5 text-center sm:text-left">
                        <h4 class="text-sm font-bold text-gray-900 dark:text-white font-josefin" id="scoreTitle">Perfil Financiero Óptimo</h4>
                        <p class="text-xs text-gray-600 dark:text-gray-300 leading-relaxed" id="scoreDescription">
                            Tus ingresos cubren con holgura los gastos y el nivel de endeudamiento está por debajo de los umbrales de riesgo.
                        </p>
                    </div>
                </div>

                <!-- Key Ratios -->
                <div class="grid grid-cols-3 gap-2.5 text-center">
                    <div class="p-3 bg-gray-50 dark:bg-gray-800/40 rounded-xl border border-gray-100 dark:border-gray-800">
                        <p class="text-[9px] uppercase font-bold text-gray-400">Gasto / Ingreso</p>
                        <p id="ratioGastoIngreso" class="text-sm sm:text-base font-bold text-gray-900 dark:text-white font-mono mt-0.5">55.2%</p>
                    </div>
                    <div class="p-3 bg-gray-50 dark:bg-gray-800/40 rounded-xl border border-gray-100 dark:border-gray-800">
                        <p class="text-[9px] uppercase font-bold text-gray-400">Tasa de Ahorro</p>
                        <p id="ratioAhorro" class="text-sm sm:text-base font-bold text-emerald-600 dark:text-emerald-400 font-mono mt-0.5">44.8%</p>
                    </div>
                    <div class="p-3 bg-gray-50 dark:bg-gray-800/40 rounded-xl border border-gray-100 dark:border-gray-800">
                        <p class="text-[9px] uppercase font-bold text-gray-400">Endeudamiento</p>
                        <p id="ratioEndeudamiento" class="text-sm sm:text-base font-bold text-blue-600 dark:text-blue-400 font-mono mt-0.5">20.0%</p>
                    </div>
                </div>

                <!-- AI Recommendations Section -->
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-2 flex items-center gap-1.5 font-josefin">
                        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
                        Recomendaciones Personalizadas de IA
                    </h4>
                    <ul id="recommendationsList" class="space-y-2 text-xs text-gray-600 dark:text-gray-300">
                        <li class="p-2.5 bg-blue-50/50 dark:bg-blue-950/30 rounded-xl border border-blue-100 dark:border-blue-900/40 flex items-start gap-2">
                            <span class="text-blue-600 dark:text-blue-400 font-bold">1.</span>
                            <span>Mantén un fondo para emergencias de al menos 3 a 6 meses de gastos fijos.</span>
                        </li>
                        <li class="p-2.5 bg-emerald-50/50 dark:bg-emerald-950/30 rounded-xl border border-emerald-100 dark:border-emerald-900/40 flex items-start gap-2">
                            <span class="text-emerald-600 dark:text-emerald-400 font-bold">2.</span>
                            <span>Excelente disciplina de ahorro: considera canalizar el excedente a instrumentos de inversión seguros.</span>
                        </li>
                    </ul>
                </div>

                <!-- Action Footer -->
                <div class="pt-3 border-t border-gray-100 dark:border-gray-800 flex flex-col sm:flex-row gap-2.5 justify-between">
                    <button type="button" id="btnExportDashboardPdf" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5 shadow-sm shadow-emerald-600/20 cursor-pointer">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        Exportar Expediente PDF
                    </button>
                    <a href="/historial" class="px-4 py-2.5 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl text-xs font-bold transition text-center">
                        Ver Historial Completo &rarr;
                    </a>
                </div>
            </div>

        </div>
    </div>
</Layout>

<script define:vars={{ API_URL }}>
    (function () {
        const token = localStorage.getItem('financeai_token');
        let currentCurrency = localStorage.getItem('financeai_preferred_currency') || 'HNL';

        // ─── Inicializar Usuario ───
        const userRaw = localStorage.getItem('financeai_user');
        if (userRaw) {
            try {
                const u = JSON.parse(userRaw);
                const userNameDisplay = document.getElementById('dashboardUserNameHeader');
                if (userNameDisplay && u.nombre) {
                    userNameDisplay.textContent = u.nombre.split(' ')[0];
                }
            } catch {}
        }

        // ─── Sincronizar Divisa ───
        function updateCurrencyUI(cur) {
            currentCurrency = cur;
            const curBadge = document.getElementById('activeCurrencyDisplay');
            if (curBadge) curBadge.textContent = cur;
            const symbols = document.querySelectorAll('.currency-symbol');
            const sym = cur === 'HNL' ? 'L' : (cur === 'EUR' ? '€' : '$');
            symbols.forEach(s => s.textContent = sym);
        }
        updateCurrencyUI(currentCurrency);

        window.addEventListener('currency-changed', (e) => {
            if (e.detail?.currency) updateCurrencyUI(e.detail.currency);
        });

        // ─── Cargar Resumen del Backend ───
        async function loadSummary() {
            if (!token) return;
            const retryBtn = document.getElementById('retrySummaryBtn');
            try {
                const res = await fetch(`${API_URL}/api/v1/dashboard/summary`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    const income = Number(data.totalIngresos || data.income || 0);
                    const expense = Number(data.totalGastos || data.expenses || 0);
                    const balance = income - expense;

                    const sym = currentCurrency === 'HNL' ? 'L' : (currentCurrency === 'EUR' ? '€' : '$');
                    const fmt = (n) => `${sym} ${n.toLocaleString('es-HN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

                    const elInc = document.getElementById('summaryIncome');
                    const elExp = document.getElementById('summaryExpenses');
                    const elBal = document.getElementById('summaryBalance');

                    if (elInc) elInc.textContent = fmt(income);
                    if (elExp) elExp.textContent = fmt(expense);
                    if (elBal) elBal.textContent = fmt(balance);
                    if (retryBtn) retryBtn.classList.add('hidden');
                } else {
                    throw new Error();
                }
            } catch {
                if (retryBtn) retryBtn.classList.remove('hidden');
            }
        }
        loadSummary();
        document.getElementById('retrySummaryBtn')?.addEventListener('click', loadSummary);

        // ─── Ejecutar Análisis con IA (Backend Data Science) ───
        const analysisForm = document.getElementById('financialAnalysisForm');
        const btnRun = document.getElementById('btnRunAnalysis');

        analysisForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!token) return;

            const ingreso = Number(document.getElementById('inputIngresoMensual')?.value) || 25000;
            const endeudamiento = Number(document.getElementById('inputEndeudamiento')?.value) || 20;
            const frecuencia = document.getElementById('selectFrecuencia')?.value || 'Mensual';

            const txDesc = document.querySelectorAll('.tx-desc');
            const txVal = document.querySelectorAll('.tx-val');
            const transacciones = [];

            txDesc.forEach((descInput, i) => {
                const val = Number(txVal[i]?.value) || 0;
                const desc = descInput.value.trim() || `Gasto ${i + 1}`;
                transacciones.push({ descripcion: desc, valor: val });
            });

            if (btnRun) {
                btnRun.disabled = true;
                btnRun.innerHTML = '<span>Calculando con IA…</span>';
            }

            try {
                const payload = {
                    ingreso_mensual: ingreso,
                    nivel_endeudamiento: endeudamiento,
                    frecuencia_ahorro: frecuencia,
                    transacciones: transacciones
                };

                const res = await fetch(`${API_URL}/api/v1/analisis-financiero`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    const result = await res.json();
                    renderDiagnosis(result, ingreso, endeudamiento, transacciones);
                    if (window.showToast) window.showToast('Diagnóstico Actualizado', 'Análisis de salud financiera completado con éxito.', '🧠');
                } else {
                    throw new Error();
                }
            } catch {
                // Cálculo de respaldo inteligente
                const totalGastos = transacciones.reduce((acc, t) => acc + t.valor, 0);
                const ratioGasto = ingreso > 0 ? (totalGastos / ingreso) * 100 : 50;
                const score = Math.max(10, Math.min(100, Math.round(100 - (ratioGasto * 0.5) - (endeudamiento * 0.5))));
                renderDiagnosis({ score: score, level: score >= 75 ? 'Excelente' : (score >= 45 ? 'Moderado' : 'En riesgo') }, ingreso, endeudamiento, transacciones);
                if (window.showToast) window.showToast('Diagnóstico Generado', 'Evaluación financiera calculada con tus ratios.', '💡');
            } finally {
                if (btnRun) {
                    btnRun.disabled = false;
                    btnRun.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg><span>Calcular Salud Financiera con IA</span>';
                }
            }
        });

        function renderDiagnosis(data, ingreso, endeudamiento, transacciones) {
            const score = (data.score !== undefined && data.score !== null)
                ? data.score
                : (data.score_financiero || (data.probabilidad ? Math.round(data.probabilidad * 100) : 75));
            const perfil = data.level || (score >= 75 ? 'Excelente' : (score >= 45 ? 'Moderado' : 'En riesgo'));

            const scoreDisplay = document.getElementById('scoreValueDisplay');
            const profileBadge = document.getElementById('analysisProfileBadge');
            const circle = document.getElementById('circleScoreIndicator');
            const scoreTitle = document.getElementById('scoreTitle');
            const scoreDesc = document.getElementById('scoreDescription');

            if (scoreDisplay) scoreDisplay.textContent = score;
            if (profileBadge) profileBadge.textContent = perfil;

            if (score >= 75) {
                if (profileBadge) profileBadge.className = 'text-xs font-bold px-3 py-1 bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 rounded-full border border-emerald-300 dark:border-emerald-800';
                if (circle) circle.className = 'relative w-28 h-28 flex items-center justify-center rounded-full border-[6px] border-emerald-500 shadow-sm flex-shrink-0';
                if (scoreTitle) scoreTitle.textContent = 'Salud Financiera Óptima';
                if (scoreDesc) scoreDesc.textContent = 'Excelente control de gastos y bajo nivel de endeudamiento. Capacidad alta de ahorro.';
            } else if (score >= 45) {
                if (profileBadge) profileBadge.className = 'text-xs font-bold px-3 py-1 bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300 rounded-full border border-amber-300 dark:border-amber-800';
                if (circle) circle.className = 'relative w-28 h-28 flex items-center justify-center rounded-full border-[6px] border-amber-500 shadow-sm flex-shrink-0';
                if (scoreTitle) scoreTitle.textContent = 'Salud Financiera Moderada';
                if (scoreDesc) scoreDesc.textContent = 'Tus gastos o compromisos de deuda consumen una porción considerable de tus ingresos.';
            } else {
                if (profileBadge) profileBadge.className = 'text-xs font-bold px-3 py-1 bg-red-100 dark:bg-red-950 text-red-700 dark:text-red-300 rounded-full border border-red-300 dark:border-red-800';
                if (circle) circle.className = 'relative w-28 h-28 flex items-center justify-center rounded-full border-[6px] border-red-500 shadow-sm flex-shrink-0';
                if (scoreTitle) scoreTitle.textContent = 'Salud Financiera en Riesgo';
                if (scoreDesc) scoreDesc.textContent = 'Alerta de sobreendeudamiento o exceso de gastos fijos. Se recomienda ajuste inmediato.';
            }

            const totalGastos = transacciones.reduce((acc, t) => acc + t.valor, 0);
            const ratioGI = ingreso > 0 ? ((totalGastos / ingreso) * 100).toFixed(1) : '0';
            const ratioAh = ingreso > 0 ? (Math.max(0, 100 - Number(ratioGI) - endeudamiento)).toFixed(1) : '0';

            const elGI = document.getElementById('ratioGastoIngreso');
            const elAh = document.getElementById('ratioAhorro');
            const elEnd = document.getElementById('ratioEndeudamiento');

            if (elGI) elGI.textContent = `${ratioGI}%`;
            if (elAh) elAh.textContent = `${ratioAh}%`;
            if (elEnd) elEnd.textContent = `${endeudamiento}%`;
        }

        // ─── Exportar PDF desde Dashboard ───
        document.getElementById('btnExportDashboardPdf')?.addEventListener('click', async () => {
            if (window.showToast) window.showToast('Generando PDF', 'Compilando tu reporte oficial...', '📄');
            let transactions = [];
            if (token) {
                try {
                    const res = await fetch(`${API_URL}/api/v1/dashboard/summary`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    if (res.ok) {
                        const summary = await res.json();
                        transactions = summary.transacciones || [];
                    }
                } catch {}
            }

            let uName = 'Usuario FinanceAI';
            let uEmail = 'usuario@financeai.test';
            try {
                const u = JSON.parse(localStorage.getItem('financeai_user') || '{}');
                if (u.nombre) uName = u.nombre;
                if (u.email) uEmail = u.email;
            } catch {}

            if (typeof window.generateExpedientePDF === 'function') {
                window.generateExpedientePDF({
                    userName: uName,
                    userEmail: uEmail,
                    currencyCode: currentCurrency,
                    transactions
                });
            }
        });
    })();
</script>
