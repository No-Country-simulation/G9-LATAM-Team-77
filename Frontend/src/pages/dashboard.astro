---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
const hasServerSession = !!session;
const initialUserName = session?.user?.name ? `, ${session.user.name}` : '';
---

<Layout title="Dashboard de Análisis | FinanceAI" description="Panel principal de análisis de salud financiera con IA explicable (Motor DS-08), cálculo de ratios adimensionales y simulador presupuestal.">
    <!-- Guardia de Protección de Ruta Seguro -->
    <script define:vars={{ hasServerSession }}>
        if (!hasServerSession && !localStorage.getItem('financeai_token')) {
            window.location.replace('/login');
        }
        window.addEventListener('pageshow', function(e) {
            if (e.persisted && !hasServerSession && !localStorage.getItem('financeai_token')) {
                window.location.replace('/login');
            }
        });
    </script>

    <div class="w-full max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6 md:py-8 flex flex-col gap-4 sm:gap-6 font-inter">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-gray-200 dark:border-gray-800 pb-4">
            <div class="space-y-0.5 sm:space-y-1">
                <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-gray-900 dark:text-white font-josefin leading-snug">
                    <span>Bienvenido, </span><span id="dashboardUserNameHeader" class="text-blue-600 dark:text-blue-400 font-extrabold">{initialUserName ? initialUserName.replace(/^,\s*/, '') : 'Usuario'}</span>
                </h1>
                <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 font-inter">
                    Evaluación inteligente con IA.
                </p>
            </div>
            <div id="currencyBadge" class="flex items-center gap-2 px-3 sm:px-3.5 py-1.5 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-xl text-xs font-semibold text-blue-700 dark:text-blue-300 self-start sm:self-auto">
                <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Moneda: <strong id="activeCurrencyDisplay">USD</strong></span>
            </div>
        </div>

        <!-- BANNER SUPERIOR: TOTAL AHORRADO / BALANCE NETO (ESTILO HISTORIAL) CON MENÚ DESPLEGABLE -->
        <section class="bg-white dark:bg-gray-900 p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 animate-fade-in">
            <!-- Izquierda: Icono + Balance Neto / Total Ahorrado -->
            <div class="flex items-center gap-3.5 sm:gap-4">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] sm:text-xs text-gray-500 font-semibold uppercase tracking-wider">Total Ahorrado / Balance</span>
                        <span id="topAhorroTag" class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 animate-pulse">En tiempo real</span>
                    </div>
                    <div class="flex items-center gap-2.5 mt-0.5">
                        <h3 id="statTotalAhorradoTop" class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white font-mono tracking-tight">$0 USD</h3>
                        <button type="button" id="btnToggleCensorTop" class="p-1 rounded-lg text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 transition cursor-pointer" title="Censurar / Mostrar saldo">
                            <svg id="iconEyeTopClosed" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/></svg>
                            <svg id="iconEyeTopOpen" class="w-4 h-4 block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        </button>
                    </div>
                    <p id="topAhorroSubtext" class="text-[10px] text-gray-400 dark:text-gray-500">Ahorro neto calculado (Ingresos − Gastos)</p>
                </div>
            </div>

            <!-- Derecha: Menú Desplegable con opciones de filtro / vista -->
            <div class="flex items-center gap-2 self-start sm:self-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-gray-100 dark:border-gray-800 w-full sm:w-auto justify-between sm:justify-end">
                <label for="selectTopAhorroView" class="text-xs font-semibold text-gray-500 dark:text-gray-400 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                    <span>Filtro de Ahorro:</span>
                </label>
                <select id="selectTopAhorroView" class="px-3 py-2 text-xs font-semibold bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white focus:ring-2 focus:ring-blue-500 outline-none cursor-pointer shadow-sm">
                    <option value="evaluacion" selected>📊 Período Actual de Evaluación</option>
                    <option value="mensual">📅 Proyección Mensual</option>
                    <option value="anual">📈 Proyección Anual (12 Meses)</option>
                    <option value="historico">🏛️ Saldo Total Acumulado (Histórico)</option>
                </select>
            </div>
        </section>

        <!-- Main Layout: 2 Columns Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 items-start">
            
            <!-- Columna Izquierda: Entrada de Datos & Configuración de Período (5 Columnas) -->
            <div class="lg:col-span-5 bg-white dark:bg-gray-900 rounded-2xl sm:rounded-3xl p-4 sm:p-6 shadow-sm border border-gray-200 dark:border-gray-800 space-y-4 sm:space-y-5">
                <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                        <h2 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white font-josefin">Datos Financieros</h2>
                    </div>
                    <span id="periodBadge" class="text-[11px] font-bold px-2.5 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-lg">Mensual</span>
                </div>

                <!-- Selector de Periodicidad y Ventana de Fechas (Historial de 2 años atrás hasta hoy) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-1">
                            Frecuencia
                        </label>
                        <select id="selectPeriodicity" class="w-full px-3 py-2 text-xs bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl font-semibold dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="mensual" selected>Mensual</option>
                            <option value="quincenal">Quincenal</option>
                            <option value="semanal">Semanal</option>
                            <option value="diario">Diario</option>
                        </select>
                    </div>

                    <div class="relative">
                        <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-1">
                            Período a evaluar
                        </label>
                        <!-- Trigger del Calendario Personalizado -->
                        <button type="button" id="btnCustomSubPeriodTrigger" class="w-full flex items-center justify-between px-3 py-2 text-xs bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl font-semibold dark:text-white text-left focus:outline-none focus:ring-2 focus:ring-blue-500 transition cursor-pointer">
                            <span id="customSubPeriodDisplay" class="truncate">Agosto 2026</span>
                            <svg class="w-4 h-4 text-blue-500 flex-shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </button>

                        <!-- Popover Desplegable con Calendario Personalizado Glassmorphic -->
                        <div id="customSubPeriodDropdown" class="hidden absolute top-full left-0 mt-2 z-50 w-72 sm:w-80 max-w-[calc(100vw-32px)] bg-white dark:bg-gray-900/95 backdrop-blur-2xl border border-gray-200 dark:border-gray-700 shadow-2xl rounded-2xl p-3.5 animate-scale-in">
                            
                            <!-- 1. VISTA MENSUAL: Cuadrícula de 12 Meses (Sin números de días) -->
                            <div id="dashCalMonthlyView">
                                <div class="flex items-center justify-between pb-2 border-b border-gray-100 dark:border-gray-800 mb-2.5">
                                    <button type="button" id="btnDashPrevYear" class="p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition cursor-pointer" title="Año anterior">&lt;</button>
                                    <span id="dashYearLabel" class="font-bold text-sm text-gray-900 dark:text-white font-josefin">2026</span>
                                    <button type="button" id="btnDashNextYear" class="p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition cursor-pointer" title="Año siguiente">&gt;</button>
                                </div>
                                <div class="mb-2 text-[10px] text-center text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 py-1 px-2 rounded-lg font-medium">
                                    Selecciona el mes a evaluar
                                </div>
                                <div class="grid grid-cols-3 gap-1.5" id="dashMonthsGrid">
                                    <!-- 12 Tiles de meses -->
                                </div>
                            </div>

                            <!-- 2. VISTA DÍAS: Cuadrícula con Días (Para Quincenal, Semanal y Diario) -->
                            <div id="dashCalDaysView" class="hidden">
                                <!-- Header de Navegación de Mes y Año -->
                                <div class="flex items-center justify-between pb-2 border-b border-gray-100 dark:border-gray-800 mb-2.5">
                                    <button type="button" id="btnDashPrevMonth" class="p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition cursor-pointer" title="Mes anterior">&lt;</button>
                                    <div class="flex items-center gap-1.5 font-bold text-xs text-gray-900 dark:text-white font-josefin">
                                        <span id="dashCalMonthLabel">Agosto</span>
                                        <span id="dashCalYearLabel">2026</span>
                                    </div>
                                    <button type="button" id="btnDashNextMonth" class="p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition cursor-pointer" title="Mes siguiente">&gt;</button>
                                </div>

                                <!-- Banner contextual según la frecuencia seleccionada -->
                                <div id="dashCalContextBanner" class="mb-2 text-[10px] text-center text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 py-1 px-2 rounded-lg font-medium">
                                    Haz clic en cualquier día para seleccionar el período
                                </div>

                                <!-- Botones de Quincena (Solo visibles en modo Quincenal) -->
                                <div id="dashCalQuincenaButtons" class="hidden grid grid-cols-2 gap-1.5 mb-2">
                                    <button type="button" id="btnQ1" class="py-1.5 px-2 text-[10px] font-bold rounded-lg transition-all border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 cursor-pointer">1ra Quincena (1-15)</button>
                                    <button type="button" id="btnQ2" class="py-1.5 px-2 text-[10px] font-bold rounded-lg transition-all border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 cursor-pointer">2da Quincena (16-Fin)</button>
                                </div>

                                <!-- Cabecera de Días de la Semana -->
                                <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-bold text-gray-400 uppercase mb-1">
                                    <span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
                                </div>

                                <!-- Cuadrícula Dinámica de Días del Calendario (1 a 31) -->
                                <div class="grid grid-cols-7 gap-1 text-center" id="dashCalDaysGrid">
                                    <!-- Días generados dinámicamente -->
                                </div>
                            </div>
                        </div>

                        <!-- Select oculto para mantener compatibilidad total -->
                        <select id="selectSubPeriod" class="hidden"></select>
                    </div>
                </div>

                <!-- Rango de Fechas Permitido (Sin permitir fechas futuras) -->
                <div class="p-2.5 bg-blue-50/60 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/40 rounded-xl text-[11px] text-blue-700 dark:text-blue-300 flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span>Límite de fechas:</span>
                    </div>
                    <strong id="dateRangeNotice" class="font-mono text-xs">-- al --</strong>
                </div>

                <!-- Ingreso del Período -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-1.5">
                        Ingreso del Período (<span class="currencySymbol">$</span>)
                    </label>
                    <input type="number" id="ingreso" value="4500" required min="1"
                        class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-800 text-sm text-gray-900 dark:text-white font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                </div>

                <!-- Lista de Transacciones -->
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide">
                            Transacciones (<span id="txCount">2 agregadas</span>)
                        </label>
                    </div>

                    <div id="txList" class="space-y-2.5 max-h-[280px] overflow-y-auto pr-1">
                        <!-- Transacciones renderizadas dinámicamente -->
                    </div>

                    <!-- Botón Agregar Transacción -->
                    <button type="button" id="btnAddTx"
                        class="w-full mt-3 py-2.5 border-2 border-dashed border-gray-300 dark:border-gray-700 hover:border-blue-500 rounded-xl text-xs font-semibold text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center justify-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        Agregar Transacción
                    </button>
                </div>

                <!-- Botón Ejecutar Análisis -->
                <button type="button" id="btnAnalizar"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3.5 px-4 rounded-2xl transition shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    Ejecutar Análisis con IA
                </button>
            </div>

            <!-- Columna Derecha: Salud Financiera, Consejos IA y Explicabilidad DS-08 (7 Columnas) -->
            <div class="lg:col-span-7 space-y-5 sm:space-y-6">
                
                <!-- Score de Salud Financiera & Métricas Clave -->
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-5 bg-white dark:bg-gray-900 rounded-2xl sm:rounded-3xl p-4 sm:p-6 shadow-sm border border-gray-200 dark:border-gray-800 items-center">
                    
                    <!-- Gauge Score (5 Cols) -->
                    <div class="sm:col-span-5 flex flex-col items-center justify-center text-center border-b sm:border-b-0 sm:border-r border-gray-100 dark:border-gray-800 pb-4 sm:pb-0 sm:pr-4">
                        <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-gray-400 mb-2">SALUD FINANCIERA</span>
                        <div class="relative w-28 h-28 sm:w-32 sm:h-32 flex items-center justify-center">
                            <svg class="w-28 h-28 sm:w-32 sm:h-32 transform -rotate-90" viewBox="0 0 120 120">
                                <circle cx="60" cy="60" r="50" class="stroke-gray-100 dark:stroke-gray-800" stroke-width="10" fill="none" />
                                <circle id="scoreRing" cx="60" cy="60" r="50" stroke="currentColor" stroke-width="10" fill="none"
                                    stroke-dasharray="314.159" stroke-dashoffset="314.159" stroke-linecap="round"
                                    class="text-gray-400 transition-all duration-1000 ease-out" />
                            </svg>
                            <div class="absolute inset-0 flex flex-col items-center justify-center">
                                <span id="scoreText" class="text-2xl sm:text-3xl font-black text-gray-900 dark:text-white">--</span>
                                <span class="text-[9px] sm:text-[10px] text-gray-400">/ 100</span>
                            </div>
                        </div>
                        <div class="mt-2">
                            <span id="scoreBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gray-100 dark:bg-gray-800 text-gray-500">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/></svg>
                                <span id="scoreBadgeText">Sin analizar</span>
                            </span>
                        </div>
                    </div>

                    <!-- Resumen Métricas Clave (7 Cols) -->
                    <div class="sm:col-span-7 grid grid-cols-2 gap-2.5 sm:gap-3">
                        <!-- 1. Total Gastos -->
                        <div class="p-2.5 sm:p-3 bg-gray-50 dark:bg-gray-800/60 rounded-xl sm:rounded-2xl border border-gray-100 dark:border-gray-700/50">
                            <span class="text-[10px] font-semibold text-gray-400 uppercase">Total Gastos</span>
                            <div id="statGastos" class="text-base sm:text-lg font-bold text-gray-900 dark:text-white mt-0.5">$0</div>
                        </div>

                        <!-- 2. Ahorro Est. -->
                        <div class="p-2.5 sm:p-3 bg-emerald-50 dark:bg-emerald-950/30 rounded-xl sm:rounded-2xl border border-emerald-100 dark:border-emerald-900/40">
                            <span class="text-[10px] font-semibold text-emerald-600 dark:text-emerald-400 uppercase">Ahorro Est.</span>
                            <div id="statAhorroEst" class="text-base sm:text-lg font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">$0</div>
                        </div>

                        <!-- 3. Endeudamiento -->
                        <div class="p-2.5 sm:p-3 bg-amber-50 dark:bg-amber-950/30 rounded-xl sm:rounded-2xl border border-amber-100 dark:border-amber-900/40" title="Porcentaje de ingresos comprometido en deudas fijas o créditos">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-semibold text-amber-600 dark:text-amber-400 uppercase">Endeudamiento</span>
                                <span id="statDeudaSub" class="text-[9px] text-amber-600/80 dark:text-amber-400/80">Pasivos</span>
                            </div>
                            <div id="statDeuda" class="text-base sm:text-lg font-bold text-amber-600 dark:text-amber-400 mt-0.5">0%</div>
                            <p id="statDeudaNote" class="text-[9px] text-gray-500 dark:text-gray-400 truncate mt-0.5">Sin deudas fijas</p>
                        </div>

                        <!-- 4. Frec. Ahorro -->
                        <div class="p-2.5 sm:p-3 bg-blue-50 dark:bg-blue-950/30 rounded-xl sm:rounded-2xl border border-blue-100 dark:border-blue-900/40">
                            <span class="text-[10px] font-semibold text-blue-600 dark:text-blue-400 uppercase">Frec. Ahorro</span>
                            <div id="statFrecuencia" class="text-base sm:text-lg font-bold text-blue-600 dark:text-blue-400 mt-0.5 truncate">Automática</div>
                        </div>
                    </div>
                </div>

                <!-- Panel de Consejos de IA y Explicabilidad DS-08 -->
                <div id="ds08Container" class="bg-white dark:bg-gray-900 rounded-2xl sm:rounded-3xl p-4 sm:p-6 shadow-sm border border-gray-200 dark:border-gray-800 space-y-4 sm:space-y-5 animate-fade-in">
                    
                    <div class="flex flex-col xs:flex-row items-start xs:items-center justify-between pb-3 border-b border-gray-100 dark:border-gray-800 gap-2">
                        <div class="flex items-center gap-2 sm:gap-2.5">
                            <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
