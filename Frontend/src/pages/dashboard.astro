---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
const hasServerSession = !!session;
---

<Layout title="Dashboard de Análisis | FinanceAI">
    <!-- Guardia de Protección de Ruta Seguro -->
    <script define:vars={{ hasServerSession }}>
        if (!hasServerSession && !localStorage.getItem('financeai_token')) {
            window.location.replace('/login');
        }
    </script>

    <!-- Chart.js CDN -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <div class="w-full max-w-7xl mx-auto px-4 py-6 md:py-8 flex flex-col gap-6 font-inter">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-gray-200 dark:border-gray-800 pb-4">
            <div>
                <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white font-josefin">
                    Dashboard de Análisis
                </h1>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                    Evaluación inteligente con IA.
                </p>
            </div>
            <div id="currencyBadge" class="flex items-center gap-2 px-3.5 py-1.5 bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-xl text-xs font-semibold text-blue-700 dark:text-blue-300">
                <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Moneda: <strong id="activeCurrencyDisplay">USD</strong></span>
            </div>
        </div>

        <!-- Main Layout: 2 Columns Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            
            <!-- Columna Izquierda: Entrada de Datos & Configuración de Período (5 Columnas) -->
            <div class="lg:col-span-5 bg-white dark:bg-gray-900 rounded-3xl p-6 shadow-sm border border-gray-200 dark:border-gray-800 space-y-5">
                <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-800 pb-3">
                    <div class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                        <h2 class="text-lg font-bold text-gray-900 dark:text-white font-josefin">Datos Financieros</h2>
                    </div>
                    <span id="periodBadge" class="text-[11px] font-bold px-2.5 py-0.5 bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 rounded-lg">Mensual</span>
                </div>

                <!-- Selector de Periodicidad y Ventana de Fechas (Historial de 2 años atrás hasta hoy) -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-1">
                            Periodicidad
                        </label>
                        <select id="selectPeriodicity" class="w-full px-3 py-2 text-xs bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl font-semibold dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="mensual" selected>Mensual (Mes)</option>
                            <option value="quincenal">Quincenal (15 Días)</option>
                            <option value="semanal">Semanal (7 Días)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-1">
                            Tramo del Período
                        </label>
                        <select id="selectSubPeriod" class="w-full px-3 py-2 text-xs bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl font-semibold dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <!-- Opciones dinámicas de los últimos 24 meses generadas con JS -->
                        </select>
                    </div>
                </div>

                <!-- Rango de Fechas Permitido (Sin permitir fechas futuras) -->
                <div class="p-2.5 bg-blue-50/60 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/40 rounded-xl text-[11px] text-blue-700 dark:text-blue-300 flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        <span>Límite de fechas:</span>
                    </div>
                    <strong id="dateRangeNotice" class="font-mono text-xs">-- al --</strong>
                </div>

                <!-- Ingreso del Período -->
                <div>
                    <label class="block text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide mb-1.5">
                        Ingreso del Período (<span class="currencySymbol">$</span>)
                    </label>
                    <input type="number" id="ingreso" value="4500" required min="1"
                        class="w-full px-4 py-2.5 border border-gray-200 dark:border-gray-700 rounded-xl bg-gray-50 dark:bg-gray-800 text-sm text-gray-900 dark:text-white font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
                </div>

                <!-- Lista de Transacciones -->
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label class="text-xs font-semibold text-gray-600 dark:text-gray-400 uppercase tracking-wide">
                            Transacciones (<span id="txCount">2 agregadas</span>)
                        </label>
                    </div>

                    <div id="txList" class="space-y-2.5 max-h-[280px] overflow-y-auto pr-1">
                        <!-- Transacciones renderizadas dinámicamente -->
                    </div>

                    <!-- Botón Agregar Transacción -->
                    <button type="button" id="btnAddTx"
                        class="w-full mt-3 py-2.5 border-2 border-dashed border-gray-300 dark:border-gray-700 hover:border-blue-500 rounded-xl text-xs font-semibold text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition flex items-center justify-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                        </svg>
                        Agregar Transacción
                    </button>
                </div>

                <!-- Botón Ejecutar Análisis -->
                <button type="button" id="btnAnalizar"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3.5 px-4 rounded-2xl transition shadow-md hover:shadow-lg flex items-center justify-center gap-2 text-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                    Ejecutar Análisis con IA
                </button>
            </div>

            <!-- Columna Derecha: Salud Financiera, Consejos IA y Explicabilidad DS-08 (7 Columnas) -->
            <div class="lg:col-span-7 space-y-6">
                
                <!-- Score de Salud Financiera & Métricas Clave -->
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-5 bg-white dark:bg-gray-900 rounded-3xl p-6 shadow-sm border border-gray-200 dark:border-gray-800 items-center">
                    
                    <!-- Gauge Score (5 Cols) -->
                    <div class="sm:col-span-5 flex flex-col items-center justify-center text-center border-b sm:border-b-0 sm:border-r border-gray-100 dark:border-gray-800 pb-4 sm:pb-0 sm:pr-4">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400 mb-2">SALUD FINANCIERA</span>
                        <div class="relative w-32 h-32 flex items-center justify-center">
                            <svg class="w-32 h-32 transform -rotate-90" viewBox="0 0 120 120">
                                <circle cx="60" cy="60" r="50" class="stroke-gray-100 dark:stroke-gray-800" stroke-width="10" fill="none" />
                                <circle id="scoreRing" cx="60" cy="60" r="50" stroke="currentColor" stroke-width="10" fill="none"
                                    stroke-dasharray="314.159" stroke-dashoffset="314.159" stroke-linecap="round"
                                    class="text-gray-400 transition-all duration-1000 ease-out" />
                            </svg>
                            <div class="absolute inset-0 flex flex-col items-center justify-center">
                                <span id="scoreText" class="text-3xl font-black text-gray-900 dark:text-white">--</span>
                                <span class="text-[10px] text-gray-400">/ 100</span>
                            </div>
                        </div>
                        <div class="mt-2">
                            <span id="scoreBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-gray-100 dark:bg-gray-800 text-gray-500">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="2"/></svg>
                                <span id="scoreBadgeText">Sin analizar</span>
                            </span>
                        </div>
                    </div>

                    <!-- Resumen Métricas Clave (7 Cols) -->
                    <div class="sm:col-span-7 grid grid-cols-2 gap-3">
                        <div class="p-3 bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-100 dark:border-gray-700/50">
                            <span class="text-[10px] font-semibold text-gray-400 uppercase">Total Gastos</span>
                            <div id="statGastos" class="text-lg font-bold text-gray-900 dark:text-white mt-0.5">$0</div>
                        </div>
                        <div class="p-3 bg-emerald-50 dark:bg-emerald-950/30 rounded-2xl border border-emerald-100 dark:border-emerald-900/40">
                            <span class="text-[10px] font-semibold text-emerald-600 dark:text-emerald-400 uppercase">Ahorro Est.</span>
                            <div id="statAhorro" class="text-lg font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">$0</div>
                        </div>
                        <div class="p-3 bg-amber-50 dark:bg-amber-950/30 rounded-2xl border border-amber-100 dark:border-amber-900/40">
                            <span class="text-[10px] font-semibold text-amber-600 dark:text-amber-400 uppercase">Endeudamiento</span>
                            <div id="statDeuda" class="text-lg font-bold text-amber-600 dark:text-amber-400 mt-0.5">0%</div>
                        </div>
                        <div class="p-3 bg-blue-50 dark:bg-blue-950/30 rounded-2xl border border-blue-100 dark:border-blue-900/40">
                            <span class="text-[10px] font-semibold text-blue-600 dark:text-blue-400 uppercase">Frec. Ahorro</span>
                            <div id="statFrecuencia" class="text-lg font-bold text-blue-600 dark:text-blue-400 mt-0.5">Automática</div>
                        </div>
                    </div>
                </div>

                <!-- Panel de Consejos de IA y Explicabilidad DS-08 -->
                <div id="ds08Container" class="bg-white dark:bg-gray-900 rounded-3xl p-6 shadow-sm border border-gray-200 dark:border-gray-800 space-y-5 animate-fade-in">
                    
                    <div class="flex items-center justify-between pb-3 border-b border-gray-100 dark:border-gray-800">
                        <div class="flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-xl bg-blue-100 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                                </svg>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white font-josefin">Consejos y Recomendaciones de IA.</h3>
                        </div>
                        <span class="text-[11px] font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950/50 px-2.5 py-1 rounded-lg">Data Science Engine</span>
                    </div>

                    <!-- 3 Capas de Explicabilidad -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5">
                        
                        <!-- Capa 1: Diagnóstico -->
                        <div class="p-4 bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-200/60 dark:border-gray-700/50 space-y-1.5">
                            <div class="flex items-center gap-1.5 text-blue-600 dark:text-blue-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                <span class="text-[10px] font-bold uppercase tracking-wider">1. Diagnóstico</span>
                            </div>
                            <p id="capa1Text" class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed font-medium">
                                Haz clic en "Ejecutar Análisis con IA" para generar el diagnóstico oficial.
                            </p>
                        </div>

                        <!-- Capa 2: Causa Principal -->
                        <div class="p-4 bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-200/60 dark:border-gray-700/50 space-y-1.5">
                            <div class="flex items-center gap-1.5 text-amber-600 dark:text-amber-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                <span class="text-[10px] font-bold uppercase tracking-wider">2. Causa Raíz</span>
                            </div>
                            <p id="capa2Text" class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed font-medium">
                                Se identificará el pilar financiero con menor porcentaje relativo.
                            </p>
                        </div>

                        <!-- Capa 3: Acción Recomendada -->
                        <div class="p-4 bg-gray-50 dark:bg-gray-800/60 rounded-2xl border border-gray-200/60 dark:border-gray-700/50 space-y-1.5">
                            <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                                <span class="text-[10px] font-bold uppercase tracking-wider">3. Acción Directa</span>
                            </div>
                            <p id="capa3Text" class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed font-medium">
                                Plan de acción inmediato formulado por el modelo financiero.
                            </p>
                        </div>
                    </div>

                    <!-- Lista de Consejos y Alertas Financieras -->
                    <div>
                        <h4 class="text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-wide mb-2 flex items-center gap-1.5">
                            <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                            Consejos y Alertas Específicas
                        </h4>
                        <ul id="alertsList" class="space-y-2 text-xs">
                            <li class="p-3 bg-gray-50 dark:bg-gray-800/40 text-gray-500 dark:text-gray-400 rounded-xl border border-gray-200/50 dark:border-gray-700/40 flex items-start gap-2.5">
                                <svg class="w-4 h-4 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                <span>Ejecuta el análisis con IA para recibir sugerencias personalizadas por categorías y reglas 50/30/20.</span>
                            </li>
                        </ul>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- Modal para Completar Perfil de Google Auth con Todos los Países y Monedas -->
    <div id="completeProfileModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-gray-900/80 backdrop-blur-md">
        <div class="bg-white dark:bg-gray-900 w-full max-w-sm rounded-3xl p-8 shadow-2xl border border-gray-200 dark:border-gray-800 animate-scale-in">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 font-josefin">¡Completa tu Perfil!</h3>
            <p class="text-xs text-gray-500 dark:text-gray-400 mb-6 leading-relaxed">
                Detectamos tu cuenta de Google. Selecciona tu país y moneda base para personalizar tus análisis financieros.
            </p>
            
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">País</label>
                    <select id="modalPaisId" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
                        <option value="1">Costa Rica</option>
                        <option value="2">México</option>
                        <option value="3">Estados Unidos</option>
                        <option value="4">España</option>
                        <option value="5">Colombia</option>
                        <option value="6">Argentina</option>
                        <option value="7">Chile</option>
                        <option value="8">Perú</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Moneda</label>
                    <select id="modalMonedaId" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
                        <option value="1">CRC (₡) - Costa Rica</option>
                        <option value="2">MXN ($) - México</option>
                        <option value="3">USD ($) - EE.UU.</option>
                        <option value="4">EUR (€) - España/Europa</option>
                        <option value="5">COP ($) - Colombia</option>
                        <option value="6">ARS ($) - Argentina</option>
                        <option value="7">CLP ($) - Chile</option>
                        <option value="8">PEN (S/) - Perú</option>
                    </select>
                </div>
                <button id="btnSaveProfile" class="w-full mt-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition shadow-sm text-sm">
                    Guardar y Continuar
                </button>
            </div>
        </div>
    </div>
</Layout>

<script define:vars={{ API_URL, session }}>
    // Protección de ruta
    if (!session && !localStorage.getItem('financeai_token')) {
        window.location.href = '/login';
    }

    // Google Sync Trick
    if (session && !localStorage.getItem('financeai_token')) {
        fetch(`${API_URL}/api/v1/auth/google-sync`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                email: session.user?.email || "google@example.com",
                name: session.user?.name || "Usuario de Google"
            })
        }).then(res => res.json()).then(data => {
            if (data && data.token) {
                localStorage.setItem('financeai_token', data.token);
                localStorage.setItem('financeai_user', JSON.stringify(data));
                window.location.reload(); 
            }
        }).catch(err => console.error("Error en sincronizacion con Google:", err));
    }

    // Verificar perfil para pais/moneda
    const currentToken = localStorage.getItem('financeai_token');
    if (currentToken) {
        fetch(`${API_URL}/api/v1/users/profile`, {
            headers: { 'Authorization': `Bearer ${currentToken}` }
        }).then(res => res.json()).then(user => {
            if (!user.paisId || !user.monedaId) {
                document.getElementById('completeProfileModal')?.classList.remove('hidden');
                
                document.getElementById('btnSaveProfile')?.addEventListener('click', async () => {
                    const btn = document.getElementById('btnSaveProfile');
                    btn.disabled = true;
                    btn.textContent = 'Guardando...';
                    
                    const pId = parseInt(document.getElementById('modalPaisId').value);
                    const mId = parseInt(document.getElementById('modalMonedaId').value);
                    const currencyCodes = { 1: 'CRC', 2: 'MXN', 3: 'USD', 4: 'EUR', 5: 'COP', 6: 'ARS', 7: 'CLP', 8: 'PEN' };
                    localStorage.setItem('financeai_preferred_currency', currencyCodes[mId] || 'USD');

                    const updateRes = await fetch(`${API_URL}/api/v1/users/profile`, {
                        method: 'PUT',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${currentToken}`
                        },
                        body: JSON.stringify({ paisId: pId, monedaId: mId })
                    });
                    
                    if (updateRes.ok) {
                        window.location.reload();
                    } else {
                        btn.disabled = false;
                        btn.textContent = 'Error al guardar';
                    }
                });
            }
        }).catch(err => console.error("Error al obtener perfil", err));
    }

    // Moneda activa
    const activeCurrency = localStorage.getItem('financeai_preferred_currency') || 'USD';
    const activeCurrencyDisplay = document.getElementById('activeCurrencyDisplay');
    if (activeCurrencyDisplay) activeCurrencyDisplay.textContent = activeCurrency;
    document.querySelectorAll('.currencySymbol').forEach(el => el.textContent = activeCurrency);

    // 12 Categorías Oficiales (PR-02)
    const OFFICIAL_CATEGORIES = [
        "Vivienda",
        "Alimentación",
        "Transporte",
        "Servicios",
        "Salud y bienestar",
        "Educación",
        "Entretenimiento",
        "Compras",
        "Cuidado personal",
        "Regalos",
        "Viajes",
        "Otros"
    ];

    // ─── GESTIÓN DE PERIODICIDAD DINÁMICA (Últimos 24 meses hasta la fecha de hoy) ───
    const now = new Date();
    const todayISO = now.toISOString().slice(0, 10);
    
    let currentMinDate = todayISO.slice(0, 7) + "-01";
    let currentMaxDate = todayISO;

    const selectPeriodicity = document.getElementById('selectPeriodicity');
    const selectSubPeriod = document.getElementById('selectSubPeriod');
    const periodBadge = document.getElementById('periodBadge');
    const dateRangeNotice = document.getElementById('dateRangeNotice');

    const MONTH_NAMES = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

    function updateSubPeriods() {
        const periodicity = selectPeriodicity.value;
        periodBadge.textContent = periodicity.charAt(0).toUpperCase() + periodicity.slice(1);

        let optionsHTML = '';

        if (periodicity === 'mensual') {
            // Generar los últimos 24 meses hacia atrás
            for (let i = 0; i < 24; i++) {
                const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                const year = d.getFullYear();
                const month = d.getMonth();
                const mStr = String(month + 1).padStart(2, '0');
                
                const start = `${year}-${mStr}-01`;
                // Último día del mes o hoy si es el mes actual
                const lastDay = new Date(year, month + 1, 0).getDate();
                let end = `${year}-${mStr}-${String(lastDay).padStart(2, '0')}`;
                if (i === 0 && end > todayISO) {
                    end = todayISO;
                }

                const isSelected = i === 0 ? 'selected' : '';
                optionsHTML += `<option value="${start}|${end}" ${isSelected}>${MONTH_NAMES[month]} ${year}</option>`;
            }
        } else if (periodicity === 'quincenal') {
            // Generar quincenas de los últimos 24 meses
            for (let i = 0; i < 24; i++) {
                const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
                const year = d.getFullYear();
                const month = d.getMonth();
                const mStr = String(month + 1).padStart(2, '0');
                const lastDay = new Date(year, month + 1, 0).getDate();

                const q2Start = `${year}-${mStr}-16`;
                let q2End = `${year}-${mStr}-${String(lastDay).padStart(2, '0')}`;
                if (i === 0 && q2End > todayISO) q2End = todayISO;

                const q1Start = `${year}-${mStr}-01`;
                let q1End = `${year}-${mStr}-15`;
                if (i === 0 && q1End > todayISO) q1End = todayISO;

                // Solo agregar 2da quincena si la fecha actual ya llegó al día 16 o es mes pasado
                if (i > 0 || now.getDate() >= 16) {
                    const isSelected = i === 0 ? 'selected' : '';
                    optionsHTML += `<option value="${q2Start}|${q2End}" ${isSelected}>2da Quincena ${MONTH_NAMES[month].slice(0, 3)} ${year} (16-${q2End.slice(8)})</option>`;
                }
                const isSelectedQ1 = (i === 0 && now.getDate() < 16) ? 'selected' : '';
                optionsHTML += `<option value="${q1Start}|${q1End}" ${isSelectedQ1}>1ra Quincena ${MONTH_NAMES[month].slice(0, 3)} ${year} (01-${q1End.slice(8)})</option>`;
            }
        } else if (periodicity === 'semanal') {
            // Generar semanas hacia atrás
            for (let w = 0; w < 48; w++) {
                const dEnd = new Date(now.getFullYear(), now.getMonth(), now.getDate() - (w * 7));
                const dStart = new Date(dEnd.getFullYear(), dEnd.getMonth(), dEnd.getDate() - 6);
                
                const startStr = dStart.toISOString().slice(0, 10);
                let endStr = dEnd.toISOString().slice(0, 10);
                if (endStr > todayISO) endStr = todayISO;

                const isSelected = w === 0 ? 'selected' : '';
                optionsHTML += `<option value="${startStr}|${endStr}" ${isSelected}>Semana del ${startStr} al ${endStr}</option>`;
            }
        }

        selectSubPeriod.innerHTML = optionsHTML;
        applyDateBounds();
    }

    function applyDateBounds() {
        const parts = selectSubPeriod.value.split('|');
        currentMinDate = parts[0];
        currentMaxDate = parts[1];

        // Asegurar que no exceda nunca la fecha actual de la máquina
        if (currentMaxDate > todayISO) {
            currentMaxDate = todayISO;
        }

        dateRangeNotice.textContent = `${currentMinDate} al ${currentMaxDate}`;

        transacciones.forEach(tx => {
            if (tx.fecha < currentMinDate) tx.fecha = currentMinDate;
            if (tx.fecha > currentMaxDate) tx.fecha = currentMaxDate;
        });

        renderTransacciones();
    }

    selectPeriodicity?.addEventListener('change', updateSubPeriods);
    selectSubPeriod?.addEventListener('change', applyDateBounds);

    // Estado inicial de transacciones
    let transacciones = [
        { id: 1, descripcion: 'Transporte', monto: 420, fecha: todayISO },
        { id: 2, descripcion: 'Educación', monto: 500, fecha: todayISO }
    ];

    function renderTransacciones() {
        const list = document.getElementById('txList');
        if (!list) return;

        list.innerHTML = transacciones.map((tx, idx) => `
            <div class="flex items-center gap-2 bg-gray-50 dark:bg-gray-800/80 p-2 rounded-2xl border border-gray-200 dark:border-gray-700 animate-fade-in" data-id="${tx.id}">
                <select class="tx-category flex-1 px-2.5 py-2 text-xs bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white">
                    ${OFFICIAL_CATEGORIES.map(cat => `
                        <option value="${cat}" ${tx.descripcion === cat ? 'selected' : ''}>${cat}</option>
                    `).join('')}
                </select>
                <input type="number" min="1" value="${tx.monto}" placeholder="Monto"
                    class="tx-amount w-24 px-2.5 py-2 text-xs bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white" />
                <input type="date" min="${currentMinDate}" max="${currentMaxDate}" value="${tx.fecha || currentMinDate}"
                    class="tx-date w-32 px-2 py-2 text-[11px] bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white" />
                <button type="button" class="btn-remove-tx p-1.5 text-gray-400 hover:text-red-500 transition rounded-lg" data-id="${tx.id}" title="Eliminar">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        `).join('');

        document.getElementById('txCount').textContent = `${transacciones.length} agregada(s)`;

        // Eventos
        document.querySelectorAll('.btn-remove-tx').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = parseInt(btn.getAttribute('data-id'));
                transacciones = transacciones.filter(t => t.id !== id);
                renderTransacciones();
            });
        });

        document.querySelectorAll('.tx-category').forEach((sel, idx) => {
            sel.addEventListener('change', () => {
                transacciones[idx].descripcion = sel.value;
            });
        });

        document.querySelectorAll('.tx-amount').forEach((inp, idx) => {
            inp.addEventListener('input', () => {
                transacciones[idx].monto = parseFloat(inp.value) || 0;
            });
        });

        document.querySelectorAll('.tx-date').forEach((inp, idx) => {
            inp.addEventListener('change', () => {
                let val = inp.value;
                if (val > currentMaxDate) val = currentMaxDate;
                if (val < currentMinDate) val = currentMinDate;
                transacciones[idx].fecha = val;
                inp.value = val;
            });
        });
    }

    document.getElementById('btnAddTx')?.addEventListener('click', () => {
        const nextId = transacciones.length > 0 ? Math.max(...transacciones.map(t => t.id)) + 1 : 1;
        transacciones.push({ id: nextId, descripcion: 'Alimentación', monto: 150, fecha: currentMinDate });
        renderTransacciones();
    });

    updateSubPeriods();

    // ─── EJECUTAR ANÁLISIS CON IA ───
    document.getElementById('btnAnalizar')?.addEventListener('click', async () => {
        const btn = document.getElementById('btnAnalizar');
        btn.disabled = true;
        btn.innerHTML = `
            <svg class="animate-spin w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            Analizando con IA...`;

        const ingreso = parseFloat(document.getElementById('ingreso').value) || 0;
        const periodicity = selectPeriodicity.value;
        const txns = transacciones.map(t => ({ descripcion: t.descripcion, valor: t.monto }));

        const payload = {
            ingresoMensual: ingreso,
            nivelEndeudamiento: 0,
            frecuenciaAhorro: "AUTO",
            periodicidad: periodicity,
            moneda: activeCurrency,
            transacciones: txns
        };

        try {
            const token = localStorage.getItem('financeai_token');
            const headers = { 'Content-Type': 'application/json' };
            if (token) headers['Authorization'] = `Bearer ${token}`;

            const res = await fetch(`${API_URL}/api/v1/analisis-financiero`, {
                method: 'POST',
                headers: headers,
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                const data = await res.json();
                updateDashboardResults(data);

                // Acumular transacciones permanentemente en el historial sin borrar meses anteriores
                let existingHistory = [];
                try {
                    existingHistory = JSON.parse(localStorage.getItem('financeai_all_transactions') || '[]');
                } catch (_) {
                    existingHistory = [];
                }

                const timestampBase = Date.now();
                const newTxns = [
                    {
                        id: timestampBase,
                        description: `Ingreso del Período (${selectSubPeriod.options[selectSubPeriod.selectedIndex]?.text || ''})`,
                        amount: ingreso,
                        category: 'Ingresos',
                        type: 'INCOME',
                        date: currentMinDate
                    },
                    ...transacciones.map((t, idx) => ({
                        id: timestampBase + idx + 1,
                        description: t.descripcion,
                        amount: t.monto,
                        category: t.descripcion,
                        type: 'EXPENSE',
                        date: t.fecha || currentMinDate
                    }))
                ];

                const updatedHistory = [...existingHistory, ...newTxns];
                localStorage.setItem('financeai_all_transactions', JSON.stringify(updatedHistory));
                localStorage.setItem('financeai_dashboard_txns', JSON.stringify(updatedHistory));

                window.showToast('¡Análisis Completado!', 'Resultados generados con el motor de IA', '🧠');
            } else {
                window.showToast('Error en Análisis', `No fue posible completar el análisis (HTTP ${res.status}).`, '❌');
            }
        } catch (e) {
            window.showToast('Error de Conexión', 'No fue posible contactar con el backend.', '❌');
        } finally {
            btn.disabled = false;
            btn.innerHTML = `
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                Ejecutar Análisis con IA`;
        }
    });

    function updateDashboardResults(data) {
        // Score Ring & Text
        const score = data.score_financiero || data.score || 0;
        document.getElementById('scoreText').textContent = score;
        
        const scoreRing = document.getElementById('scoreRing');
        const offset = 314.159 - (314.159 * score) / 100;
        scoreRing.style.strokeDashoffset = offset;

        const badge = document.getElementById('scoreBadge');
        const badgeText = document.getElementById('scoreBadgeText');

        if (score >= 70) {
            scoreRing.setAttribute('class', 'text-emerald-500 transition-all duration-1000 ease-out');
            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800';
            badgeText.textContent = 'Saludable';
        } else if (score >= 40) {
            scoreRing.setAttribute('class', 'text-amber-500 transition-all duration-1000 ease-out');
            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-100 dark:bg-amber-950/70 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800';
            badgeText.textContent = 'En Riesgo';
        } else {
            scoreRing.setAttribute('class', 'text-red-500 transition-all duration-1000 ease-out');
            badge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-100 dark:bg-red-950/70 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800';
            badgeText.textContent = 'Crítico';
        }

        // Stats
        document.getElementById('statGastos').textContent = `${activeCurrency} ${Number(data.total_gastos || 0).toLocaleString()}`;
        document.getElementById('statAhorro').textContent = `${activeCurrency} ${Number(data.ahorro_estimado || 0).toLocaleString()}`;
        document.getElementById('statDeuda').textContent = `${data.nivel_endeudamiento || 0}%`;
        document.getElementById('statFrecuencia').textContent = data.frecuencia_ahorro || 'Media';

        // Explicabilidad DS-08 en 3 Capas
        if (data.explicabilidad_ds08) {
            document.getElementById('capa1Text').textContent = data.explicabilidad_ds08.diagnostico || '';
            document.getElementById('capa2Text').textContent = data.explicabilidad_ds08.causa_principal || '';
            document.getElementById('capa3Text').textContent = data.explicabilidad_ds08.accion_recomendada || '';
        }

        // Lista de Consejos y Alertas Específicas
        const alertsList = document.getElementById('alertsList');
        const consejos = data.consejos_financieros || data.recomendaciones || [];

        if (consejos.length > 0) {
            alertsList.innerHTML = consejos.map((c, idx) => `
                <li class="p-3 bg-gray-50 dark:bg-gray-800/70 text-gray-700 dark:text-gray-300 rounded-2xl border border-gray-200/60 dark:border-gray-700/50 flex items-start gap-3 animate-fade-in">
                    <div class="w-5 h-5 rounded-lg bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0 mt-0.5 text-[10px] font-bold">
                        ${idx + 1}
                    </div>
                    <span class="leading-relaxed font-medium">${c}</span>
                </li>
            `).join('');
        }
    }
</script>
