    <!-- Modal para Completar Perfil de Google Auth con Todos los Países y Monedas -->
    <div id="completeProfileModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-gray-900/80 backdrop-blur-md">
        <div class="bg-white dark:bg-gray-900 w-full max-w-sm rounded-3xl p-8 shadow-2xl border border-gray-200 dark:border-gray-800 animate-scale-in">
