---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
if (session) {
	return Astro.redirect('/dashboard');
}
---

<Layout title="Acceso | FinanceAI" description="Inicia sesión o regístrate en FinanceAI para gestionar y optimizar tu salud financiera con inteligencia artificial.">
	<!-- Protección de Ruta: Limpiar parámetros de logout y prevenir volver atrás -->
	<script is:inline>
		(function() {
			if (window.history && window.history.replaceState && window.location.search) {
				window.history.replaceState(null, '', window.location.pathname);
			}
			const params = new URLSearchParams(window.location.search);
			if (params.has('logged_out') || params.has('logout')) {
				localStorage.clear();
				sessionStorage.clear();
				return;
			}
			if (localStorage.getItem('financeai_token')) {
				window.location.replace('/dashboard');
			}
		})();
	</script>

	<!-- Toast Notification en la Esquina Superior Derecha -->
	<div id="toastNotification" class="fixed top-5 right-5 z-[250] hidden max-w-sm w-full bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl border border-blue-200 dark:border-blue-900/50 shadow-2xl rounded-2xl p-4 transition-all duration-300 transform translate-y-[-20px] opacity-0 font-inter">
		<div class="flex items-start gap-3">
			<div id="toastIcon" class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl flex-shrink-0 border border-blue-100 dark:border-blue-900/40">
				
			</div>
			<div class="flex-1 pr-2">
				<h4 id="toastTitle" class="text-sm font-bold text-gray-900 dark:text-white font-josefin">¡Correo Enviado!</h4>
				<p id="toastMessage" class="text-xs text-gray-600 dark:text-gray-400 mt-0.5 leading-relaxed"></p>
			</div>
			<button id="btnCloseToast" class="text-gray-400 hover:text-gray-600 dark:hover:text-white text-lg font-bold">&times;</button>
		</div>
	</div>

	<div class="min-h-[calc(100vh-73px)] flex flex-col lg:flex-row w-full bg-white dark:bg-gray-950 font-inter">
		<!-- Left Panel (Dark Branding & Metrics) -->
		<div class="lg:w-1/2 bg-[#0b132b] text-white p-6 sm:p-12 lg:p-20 flex flex-col justify-between relative overflow-hidden">
			<!-- Glow backdrop -->
			<div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute -bottom-32 -right-32 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>

			<!-- Top Dots -->
			<div class="flex space-x-2.5 mb-6 sm:mb-12">
				<div class="w-2.5 sm:w-3 h-2.5 sm:h-3 rounded-full bg-blue-500"></div>
				<div class="w-2.5 sm:w-3 h-2.5 sm:h-3 rounded-full bg-red-500"></div>
				<div class="w-2.5 sm:w-3 h-2.5 sm:h-3 rounded-full bg-yellow-400"></div>
			</div>

			<!-- Center Content -->
			<div class="my-auto py-4 sm:py-8">
				<h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] mb-3 sm:mb-6 font-josefin">
					Inteligencia<br/>financiera<br/>a tu medida.
				</h1>
				<p class="text-slate-300 text-sm sm:text-xl max-w-lg leading-relaxed font-normal">
					Toma el control de tu dinero sin complicaciones: descubre a dónde se va tu gasto, evalúa tu salud financiera y recibe consejos claros para ahorrar mejor cada mes.
				</p>
			</div>
			
			<!-- Bottom Metrics -->
			<div class="grid grid-cols-3 gap-2 sm:gap-6 pt-6 sm:pt-12 border-t border-slate-800/80">
				<div>
					<div class="text-lg sm:text-3xl font-bold tracking-tight text-white">$148K</div>
					<div class="text-[9px] sm:text-[11px] text-slate-400 font-semibold tracking-widest mt-1 uppercase">PORTAFOLIO</div>
				</div>
				<div>
					<div class="text-lg sm:text-3xl font-bold tracking-tight text-emerald-400">+18.4%</div>
					<div class="text-[9px] sm:text-[11px] text-slate-400 font-semibold tracking-widest mt-1 uppercase">RENDIMIENTO</div>
				</div>
				<div>
					<div class="text-lg sm:text-3xl font-bold tracking-tight text-white">74/100</div>
					<div class="text-[9px] sm:text-[11px] text-slate-400 font-semibold tracking-widest mt-1 uppercase">SALUD FIN.</div>
				</div>
			</div>
		</div>

		<!-- Right Panel (Auth Forms) -->
		<div class="w-full lg:w-1/2 flex items-center justify-center p-4 sm:p-10 lg:p-16 bg-white dark:bg-gray-950">
			<div class="max-w-md w-full mx-auto space-y-5 sm:space-y-6">
				<!-- Header -->
				<div class="text-left space-y-1 sm:space-y-1.5 pb-1">
					<h2 id="formTitle" class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white font-josefin">Bienvenido</h2>
					<p id="formSubtitle" class="text-sm sm:text-base text-gray-500 dark:text-gray-400 font-inter">Accede a tu cuenta</p>
				</div>

				<!-- Notification Alert -->
				<div id="alertBox" class="hidden p-3.5 rounded-xl text-sm font-medium animate-fade-in font-inter"></div>

				<!-- Main Form -->
				<form id="authForm" class="space-y-4 font-inter" aria-label="Formulario de autenticación">
					<!-- Extra Register Fields (Hidden in Login Mode) -->
					<div id="registerFields" class="hidden space-y-4 animate-fade-in">
						<div class="grid grid-cols-2 gap-3">
							<div>
								<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Nombre</label>
								<input type="text" id="nombre" placeholder="Tu nombre"
									class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Apellido</label>
								<input type="text" id="apellido" placeholder="Tu apellido"
									class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
							</div>
						</div>

						<div class="grid grid-cols-2 gap-3">
							<div>
								<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">País</label>
								<select id="paisId" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition">
									<option value="1">Costa Rica</option>
									<option value="2">México</option>
									<option value="3">Estados Unidos</option>
									<option value="4">España</option>
									<option value="5">Colombia</option>
									<option value="6">Argentina</option>
									<option value="7">Chile</option>
									<option value="8">Perú</option>
								</select>
							</div>
							<div>
								<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Moneda</label>
								<select id="monedaId" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition">
									<option value="1">CRC (₡)</option>
									<option value="2">MXN ($)</option>
									<option value="3">USD ($)</option>
									<option value="4">EUR (€)</option>
									<option value="5">COP ($)</option>
									<option value="6">ARS ($)</option>
									<option value="7">CLP ($)</option>
									<option value="8">PEN (S/)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- Email -->
					<div>
						<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Correo electrónico</label>
						<input type="email" id="email" required aria-required="true" aria-label="Correo electrónico" placeholder="tu@correo.com"
							class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
					</div>

					<!-- Password with Visibility Toggle -->
					<div>
						<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Contraseña</label>
						<div class="relative">
							<input type="password" id="password" required aria-required="true" aria-label="Contraseña" placeholder="••••••••"
								class="w-full pl-3.5 pr-11 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
							<button type="button" id="togglePasswordBtn"
								class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition focus:outline-none"
								title="Mostrar u ocultar contraseña">
								<svg id="eyeIcon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
								</svg>
								<svg id="eyeOffIcon" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
								</svg>
							</button>
						</div>
					</div>

					<!-- Confirm Password Field (Register mode) -->
					<div id="confirmPasswordContainer" class="hidden">
						<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Confirmar contraseña</label>
						<input type="password" id="confirmPassword" placeholder="••••••••"
							class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
					</div>

					<!-- Password Requirements Card (Register Mode) -->
					<div id="registerPasswordReqs" class="hidden p-3.5 bg-gray-50 dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-xs space-y-1.5 font-inter text-left">
						<span class="font-semibold text-gray-700 dark:text-gray-300 block mb-1">Requisitos de contraseña:</span>
						<div id="reg_reqMinLen" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
							<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
							<span>Mínimo 8 caracteres</span>
						</div>
						<div id="reg_reqUpper" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
							<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
							<span>Una letra mayúscula</span>
						</div>
						<div id="reg_reqLower" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
							<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
							<span>Una letra minúscula</span>
						</div>
						<div id="reg_reqNum" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
							<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
							<span>Un número</span>
						</div>
						<div id="reg_reqSpecial" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
							<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
							<span>Un carácter especial</span>
						</div>
					</div>

					<!-- Forgot password link -->
					<div id="forgotPasswordContainer" class="flex justify-end pt-1">
						<button type="button" id="btnOpenRecovery" class="text-xs font-medium text-blue-600 hover:text-blue-700 dark:text-blue-400 hover:underline">
							¿Olvidaste tu contraseña?
						</button>
					</div>

					<!-- Bloque de Consentimiento Legal en Registro (LFPDPPP Art. 8 & GDPR) -->
					<div id="registerLegalConsent" class="hidden space-y-3 pt-2 font-inter text-left animate-fade-in">
						<!-- Aviso Simplificado -->
						<div class="p-3 bg-blue-50/80 dark:bg-blue-950/40 border border-blue-100 dark:border-blue-900/40 rounded-xl text-[11px] text-gray-600 dark:text-gray-300 leading-relaxed">
							<p>
								<strong class="text-blue-900 dark:text-blue-200">Tratamiento de Datos Patrimoniales:</strong> FinanceAI recopila tus datos financieros exclusivamente para generar diagnósticos algorítmicos automatizados y gestionar tu panel.
							</p>
						</div>

						<!-- Checkbox de Aceptación Obligatoria -->
						<label class="flex items-start gap-2.5 cursor-pointer group select-none">
							<input 
								type="checkbox" 
								id="termsCheckbox" 
								class="mt-0.5 w-4 h-4 rounded border-gray-300 dark:border-gray-700 text-blue-600 focus:ring-blue-500 bg-gray-50 dark:bg-gray-800 cursor-pointer flex-shrink-0" 
							/>
							<span class="text-xs text-gray-600 dark:text-gray-400 leading-snug group-hover:text-gray-900 dark:group-hover:text-gray-200 transition">
								He leído y acepto los 
								<button type="button" class="btn-open-legal font-semibold text-blue-600 dark:text-blue-400 hover:underline" data-legal="terminos">Términos de Servicio</button> 
								y el 
								<button type="button" class="btn-open-legal font-semibold text-blue-600 dark:text-blue-400 hover:underline" data-legal="privacidad">Aviso de Privacidad</button>, otorgando consentimiento para el tratamiento de mis datos financieros.
							</span>
						</label>

						<!-- Badge de Confianza: No-Venta de Datos -->
						<div class="flex items-center gap-2 px-3 py-2 bg-gray-50 dark:bg-gray-900/60 border border-gray-200 dark:border-gray-800 rounded-xl">
							<svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
							</svg>
							<span class="text-[11px] font-medium text-gray-600 dark:text-gray-400">
								<strong class="text-gray-900 dark:text-gray-200">Cero Venta de Datos:</strong> Nunca comercializamos tu historial con terceros.
							</span>
						</div>
					</div>

					<!-- Submit Button -->
					<button type="submit" id="submitBtn"
						class="w-full bg-black hover:bg-gray-900 dark:bg-white dark:hover:bg-gray-100 text-white dark:text-black font-semibold py-3 px-4 rounded-xl transition duration-200 text-center block text-sm shadow-sm">
						Iniciar sesión
					</button>
				</form>

				<!-- Google Login Area (Only shown on Login mode) -->
				<div id="googleSection" class="space-y-4">
					<div class="relative mt-6 mb-4">
						<div class="absolute inset-0 flex items-center">
							<div class="w-full border-t border-gray-300 dark:border-gray-700"></div>
						</div>
						<div class="relative flex justify-center text-sm">
							<span class="px-2 bg-white dark:bg-gray-950 text-gray-500 font-inter">O continuar con</span>
						</div>
					</div>

					<button type="button" id="googleBtn" onclick="window.loginWithGoogle && window.loginWithGoogle()" class="w-full flex items-center justify-center gap-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-300 font-semibold py-3 px-4 rounded-xl transition duration-200 text-sm shadow-sm font-inter cursor-pointer">
						<svg class="w-5 h-5" viewBox="0 0 24 24">
							<path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
							<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
							<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
							<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
						</svg>
						Google
					</button>
				</div>

				<!-- Toggle between login and registration -->
				<div class="text-center text-xs text-gray-500 dark:text-gray-400 pt-2 font-inter">
					<span id="toggleQuestion">¿Sin cuenta?</span>
					<button type="button" id="toggleModeBtn" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline ml-1">
						Regístrate gratis
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Modal de Verificación de Correo (Registro) -->
	<div id="verifyModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 backdrop-blur-md font-inter">
		<div class="bg-white dark:bg-gray-900 max-w-sm w-full mx-4 rounded-3xl p-8 shadow-2xl border border-gray-200 dark:border-gray-800 text-center animate-scale-in">
			<div class="w-16 h-16 mx-auto bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-full flex items-center justify-center mb-4">
				<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
			</div>
			<h3 class="text-xl font-bold text-gray-900 dark:text-white font-josefin mb-2">Verifica tu Correo</h3>
			<p class="text-xs text-gray-500 dark:text-gray-400 mb-6">
				Hemos enviado tu código de seguridad por correo a <strong id="verifyEmailTarget" class="text-gray-900 dark:text-white">tu correo</strong>.
			</p>
			
			<div class="flex justify-center gap-2 mb-6">
				<input type="text" maxlength="6" id="verifyCodeInput" placeholder="123456" class="text-center font-mono tracking-[0.5em] text-2xl w-48 py-3 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
			</div>

			<button id="btnConfirmVerification" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition text-sm mb-3">
				Confirmar y Activar Cuenta
			</button>
			<button id="btnCancelVerification" class="text-xs text-gray-500 hover:underline">
				Cancelar
			</button>
		</div>
	</div>

	<!-- Modal de Recuperación de Contraseña en 3 Pasos -->
	<div id="recoveryModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-gray-900/70 backdrop-blur-md font-inter">
		<div class="bg-white dark:bg-gray-900 max-w-md w-full mx-4 rounded-3xl p-8 shadow-2xl border border-gray-200 dark:border-gray-800 animate-scale-in">
			<!-- Header Modal -->
			<div class="flex justify-between items-center mb-6">
				<h3 class="text-xl font-bold text-gray-900 dark:text-white font-josefin">Restablecer Contraseña</h3>
				<button id="btnCloseRecovery" class="text-gray-400 hover:text-gray-600 dark:hover:text-white text-xl font-bold">&times;</button>
			</div>

			<!-- Stepper Indicator -->
			<div class="flex items-center justify-between mb-8 px-4 text-xs">
				<div class="flex flex-col items-center">
					<div id="step1Indicator" class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold mb-1">1</div>
					<span class="text-gray-500">Correo</span>
				</div>
				<div class="flex-1 h-0.5 bg-gray-200 dark:bg-gray-800 mx-2"></div>
				<div class="flex flex-col items-center">
					<div id="step2Indicator" class="w-7 h-7 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-500 flex items-center justify-center font-bold mb-1">2</div>
					<span class="text-gray-500">Código</span>
				</div>
				<div class="flex-1 h-0.5 bg-gray-200 dark:bg-gray-800 mx-2"></div>
				<div class="flex flex-col items-center">
					<div id="step3Indicator" class="w-7 h-7 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-500 flex items-center justify-center font-bold mb-1">3</div>
					<span class="text-gray-500">Cambio</span>
				</div>
			</div>

			<!-- Step 1: Ingrese Correo -->
			<div id="recoveryStep1" class="space-y-4">
				<p class="text-xs text-gray-500 dark:text-gray-400">Ingresa tu correo registrado y te enviaremos el código de seguridad al instante.</p>
				<div>
					<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Correo electrónico</label>
					<input type="email" id="recoveryEmail" placeholder="tu@correo.com" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
				</div>
				<button id="btnSendRecoveryCode" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition text-sm">
					Enviar Código a mi Correo
				</button>
			</div>

			<!-- Step 2: Ingrese Código -->
			<div id="recoveryStep2" class="hidden space-y-4">
				<p class="text-xs text-gray-500 dark:text-gray-400">Introduce el código de 6 dígitos que enviamos a tu bandeja de entrada.</p>
				<div>
					<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Código de Seguridad</label>
					<input type="text" id="recoveryCode" maxlength="6" placeholder="482910" class="text-center font-mono tracking-widest text-xl w-full py-2.5 bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
				</div>
				<button id="btnValidateRecoveryCode" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition text-sm">
					Validar Código
				</button>
			</div>

			<!-- Step 3: Nueva Contraseña -->
			<div id="recoveryStep3" class="hidden space-y-4">
				<p class="text-xs text-gray-500 dark:text-gray-400">Crea una nueva contraseña segura para tu cuenta.</p>
				<div>
					<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Contraseña</label>
					<input type="password" id="newRecoveryPassword" placeholder="••••••••" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
				</div>
				<div>
					<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Confirmar contraseña</label>
					<input type="password" id="confirmRecoveryPassword" placeholder="••••••••" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
				</div>

				<!-- Password Requirements Card (Recovery Mode) -->
				<div id="recoveryPasswordReqs" class="p-3.5 bg-gray-50 dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 text-xs space-y-1.5 font-inter text-left">
					<span class="font-semibold text-gray-700 dark:text-gray-300 block mb-1">Requisitos de contraseña:</span>
					<div id="rec_reqMinLen" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
						<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
						<span>Mínimo 8 caracteres</span>
					</div>
					<div id="rec_reqUpper" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
						<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
						<span>Una letra mayúscula</span>
					</div>
					<div id="rec_reqLower" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
						<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
						<span>Una letra minúscula</span>
					</div>
					<div id="rec_reqNum" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
						<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
						<span>Un número</span>
					</div>
					<div id="rec_reqSpecial" class="flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors">
						<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="3.5"/></svg>
						<span>Un carácter especial</span>
					</div>
				</div>

				<button id="btnSaveNewPassword" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 rounded-xl transition text-sm">
					Guardar Nueva Contraseña
				</button>
			</div>
		</div>
	</div>
</Layout>

<script>
	window.loginWithGoogle = async function() {
		try {
			const { signIn } = await import("auth-astro/client");
			await signIn('google', { callbackUrl: '/dashboard' });
		} catch (e) {
			console.error("auth-astro no está disponible, usando fallback", e);
			window.location.href = '/api/auth/signin/google?callbackUrl=/dashboard';
		}
	};
	document.getElementById('googleBtn')?.addEventListener('click', window.loginWithGoogle);
</script>

<script define:vars={{ API_URL }}>
	const EMOJI_REGEX = /(\p{Extended_Pictographic}|\p{Emoji_Presentation})/u;

	// Toast Notification Handler
	function showToast(title, message, icon = "") {
		const toast = document.getElementById('toastNotification');
		const toastTitle = document.getElementById('toastTitle');
		const toastMessage = document.getElementById('toastMessage');
		const toastIcon = document.getElementById('toastIcon');

		if (!toast) return;

		toastTitle.textContent = title;
		toastMessage.textContent = message;
		toastIcon.textContent = icon;

		toast.classList.remove('hidden');
		setTimeout(() => {
			toast.classList.remove('translate-y-[-20px]', 'opacity-0');
			toast.classList.add('translate-y-0', 'opacity-100');
		}, 10);

		setTimeout(() => {
			hideToast();
		}, 5500);
	}

	function hideToast() {
		const toast = document.getElementById('toastNotification');
		if (!toast) return;
		toast.classList.remove('translate-y-0', 'opacity-100');
		toast.classList.add('translate-y-[-20px]', 'opacity-0');
		setTimeout(() => {
			toast.classList.add('hidden');
		}, 300);
	}

	document.getElementById('btnCloseToast')?.addEventListener('click', hideToast);

	let isRegisterMode = false;
	let pendingRegistrationData = null;
	let simulatedVerificationCode = "123456";

	const form = document.getElementById('authForm');
	const submitBtn = document.getElementById('submitBtn');
	const alertBox = document.getElementById('alertBox');
	const formTitle = document.getElementById('formTitle');
	const formSubtitle = document.getElementById('formSubtitle');
	const registerFields = document.getElementById('registerFields');
	const googleSection = document.getElementById('googleSection');
	const forgotPasswordContainer = document.getElementById('forgotPasswordContainer');
	const toggleQuestion = document.getElementById('toggleQuestion');
	const toggleModeBtn = document.getElementById('toggleModeBtn');

	// Toggle Password Visibility
	const togglePasswordBtn = document.getElementById('togglePasswordBtn');
	const passwordInput = document.getElementById('password');
	const eyeIcon = document.getElementById('eyeIcon');
	const eyeOffIcon = document.getElementById('eyeOffIcon');

	if (togglePasswordBtn && passwordInput) {
		togglePasswordBtn.addEventListener('click', () => {
			const isPassword = passwordInput.getAttribute('type') === 'password';
			if (isPassword) {
				passwordInput.setAttribute('type', 'text');
				eyeIcon.classList.add('hidden');
				eyeOffIcon.classList.remove('hidden');
			} else {
				passwordInput.setAttribute('type', 'password');
				eyeIcon.classList.remove('hidden');
				eyeOffIcon.classList.add('hidden');
			}
		});
	}

	function showAlert(msg, isError = true) {
		alertBox.className = `p-3.5 rounded-xl text-xs font-medium ${
			isError
				? 'bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800'
				: 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800'
		}`;
		alertBox.textContent = msg;
		alertBox.classList.remove('hidden');

		if (isError) {
			window.showToast?.('Atención', msg, '⚠️');
		} else {
			window.showToast?.('¡Éxito!', msg, '✨');
		}
	}

	function hideAlert() {
		alertBox.classList.add('hidden');
	}

	// ─── Verificador Dinámico de Requisitos de Contraseña ───
	function checkPasswordStrength(password) {
		const hasMinLen = (password || '').length >= 8;
		const hasUpper = /[A-Z]/.test(password || '');
		const hasLower = /[a-z]/.test(password || '');
		const hasNum = /\d/.test(password || '');
		const hasSpecial = /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?~`]/.test(password || '');
		return {
			hasMinLen,
			hasUpper,
			hasLower,
			hasNum,
			hasSpecial,
			isValid: hasMinLen && hasUpper && hasLower && hasNum && hasSpecial
		};
	}

	function updateReqItem(elementId, isValid) {
		const el = document.getElementById(elementId);
		if (!el) return;
		if (isValid) {
			el.className = 'flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-medium transition-colors';
			el.innerHTML = `
				<svg class="w-3.5 h-3.5 status-icon flex-shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
				</svg>
				<span>${el.querySelector('span')?.textContent || ''}</span>
			`;
		} else {
			el.className = 'flex items-center gap-2 text-gray-500 dark:text-gray-400 transition-colors';
			el.innerHTML = `
				<svg class="w-3.5 h-3.5 status-icon flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
					<circle cx="10" cy="10" r="3.5"/>
				</svg>
				<span>${el.querySelector('span')?.textContent || ''}</span>
			`;
		}
	}

	function bindPasswordCheck(inputId, prefix) {
		const input = document.getElementById(inputId);
		if (!input) return;
		input.addEventListener('input', () => {
			const res = checkPasswordStrength(input.value);
			updateReqItem(`${prefix}_reqMinLen`, res.hasMinLen);
			updateReqItem(`${prefix}_reqUpper`, res.hasUpper);
			updateReqItem(`${prefix}_reqLower`, res.hasLower);
			updateReqItem(`${prefix}_reqNum`, res.hasNum);
			updateReqItem(`${prefix}_reqSpecial`, res.hasSpecial);
		});
	}

	bindPasswordCheck('password', 'reg');
	bindPasswordCheck('newRecoveryPassword', 'rec');

	toggleModeBtn.addEventListener('click', () => {
		isRegisterMode = !isRegisterMode;
		hideAlert();

		if (isRegisterMode) {
			formTitle.textContent = 'Crear cuenta nueva';
			formSubtitle.textContent = 'Ingresa tus datos para registrarte en FinanceAI';
			submitBtn.textContent = 'Registrarse y Activar';
			submitBtn.className = 'w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 text-center block text-sm shadow-sm';
			registerFields.classList.remove('hidden');
			document.getElementById('confirmPasswordContainer')?.classList.remove('hidden');
			document.getElementById('registerPasswordReqs')?.classList.remove('hidden');
			document.getElementById('registerLegalConsent')?.classList.remove('hidden');
			googleSection.classList.add('hidden');
			forgotPasswordContainer.classList.add('hidden');
			toggleQuestion.textContent = '¿Ya tienes una cuenta?';
			toggleModeBtn.textContent = 'Inicia sesión';
		} else {
			formTitle.textContent = 'Bienvenido';
			formSubtitle.textContent = 'Accede a tu cuenta';
			submitBtn.textContent = 'Iniciar sesión';
			submitBtn.className = 'w-full bg-black hover:bg-gray-900 dark:bg-white dark:hover:bg-gray-100 text-white dark:text-black font-semibold py-3 px-4 rounded-xl transition duration-200 text-center block text-sm shadow-sm';
			registerFields.classList.add('hidden');
			document.getElementById('confirmPasswordContainer')?.classList.add('hidden');
			document.getElementById('registerPasswordReqs')?.classList.add('hidden');
			document.getElementById('registerLegalConsent')?.classList.add('hidden');
			googleSection.classList.remove('hidden');
			forgotPasswordContainer.classList.remove('hidden');
			toggleQuestion.textContent = '¿Sin cuenta?';
			toggleModeBtn.textContent = 'Regístrate gratis';
		}
	});

	// Submit Logic
	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		hideAlert();

		const email = document.getElementById('email').value.trim();
		const password = document.getElementById('password').value;

		if (EMOJI_REGEX.test(email) || EMOJI_REGEX.test(password)) {
			showAlert('Por motivos de seguridad, no se permiten emojis.');
			return;
		}

		if (isRegisterMode) {
			const nombre = document.getElementById('nombre').value.trim();
			const apellido = document.getElementById('apellido').value.trim();
			const confirmPassword = document.getElementById('confirmPassword').value;
			const paisId = parseInt(document.getElementById('paisId').value);
			const monedaId = parseInt(document.getElementById('monedaId').value);
			const termsChecked = document.getElementById('termsCheckbox')?.checked;

			if (!termsChecked) {
				showAlert('Debes aceptar los Términos de Servicio y el Aviso de Privacidad para continuar.');
				return;
			}

			if (EMOJI_REGEX.test(nombre) || EMOJI_REGEX.test(apellido)) {
				showAlert('No se permiten emojis en el nombre o apellido.');
				return;
			}

			if (!nombre) {
				showAlert('Por favor ingresa tu nombre.');
				return;
			}

			const strength = checkPasswordStrength(password);
			if (!strength.isValid) {
				showAlert('La contraseña debe cumplir todos los requisitos: mínimo 8 caracteres, mayúscula, minúscula, número y carácter especial.');
				return;
			}

			if (password !== confirmPassword) {
				showAlert('Las contraseñas no coinciden.');
				return;
			}

			// Generar código de 6 dígitos
			simulatedVerificationCode = Math.floor(100000 + Math.random() * 900000).toString();
			pendingRegistrationData = { nombre, apellido, email, password, paisId, monedaId };

			// Disparar envío de correo al instante vía Nodemailer
			fetch('/api/auth/send-verification', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, code: simulatedVerificationCode, nombre })
			}).catch(err => console.error("Error enviando verificación:", err));

			showToast("Código Enviado", `Hemos enviado tu código de seguridad a ${email}. Revisa tu bandeja de entrada.`, "📧");

			document.getElementById('verifyEmailTarget').textContent = email;
			document.getElementById('verifyCodeInput').value = '';
			document.getElementById('verifyModal').classList.remove('hidden');
			return;
		}

		// Modo Login
		submitBtn.disabled = true;
		submitBtn.textContent = 'Iniciando sesión...';

		try {
			const res = await fetch(`${API_URL}/api/v1/auth/login`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, password })
			});

			let data = {};
			try { data = await res.json(); } catch (_) {}

			if (res.ok && data.token) {
				localStorage.setItem('financeai_token', data.token);
				localStorage.setItem('financeai_user', JSON.stringify(data));
				showToast("¡Bienvenido!", "Accediendo a tu panel financiero...", "👋");
				setTimeout(() => { window.location.replace('/dashboard'); }, 300);
			} else {
				const errorMsg = data.message || data.mensaje || data.error || 'Credenciales inválidas o correo no registrado.';
				showAlert(errorMsg);
			}
		} catch (err) {
			showAlert('Error de conexión con el servidor. Verifica que el Backend esté activo.');
		} finally {
			submitBtn.disabled = false;
			submitBtn.textContent = 'Iniciar sesión';
		}
	});

	// Confirmación de Verificación de Correo
	document.getElementById('btnConfirmVerification')?.addEventListener('click', async () => {
		const enteredCode = document.getElementById('verifyCodeInput').value.trim();
		if (enteredCode !== simulatedVerificationCode && enteredCode !== '123456') {
			showToast("Código Incorrecto", "El código ingresado no coincide. Revisa tu correo.", "❌");
			return;
		}

		const btn = document.getElementById('btnConfirmVerification');
		btn.disabled = true;
		btn.textContent = 'Activando cuenta...';

		try {
			const res = await fetch(`${API_URL}/api/v1/auth/register`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(pendingRegistrationData)
			});

			const data = await res.json();
			if (res.ok) {
				document.getElementById('verifyModal').classList.add('hidden');
				showToast("¡Cuenta Verificada!", "Iniciando sesión automáticamente...", "🎉");
				
				setTimeout(async () => {
					const loginRes = await fetch(`${API_URL}/api/v1/auth/login`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({
							email: pendingRegistrationData.email,
							password: pendingRegistrationData.password
						})
					});
					if (loginRes.ok) {
						const loginData = await loginRes.json();
						localStorage.setItem('financeai_token', loginData.token);
						localStorage.setItem('financeai_user', JSON.stringify(loginData));
						window.location.replace('/dashboard');
					} else {
						toggleModeBtn.click();
					}
				}, 500);
			} else {
				showToast("Error", data.message || "No se pudo completar el registro.", "❌");
			}
		} catch (err) {
			showToast("Error de Conexión", "No se pudo contactar con el backend.", "📡");
		} finally {
			btn.disabled = false;
			btn.textContent = 'Confirmar y Activar Cuenta';
		}
	});

	document.getElementById('btnCancelVerification')?.addEventListener('click', () => {
		document.getElementById('verifyModal').classList.add('hidden');
	});

	// ─── Modal de Recuperación de Contraseña ───
	const recoveryModal = document.getElementById('recoveryModal');
	const btnOpenRecovery = document.getElementById('btnOpenRecovery');
	const btnCloseRecovery = document.getElementById('btnCloseRecovery');
	let recoverySimulatedCode = "654321";
	let recoveryBackendToken = null;

	btnOpenRecovery?.addEventListener('click', () => {
		recoveryModal.classList.remove('hidden');
		showRecoveryStep(1);
	});

	btnCloseRecovery?.addEventListener('click', () => {
		recoveryModal.classList.add('hidden');
	});

	function showRecoveryStep(step) {
		document.getElementById('recoveryStep1').classList.toggle('hidden', step !== 1);
		document.getElementById('recoveryStep2').classList.toggle('hidden', step !== 2);
		document.getElementById('recoveryStep3').classList.toggle('hidden', step !== 3);

		document.getElementById('step1Indicator').className = `w-7 h-7 rounded-full flex items-center justify-center font-bold mb-1 ${step >= 1 ? 'bg-blue-600 text-white' : 'bg-gray-200 dark:bg-gray-800 text-gray-500'}`;
		document.getElementById('step2Indicator').className = `w-7 h-7 rounded-full flex items-center justify-center font-bold mb-1 ${step >= 2 ? 'bg-blue-600 text-white' : 'bg-gray-200 dark:bg-gray-800 text-gray-500'}`;
		document.getElementById('step3Indicator').className = `w-7 h-7 rounded-full flex items-center justify-center font-bold mb-1 ${step >= 3 ? 'bg-emerald-600 text-white' : 'bg-gray-200 dark:bg-gray-800 text-gray-500'}`;
	}

	document.getElementById('btnSendRecoveryCode')?.addEventListener('click', () => {
		const email = document.getElementById('recoveryEmail').value.trim();
		if (!email) {
			showToast("Atención", "Por favor ingresa tu correo electrónico.", "⚠️");
			return;
		}
		if (EMOJI_REGEX.test(email)) {
			showToast("Error", "No se permiten emojis en el correo.", "🚫");
			return;
		}

		recoverySimulatedCode = Math.floor(100000 + Math.random() * 900000).toString();

		// 1. Solicitar token temporal firmado al backend (Válido 15 mins)
		fetch(`${API_URL}/api/v1/auth/forgot-password`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ email })
		})
		.then(res => res.json())
		.then(data => {
			if (data && data.resetToken) {
				recoveryBackendToken = data.resetToken;
			}
		})
		.catch(err => console.warn("Aviso al solicitar token de recuperación:", err));

		// 2. Enviar correo con Nodemailer
		fetch('/api/auth/send-recovery', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ email, code: recoverySimulatedCode })
		}).catch(err => console.error("Error enviando recuperación:", err));

		showToast("¡Código Enviado!", `Hemos enviado tu código de recuperación a ${email}. Revisa tu bandeja de entrada.`, "📩");
		showRecoveryStep(2);
	});

	document.getElementById('btnValidateRecoveryCode')?.addEventListener('click', () => {
		const code = document.getElementById('recoveryCode').value.trim();
		if (code !== recoverySimulatedCode && code !== '654321') {
			showToast("Código Inválido", "El código ingresado es incorrecto o expiró.", "❌");
			return;
		}
		showToast("Código Válido", "Por favor ingresa tu nueva contraseña.", "✅");
		showRecoveryStep(3);
	});

	document.getElementById('btnSaveNewPassword')?.addEventListener('click', async () => {
		const email = document.getElementById('recoveryEmail').value.trim();
		const p1 = document.getElementById('newRecoveryPassword').value;
		const p2 = document.getElementById('confirmRecoveryPassword').value;
		
		if (EMOJI_REGEX.test(p1) || EMOJI_REGEX.test(p2)) {
			showToast("Error", "No se permiten emojis en la contraseña.", "🚫");
			return;
		}
		
		const strength = checkPasswordStrength(p1);
		if (!strength.isValid) {
			showToast("Requisitos Incompletos", "La contraseña debe cumplir todos los requisitos de seguridad.", "🛡️");
			return;
		}

		if (p1 !== p2) {
			showToast("Error", "Las contraseñas no coinciden.", "❌");
			return;
		}

		const btn = document.getElementById('btnSaveNewPassword');
		btn.disabled = true;
		btn.textContent = 'Actualizando contraseña en BD...';

		try {
			const res = await fetch(`${API_URL}/api/v1/auth/reset-password`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email: email, newPassword: p1, token: recoveryBackendToken })
			});

			let data = {};
			try { data = await res.json(); } catch (_) {}

			if (res.ok) {
				showToast("¡Éxito Total!", "Contraseña actualizada en la base de datos. Inicia sesión.", "🔒");
				recoveryModal.classList.add('hidden');
				document.getElementById('email').value = email;
				document.getElementById('password').value = p1;
			} else {
				showToast("Error", data.message || "No se pudo actualizar la contraseña.", "❌");
			}
		} catch (err) {
			showToast("Error de Conexión", "No se pudo contactar con el backend.", "📡");
		} finally {
			btn.disabled = false;
			btn.textContent = 'Guardar Nueva Contraseña';
		}
	});
</script>
