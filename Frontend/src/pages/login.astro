---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';

const GOOGLE_CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID?.trim() ?? '';
---

<Layout title="Acceso | FinanceAI" description="Inicia sesión o regístrate en FinanceAI para gestionar y optimizar tu salud financiera con inteligencia artificial.">
	{GOOGLE_CLIENT_ID && <script is:inline src="https://accounts.google.com/gsi/client?hl=es" async defer></script>}
	<!-- Protección de Ruta: Si ya hay token JWT, redirigir a dashboard -->
	<script is:inline>
		(function() {
			const params = new URLSearchParams(window.location.search);
			if (window.history && window.history.replaceState && window.location.search) {
				window.history.replaceState(null, '', window.location.pathname);
			}
			if (params.has('logged_out') || params.has('logout')) {
				localStorage.removeItem('financeai_token');
				localStorage.removeItem('financeai_user');
				return;
			}
			if (localStorage.getItem('financeai_token')) {
				window.location.replace('/dashboard');
			}
		})();
	</script>

	<!-- Toast Notification -->
	<div id="toastNotification" class="fixed top-5 right-5 z-[250] hidden max-w-sm w-full bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl border border-blue-200 dark:border-blue-900/50 shadow-2xl rounded-2xl p-4 transition-all duration-300 transform translate-y-[-20px] opacity-0 font-inter">
		<div class="flex items-start gap-3">
			<div id="toastIcon" class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl flex-shrink-0 border border-blue-100 dark:border-blue-900/40">
				✉️
			</div>
			<div class="flex-1 pr-2">
				<h4 id="toastTitle" class="text-sm font-bold text-gray-900 dark:text-white font-josefin">Notificación</h4>
				<p id="toastMessage" class="text-xs text-gray-600 dark:text-gray-400 mt-0.5 leading-relaxed"></p>
			</div>
			<button id="btnCloseToast" type="button" class="text-gray-400 hover:text-gray-600 dark:hover:text-white text-lg font-bold cursor-pointer">&times;</button>
		</div>
	</div>

	<div class="min-h-[calc(100vh-73px)] flex flex-col lg:flex-row w-full bg-white dark:bg-gray-950 font-inter">
		<!-- Left Panel (Dark Branding & Illustrated Metrics) -->
		<div class="lg:w-1/2 bg-[#0b132b] text-white p-6 sm:p-12 lg:p-20 flex flex-col justify-between relative overflow-hidden">
			<!-- Glow backdrop -->
			<div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute -bottom-32 -right-32 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>

			<!-- Top Dots -->
			<div class="flex space-x-2.5 mb-6 sm:mb-12">
				<div class="w-2.5 sm:w-3 h-2.5 sm:h-3 rounded-full bg-blue-500"></div>
				<div class="w-2.5 sm:w-3 h-2.5 sm:h-3 rounded-full bg-red-500"></div>
				<div class="w-2.5 sm:w-3 h-2.5 sm:h-3 rounded-full bg-yellow-400"></div>
			</div>

			<!-- Center Content -->
			<div class="my-auto py-4 sm:py-8">
				<h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] mb-3 sm:mb-6 font-josefin">
					Inteligencia<br/>financiera<br/>a tu medida.
				</h1>
				<p class="text-slate-300 text-sm sm:text-lg max-w-lg leading-relaxed font-normal">
					La forma más fácil de organizar tu dinero: monitorea tus hábitos de consumo, cuida tu presupuesto y toma decisiones respaldadas por inteligencia artificial.
				</p>
			</div>

			<!-- Capacidades reales del MVP con la composición visual aprobada -->
			<div class="pt-6 sm:pt-10 border-t border-slate-800/80">
				<p class="text-[10px] uppercase font-bold tracking-widest text-slate-400 mb-3">Plataforma conectada</p>
				<div class="grid grid-cols-3 gap-2 sm:gap-6">
					<div>
						<div class="text-lg sm:text-2xl lg:text-3xl font-bold tracking-tight text-white">100%</div>
						<div class="text-[9px] sm:text-[11px] text-slate-400 font-semibold tracking-widest mt-1 uppercase">DATOS REALES</div>
					</div>
					<div>
						<div class="text-lg sm:text-2xl lg:text-3xl font-bold tracking-tight text-emerald-400">SEGURO</div>
						<div class="text-[9px] sm:text-[11px] text-slate-400 font-semibold tracking-widest mt-1 uppercase">ACCESO PROTEGIDO</div>
					</div>
					<div>
						<div class="text-lg sm:text-2xl lg:text-3xl font-bold tracking-tight text-white">MULTIMONEDA</div>
						<div class="text-[9px] sm:text-[11px] text-slate-400 font-semibold tracking-widest mt-1 uppercase">HNL, MXN, USD Y MÁS</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Right Panel (Auth Forms) -->
		<div class="w-full lg:w-1/2 flex items-center justify-center p-4 sm:p-10 lg:p-16 bg-white dark:bg-gray-950">
			<div class="max-w-md w-full mx-auto space-y-5 sm:space-y-6">
				<!-- Form Header -->
				<div class="text-left space-y-1 sm:space-y-1.5 pb-1">
					<h2 id="formTitle" class="text-2xl sm:text-3xl lg:text-[32px] font-extrabold tracking-tight text-blue-600 dark:text-blue-400 font-josefin">TU ESPACIO FINANCIERO</h2>
					<p id="formSubtitle" class="text-sm sm:text-base text-gray-500 dark:text-gray-400 font-inter">Accede a tu cuenta</p>
				</div>

				<!-- Notification Alert -->
				<div id="alertBox" class="hidden p-3.5 rounded-xl text-xs sm:text-sm font-medium animate-fade-in font-inter"></div>

				<!-- Main Form (Login / Register) -->
				<form id="authForm" class="space-y-4 font-inter" aria-label="Formulario de autenticación">
					<!-- Register Only Fields -->
					<div id="registerFields" class="hidden space-y-3">
						<div class="grid grid-cols-2 gap-3">
							<div>
								<label for="nombre" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Nombre</label>
								<input type="text" id="nombre" name="nombre" placeholder="Ana" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
							</div>
							<div>
								<label for="apellido" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Apellido</label>
								<input type="text" id="apellido" name="apellido" placeholder="López" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
							</div>
						</div>

						<div class="grid grid-cols-2 gap-3">
							<div>
								<label for="paisSelect" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">País</label>
								<select id="paisSelect" class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
									<option value="">Cargando países...</option>
								</select>
							</div>
							<div>
								<label for="monedaSelect" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Moneda</label>
								<select id="monedaSelect" class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white">
									<option value="">Cargando monedas...</option>
								</select>
							</div>
						</div>
						<div id="catalogStatus" class="hidden text-[11px] p-2 rounded-lg"></div>
						<button id="retryCatalogs" type="button" class="hidden text-xs text-blue-600 dark:text-blue-400 font-semibold hover:underline">Reintentar carga de países y monedas</button>
					</div>

					<!-- Email Field -->
					<div>
						<label for="email" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Correo Electrónico</label>
						<input type="email" id="email" name="email" required placeholder="tu@correo.com" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
					</div>

					<!-- Password Field -->
					<div>
						<div class="flex justify-between items-center mb-1">
							<label for="password" class="block text-xs font-semibold text-gray-700 dark:text-gray-300">Contraseña</label>
							<button id="forgotPasswordBtn" type="button" class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-medium cursor-pointer">
								¿Olvidaste tu contraseña?
							</button>
						</div>
						<div class="relative">
							<input type="password" id="password" name="password" required placeholder="••••••••" class="w-full pl-3.5 pr-11 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
							<button id="togglePassword" type="button" aria-label="Mostrar contraseña" class="absolute inset-y-0 right-0 grid w-11 place-items-center text-gray-400 hover:text-blue-600">
								<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/><circle cx="12" cy="12" r="3"/></svg>
							</button>
						</div>
					</div>

					<!-- Submit Button -->
					<button id="submitButton" type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition shadow-md shadow-blue-600/20 text-sm cursor-pointer">
						Iniciar sesión
					</button>
				</form>

				{GOOGLE_CLIENT_ID && (
					<div id="googleAuthSection" class="space-y-4 font-inter">
						<div class="flex items-center gap-3 text-[11px] uppercase tracking-wider text-gray-400">
							<span class="h-px flex-1 bg-gray-200 dark:bg-gray-800"></span>
							<span>O continúa con</span>
							<span class="h-px flex-1 bg-gray-200 dark:bg-gray-800"></span>
						</div>
						<div id="googleButton" class="flex min-h-11 w-full justify-center"></div>
						<p class="text-center text-[10px] leading-relaxed text-gray-500 dark:text-gray-500">
							Google verifica tu identidad y FinanceAI protege tu sesión.
						</p>
					</div>
				)}

				{GOOGLE_CLIENT_ID && (
					<div id="googleProfilePanel" class="hidden space-y-4 rounded-2xl border border-blue-200 bg-blue-50/70 p-4 font-inter dark:border-blue-900/60 dark:bg-blue-950/30">
						<div>
							<h3 class="text-sm font-bold text-gray-900 dark:text-white">Completa tu perfil</h3>
							<p class="mt-1 text-xs text-gray-600 dark:text-gray-400">Selecciona país y moneda para crear tu cuenta de Google sin asumir tu ubicación.</p>
						</div>
						<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
							<div>
								<label for="googleCountrySelect" class="mb-1 block text-xs font-semibold text-gray-700 dark:text-gray-300">País</label>
								<select id="googleCountrySelect" class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-gray-700 dark:bg-gray-800 dark:text-white">
									<option value="">Selecciona tu país</option>
								</select>
							</div>
							<div>
								<label for="googleCurrencySelect" class="mb-1 block text-xs font-semibold text-gray-700 dark:text-gray-300">Moneda</label>
								<select id="googleCurrencySelect" class="w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-600 dark:border-gray-700 dark:bg-gray-800 dark:text-white">
									<option value="">Selecciona tu moneda</option>
								</select>
							</div>
						</div>
						<div class="flex gap-2">
							<button id="cancelGoogleProfileBtn" type="button" class="flex-1 rounded-xl border border-gray-300 px-3 py-2.5 text-xs font-semibold text-gray-700 hover:bg-white dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800">Cancelar</button>
							<button id="completeGoogleProfileBtn" type="button" class="flex-1 rounded-xl bg-blue-600 px-3 py-2.5 text-xs font-semibold text-white hover:bg-blue-700">Continuar con Google</button>
						</div>
					</div>
				)}

				<!-- Forgot Password Form Panel (Hidden by default) -->
				<div id="forgotPanel" class="hidden space-y-4 font-inter">
					<form id="forgotForm" class="space-y-4">
						<div>
							<label for="forgotEmail" class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Ingresa tu correo para recuperar acceso</label>
							<input type="email" id="forgotEmail" required placeholder="tu@correo.com" class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
						</div>
						<button id="forgotSubmitButton" type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-xl transition text-sm cursor-pointer shadow-md shadow-blue-600/20">
							Enviar enlace de recuperación
						</button>
						<button id="backToLoginBtn" type="button" class="w-full py-2.5 text-xs font-semibold text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition cursor-pointer">
							Volver al inicio de sesión
						</button>
					</form>
				</div>

				<!-- Toggle Mode (Login <-> Register) -->
				<div id="modeToggle" class="text-center pt-2 font-inter">
					<p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">
						<span id="toggleQuestion">¿Aún no tienes cuenta?</span>
						<button id="toggleModeBtn" type="button" class="ml-1 text-blue-600 dark:text-blue-400 font-bold hover:underline cursor-pointer">
							Regístrate
						</button>
					</p>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script define:vars={{ API_URL, GOOGLE_CLIENT_ID }}>
    let registerMode = false;
    let catalogsReady = false;
    let pendingGoogleCredential = '';

    const byId = (id) => document.getElementById(id);
    const form = byId('authForm');
    const submitButton = byId('submitButton');
    const registerFields = byId('registerFields');
    const countrySelect = byId('paisSelect');
    const currencySelect = byId('monedaSelect');
    const catalogStatus = byId('catalogStatus');
    const retryCatalogs = byId('retryCatalogs');
    const alertBox = byId('alertBox');
    const forgotPanel = byId('forgotPanel');
    const forgotForm = byId('forgotForm');
    const forgotSubmitButton = byId('forgotSubmitButton');
    const modeToggle = byId('modeToggle');
    const googleAuthSection = byId('googleAuthSection');
    const googleProfilePanel = byId('googleProfilePanel');
    const googleCountrySelect = byId('googleCountrySelect');
    const googleCurrencySelect = byId('googleCurrencySelect');

    function showAlert(message, isError = true) {
        if (!alertBox) return;
        alertBox.textContent = message;
        alertBox.className = isError
            ? 'p-3.5 rounded-xl text-xs sm:text-sm font-medium bg-red-50 dark:bg-red-950/50 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800'
            : 'p-3.5 rounded-xl text-xs sm:text-sm font-medium bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
        alertBox.classList.remove('hidden');
    }

    function setSession(data) {
        if (data.token) {
            localStorage.setItem('financeai_token', data.token);
            if (data.usuario || data.user || data.email) {
                const userObj = data.usuario || data.user || { email: data.email, nombre: data.nombre };
                localStorage.setItem('financeai_user', JSON.stringify(userObj));
            }
        }
    }

    async function loadCatalogs() {
        if (!countrySelect || !currencySelect) return;
        countrySelect.disabled = true;
        currencySelect.disabled = true;
        catalogStatus.textContent = 'Cargando países y monedas…';
        catalogStatus.className = 'text-[11px] p-2 rounded-lg bg-blue-50 text-blue-800 dark:bg-blue-950/40 dark:text-blue-200';
        catalogStatus.classList.remove('hidden');
        retryCatalogs.classList.add('hidden');

        try {
            const [countriesRes, currenciesRes] = await Promise.all([
                fetch(`${API_URL}/api/v1/catalogos/paises`, { headers: { Accept: 'application/json' } }),
                fetch(`${API_URL}/api/v1/catalogos/monedas`, { headers: { Accept: 'application/json' } }),
            ]);

            if (!countriesRes.ok || !currenciesRes.ok) throw new Error();

            const countries = await countriesRes.json();
            const currencies = await currenciesRes.json();

            countrySelect.innerHTML = '<option value="">Selecciona tu país</option>' + countries.map(c => `<option value="${c.id || c.codigo}">${c.nombre} (${c.codigo})</option>`).join('');
            currencySelect.innerHTML = '<option value="">Selecciona tu moneda</option>' + currencies.map(m => `<option value="${m.id || m.codigo}">${m.nombre} (${m.codigo}) · ${m.simbolo}</option>`).join('');
            if (googleCountrySelect) googleCountrySelect.innerHTML = countrySelect.innerHTML;
            if (googleCurrencySelect) googleCurrencySelect.innerHTML = currencySelect.innerHTML;

            countrySelect.disabled = false;
            currencySelect.disabled = false;
            catalogsReady = true;
            catalogStatus.textContent = 'Catálogos cargados correctamente.';
            catalogStatus.className = 'text-[11px] p-2 rounded-lg bg-emerald-50 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-200';
        } catch {
            catalogStatus.textContent = 'No fue posible cargar los catálogos. Verifica tu conexión.';
            catalogStatus.className = 'text-[11px] p-2 rounded-lg bg-red-50 text-red-800 dark:bg-red-950/40 dark:text-red-200';
            retryCatalogs.classList.remove('hidden');
        }
    }

    async function login(email, password) {
        const response = await fetch(`${API_URL}/api/v1/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ email, password }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.token) {
            throw new Error(data.message || 'Credenciales incorrectas.');
        }
        setSession(data);
    }

    async function submitGoogleCredential(credential, paisId = null, monedaId = null) {
        const response = await fetch(`${API_URL}/api/v1/auth/google`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ credential, paisId, monedaId }),
        });
        const data = await response.json().catch(() => ({}));

        if (response.status === 422 && !paisId && !monedaId) {
            pendingGoogleCredential = credential;
            if (!catalogsReady) await loadCatalogs();
            googleProfilePanel?.classList.remove('hidden');
            googleAuthSection?.classList.add('hidden');
            showAlert(data.message || 'Completa tu país y moneda para continuar.', false);
            return;
        }

        if (!response.ok || !data.token) {
            throw new Error(data.message || 'No fue posible iniciar sesión con Google.');
        }

        pendingGoogleCredential = '';
        setSession(data);
        showAlert('Sesión de Google verificada. Redirigiendo…', false);
        window.setTimeout(() => window.location.replace('/dashboard'), 250);
    }

    async function handleGoogleCredential(response) {
        if (!response?.credential) {
            showAlert('Google no devolvió una credencial válida.');
            return;
        }
        try {
            await submitGoogleCredential(response.credential);
        } catch (error) {
            showAlert(error instanceof Error ? error.message : 'No fue posible iniciar sesión con Google.');
        }
    }

    function initializeGoogleButton() {
        const button = byId('googleButton');
        if (!GOOGLE_CLIENT_ID || !button || !window.google?.accounts?.id) return;

        window.google.accounts.id.initialize({
            client_id: GOOGLE_CLIENT_ID,
            callback: handleGoogleCredential,
            auto_select: false,
            cancel_on_tap_outside: true,
        });
        window.google.accounts.id.renderButton(button, {
            type: 'standard',
            theme: 'outline',
            size: 'large',
            text: 'continue_with',
            shape: 'rectangular',
            logo_alignment: 'left',
            locale: 'es',
            width: Math.min(400, Math.max(240, button.clientWidth)),
        });
    }

    if (GOOGLE_CLIENT_ID) {
        if (window.google?.accounts?.id) {
            initializeGoogleButton();
        } else {
            document.querySelector('script[src*="accounts.google.com/gsi/client"]')
                ?.addEventListener('load', initializeGoogleButton, { once: true });
        }
    }

    function setForgotMode(enabled) {
        form.classList.toggle('hidden', enabled);
        forgotPanel.classList.toggle('hidden', !enabled);
        modeToggle.classList.toggle('hidden', enabled);
        googleAuthSection?.classList.toggle('hidden', enabled);
        if (enabled) googleProfilePanel?.classList.add('hidden');
        alertBox.classList.add('hidden');
        byId('formTitle').textContent = enabled ? 'RECUPERA TU ACCESO' : (registerMode ? 'CREA TU CUENTA' : 'TU ESPACIO FINANCIERO');
        byId('formSubtitle').textContent = enabled
            ? 'Te enviaremos un enlace seguro para restablecer tu contraseña.'
            : (registerMode ? 'Regístrate para optimizar tus finanzas' : 'Accede a tu cuenta');
        if (enabled) {
            byId('forgotEmail').value = byId('email').value.trim();
            byId('forgotEmail').focus();
        }
    }

    byId('forgotPasswordBtn')?.addEventListener('click', () => setForgotMode(true));
    byId('backToLoginBtn')?.addEventListener('click', () => setForgotMode(false));

    forgotForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const email = byId('forgotEmail').value.trim();
        forgotSubmitButton.disabled = true;
        forgotSubmitButton.textContent = 'Enviando…';

        try {
            const response = await fetch(`${API_URL}/api/v1/auth/forgot-password`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ email }),
            });
            const data = await response.json().catch(() => ({}));
            if (!response.ok) {
                throw new Error(data.message || 'No fue posible enviar el enlace de recuperación.');
            }
            showAlert(data.message || 'Si el correo está registrado, recibirás un enlace de recuperación seguro.', false);
            forgotForm.reset();
        } catch (error) {
            showAlert(error instanceof Error ? error.message : 'No fue posible procesar la solicitud.');
        } finally {
            forgotSubmitButton.disabled = false;
            forgotSubmitButton.textContent = 'Enviar enlace de recuperación';
        }
    });

    byId('toggleModeBtn')?.addEventListener('click', () => {
        registerMode = !registerMode;
        registerFields.classList.toggle('hidden', !registerMode);
        byId('formTitle').textContent = registerMode ? 'CREA TU CUENTA' : 'TU ESPACIO FINANCIERO';
        byId('formSubtitle').textContent = registerMode ? 'Regístrate para optimizar tus finanzas' : 'Accede a tu cuenta';
        byId('toggleQuestion').textContent = registerMode ? '¿Ya tienes cuenta?' : '¿Aún no tienes cuenta?';
        byId('toggleModeBtn').textContent = registerMode ? 'Inicia sesión' : 'Regístrate';
        submitButton.textContent = registerMode ? 'Crear cuenta' : 'Iniciar sesión';
        byId('forgotPasswordBtn').classList.toggle('hidden', registerMode);
        if (registerMode && !catalogsReady) loadCatalogs();
    });

    retryCatalogs?.addEventListener('click', loadCatalogs);

    byId('cancelGoogleProfileBtn')?.addEventListener('click', () => {
        pendingGoogleCredential = '';
        googleProfilePanel?.classList.add('hidden');
        googleAuthSection?.classList.remove('hidden');
        alertBox.classList.add('hidden');
    });

    byId('completeGoogleProfileBtn')?.addEventListener('click', async () => {
        if (!pendingGoogleCredential || !googleCountrySelect?.value || !googleCurrencySelect?.value) {
            showAlert('Selecciona tu país y moneda para continuar con Google.');
            return;
        }

        const button = byId('completeGoogleProfileBtn');
        button.disabled = true;
        button.textContent = 'Verificando…';
        try {
            await submitGoogleCredential(
                pendingGoogleCredential,
                Number(googleCountrySelect.value),
                Number(googleCurrencySelect.value),
            );
        } catch (error) {
            showAlert(error instanceof Error ? error.message : 'No fue posible crear la cuenta de Google.');
        } finally {
            button.disabled = false;
            button.textContent = 'Continuar con Google';
        }
    });

    byId('togglePassword')?.addEventListener('click', () => {
        const passwordInput = byId('password');
        const showing = passwordInput.type === 'text';
        passwordInput.type = showing ? 'password' : 'text';
        byId('togglePassword').setAttribute('aria-label', showing ? 'Mostrar contraseña' : 'Ocultar contraseña');
    });

    form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const email = byId('email').value.trim();
        const password = byId('password').value;
        submitButton.disabled = true;
        submitButton.textContent = 'Procesando…';

        try {
            if (registerMode) {
                if (!countrySelect.value || !currencySelect.value) {
                    throw new Error('Por favor selecciona tu país y tu moneda.');
                }
                const nombre = byId('nombre').value.trim();
                const apellido = byId('apellido').value.trim();
                if (!nombre || !apellido) {
                    throw new Error('Por favor ingresa tu nombre y apellido.');
                }

                const registerRes = await fetch(`${API_URL}/api/v1/auth/register`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                    body: JSON.stringify({
                        nombre: `${nombre} ${apellido}`,
                        email,
                        password,
                        paisId: Number(countrySelect.value),
                        monedaId: Number(currencySelect.value),
                    }),
                });
                const regData = await registerRes.json().catch(() => ({}));
                if (!registerRes.ok) {
                    throw new Error(regData.message || 'No fue posible crear la cuenta.');
                }
                await login(email, password);
                showAlert('Cuenta creada exitosamente. Redirigiendo…', false);
            } else {
                await login(email, password);
                showAlert('Sesión iniciada. Redirigiendo…', false);
            }
            window.setTimeout(() => window.location.replace('/dashboard'), 250);
        } catch (error) {
            showAlert(error instanceof Error ? error.message : 'Error en la solicitud.');
        } finally {
            submitButton.disabled = false;
            submitButton.textContent = registerMode ? 'Crear cuenta' : 'Iniciar sesión';
        }
    });
</script>
