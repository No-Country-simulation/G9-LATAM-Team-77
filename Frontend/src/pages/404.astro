---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Página No Encontrada | FinanceAI" description="La página que buscas no existe o ha sido movida. Regresa a FinanceAI para continuar administrando tus finanzas con inteligencia artificial.">
	<main class="w-full flex-grow flex items-center justify-center min-h-[calc(100vh-140px)] relative overflow-hidden bg-gray-50 dark:bg-gray-950 font-inter px-3.5 sm:px-4 py-8 sm:py-16">
		
		<!-- Fondos difuminados decorativos -->
		<div class="absolute inset-0 bg-gradient-to-br from-blue-900/20 via-gray-950/80 to-gray-950 pointer-events-none"></div>
		<div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>
		<div class="absolute -bottom-32 -right-32 w-96 h-96 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none"></div>

		<div class="relative z-10 bg-white/95 dark:bg-gray-900/95 backdrop-blur-2xl rounded-2xl sm:rounded-3xl shadow-2xl p-6 sm:p-12 max-w-lg w-full mx-auto border border-gray-200 dark:border-gray-800 text-center animate-scale-in">
			
			<!-- Badge de Error -->
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/60 mb-5">
				<span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
				<span>Código de Error HTTP 404</span>
			</div>

			<!-- Icono Gráfico -->
			<div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto bg-gray-100 dark:bg-gray-800 text-blue-600 dark:text-blue-400 rounded-3xl flex items-center justify-center mb-6 shadow-inner border border-gray-200 dark:border-gray-700">
				<svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
				</svg>
			</div>

			<!-- Título H1 Único -->
			<h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white mb-3 font-josefin">
				Página No Encontrada
			</h1>

			<!-- Explicación amigable -->
			<p class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm mb-8 leading-relaxed max-w-md mx-auto font-inter">
				El recurso financiero o la ruta solicitada no se encuentra disponible, ha sido movida o la dirección ingresada contiene un error tipográfico.
			</p>

			<!-- Acciones Rápidas -->
			<div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-6">
				<a href="/dashboard" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl transition shadow-md hover:shadow-lg text-xs sm:text-sm cursor-pointer">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
					Ir al Panel Principal
				</a>
				<a href="/" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold py-3 px-6 rounded-xl transition text-xs sm:text-sm border border-gray-200 dark:border-gray-700 cursor-pointer">
					Volver al Inicio
				</a>
			</div>

			<!-- Enlaces Útiles -->
			<div class="pt-6 border-t border-gray-100 dark:border-gray-800 text-xs text-gray-500 dark:text-gray-400">
				<p class="mb-2 font-medium">¿Buscabas alguna de estas secciones?</p>
				<div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs font-semibold text-blue-600 dark:text-blue-400">
					<a href="/historial" class="hover:underline">Historial Financiero</a>
					<span>•</span>
					<a href="/terminos" class="hover:underline">Términos y Condiciones</a>
					<span>•</span>
					<a href="/privacidad" class="hover:underline">Aviso de Privacidad</a>
				</div>
			</div>
		</div>
	</main>
</Layout>
