---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';
---

<Layout title="Restablecer contraseña | FinanceAI">
    <main class="relative isolate flex min-h-[calc(100vh-65px)] items-center overflow-hidden px-4 py-10 sm:px-6">
        <div aria-hidden="true" class="pointer-events-none absolute -left-24 top-1/3 -z-10 h-72 w-72 rounded-full bg-blue-500/10 blur-3xl"></div>
        <div aria-hidden="true" class="pointer-events-none absolute -right-24 top-10 -z-10 h-80 w-80 rounded-full bg-cyan-400/10 blur-3xl"></div>

        <section class="ui-enter surface-card mx-auto w-full max-w-lg rounded-[2rem] p-7 sm:p-10">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-blue-600/10 text-2xl text-blue-600 dark:text-blue-400" aria-hidden="true">🔐</div>
            <div class="mt-5 text-center">
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-blue-600 dark:text-blue-400">Acceso seguro</p>
                <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white">Crea una nueva contraseña</h1>
                <p class="mt-2 text-sm leading-relaxed text-gray-500 dark:text-gray-400">El enlace es personal, expira pronto y solo puede utilizarse una vez.</p>
            </div>

            <div id="resetAlert" role="alert" aria-live="polite" class="mt-6 hidden rounded-xl border p-3.5 text-sm"></div>

            <form id="resetForm" class="mt-6 space-y-4" aria-label="Restablecer contraseña">
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300">
                    Nueva contraseña
                    <input id="newPassword" type="password" required minlength="8" maxlength="128" autocomplete="new-password" class="mt-1 w-full rounded-xl border border-gray-300 bg-gray-50 px-3.5 py-3 text-sm text-gray-900 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-gray-700 dark:bg-gray-950 dark:text-white" />
                </label>
                <label class="block text-xs font-semibold text-gray-700 dark:text-gray-300">
                    Confirmar contraseña
                    <input id="confirmPassword" type="password" required minlength="8" maxlength="128" autocomplete="new-password" class="mt-1 w-full rounded-xl border border-gray-300 bg-gray-50 px-3.5 py-3 text-sm text-gray-900 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 dark:border-gray-700 dark:bg-gray-950 dark:text-white" />
                </label>
                <button id="resetSubmitBtn" type="submit" class="w-full rounded-xl bg-gradient-to-r from-blue-600 to-blue-700 px-4 py-3.5 text-sm font-bold text-white shadow-lg shadow-blue-600/20 transition hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:translate-y-0">
                    Guardar nueva contraseña
                </button>
            </form>

            <a href="/login" class="mt-6 block text-center text-sm font-semibold text-blue-600 hover:underline dark:text-blue-400">Volver al inicio de sesión</a>
        </section>
    </main>
</Layout>

<script define:vars={{ API_URL }}>
    const form = document.getElementById('resetForm');
    const alertBox = document.getElementById('resetAlert');
    const submitButton = document.getElementById('resetSubmitBtn');
    const token = new URLSearchParams(window.location.search).get('token')?.trim() || '';

    function showAlert(message, error = true) {
        alertBox.textContent = message;
        alertBox.className = `mt-6 rounded-xl border p-3.5 text-sm ${error
            ? 'border-red-200 bg-red-50 text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-200'
            : 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200'}`;
    }

    async function readJson(response) {
        try {
            return await response.json();
        } catch {
            return {};
        }
    }

    if (!token) {
        showAlert('El enlace de recuperación no es válido. Solicita uno nuevo desde el inicio de sesión.');
        form.classList.add('hidden');
    }

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const newPassword = document.getElementById('newPassword').value;
        const confirmation = document.getElementById('confirmPassword').value;

        if (newPassword.length < 8 || newPassword.length > 128) {
            showAlert('La contraseña debe tener entre 8 y 128 caracteres.');
            return;
        }
        if (newPassword !== confirmation) {
            showAlert('Las contraseñas no coinciden.');
            return;
        }

        submitButton.disabled = true;
        submitButton.textContent = 'Actualizando…';

        try {
            const response = await fetch(`${API_URL}/api/v1/auth/reset-password`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ token, newPassword }),
            });
            const data = await readJson(response);
            if (!response.ok) {
                throw new Error(data.message || 'El enlace no es válido, expiró o ya fue utilizado.');
            }

            form.classList.add('hidden');
            showAlert(data.message || 'Contraseña actualizada. Redirigiendo al inicio de sesión…', false);
            window.setTimeout(() => window.location.replace('/login'), 1800);
        } catch (error) {
            showAlert(error instanceof Error ? error.message : 'No fue posible actualizar la contraseña.');
            submitButton.disabled = false;
            submitButton.textContent = 'Guardar nueva contraseña';
        }
    });
</script>
