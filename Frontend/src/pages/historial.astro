---
import Layout from '../layouts/Layout.astro';

// Mocked Data
const financialScore = 780;
const debtLevel = 35; // percentage
const totalGastos = 12500;
const totalIngresos = 30000;

const transactions = [
  { id: 1, date: '2026-08-18', description: 'Pago de Hipoteca', category: 'Vivienda', amount: -5000, status: 'Completado' },
  { id: 2, date: '2026-08-17', description: 'Salario Mensual', category: 'Ingreso', amount: 30000, status: 'Completado' },
  { id: 3, date: '2026-08-15', description: 'Compra Supermercado', category: 'Alimentación', amount: -1200, status: 'Completado' },
  { id: 4, date: '2026-08-12', description: 'Suscripción Netflix', category: 'Ocio', amount: -250, status: 'Completado' },
  { id: 5, date: '2026-08-10', description: 'Seguro Auto', category: 'Transporte', amount: -800, status: 'Pendiente' },
];

const debtLevelColor = debtLevel < 30 ? 'bg-green-500' : debtLevel < 60 ? 'bg-yellow-500' : 'bg-red-500';
const scoreColor = financialScore > 750 ? 'text-green-600' : financialScore > 600 ? 'text-yellow-600' : 'text-red-600';
---

<Layout title="Historial Financiero | FinanceAl">
    <div class="w-full max-w-7xl mx-auto p-4 md:p-8 flex flex-col gap-8">
        
        <!-- Header Section -->
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
            <div>
                <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">Historial Financiero</h1>
                <p class="text-sm text-gray-500 mt-1">Revisa tus transacciones y métricas financieras.</p>
            </div>
            <div class="flex items-center space-x-3">
                <button aria-label="Exportar historial a PDF" class="px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    Exportar PDF
                </button>
                <button aria-label="Añadir nueva transacción" class="px-4 py-2 bg-blue-600 border border-transparent rounded-lg text-sm font-medium text-white hover:bg-blue-700 transition-all shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Nueva Transacción
                </button>
            </div>
        </header>

        <!-- Summary Cards -->
        <section aria-label="Resumen Financiero" role="region" class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Score Financiero -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 w-24 h-24 bg-blue-50 rounded-full opacity-50 group-hover:scale-110 transition-transform"></div>
                <h2 class="text-sm font-semibold text-gray-500 mb-1" id="score-label">Score Financiero</h2>
                <div class="flex items-end space-x-2">
                    <span aria-labelledby="score-label" class={`text-4xl font-black ${scoreColor}`}>{financialScore}</span>
                    <span class="text-sm text-gray-400 mb-1">/ 850</span>
                </div>
                <p class="text-xs text-gray-400 mt-3">Tu puntuación es excelente. ¡Sigue así!</p>
            </div>

            <!-- Nivel de Endeudamiento -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="flex justify-between items-center mb-1">
                    <h2 class="text-sm font-semibold text-gray-500" id="debt-label">Nivel de Endeudamiento</h2>
                    <span class="text-sm font-bold text-gray-900">{debtLevel}%</span>
                </div>
                <div class="w-full bg-gray-100 h-2 rounded-full mt-4 overflow-hidden" aria-hidden="true">
                    <div class={`h-full rounded-full transition-all duration-1000 ${debtLevelColor}`} style={`width: ${debtLevel}%`}></div>
                </div>
                <p class="text-xs text-gray-400 mt-3">Relación deuda/ingreso saludable.</p>
            </div>

            <!-- Balance Mensual -->
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <h2 class="text-sm font-semibold text-gray-500 mb-1">Balance Mensual</h2>
                <div class="flex flex-col">
                    <span class="text-2xl font-bold text-gray-900">${(totalIngresos - totalGastos).toLocaleString()}</span>
                    <div class="flex items-center space-x-4 mt-2">
                        <div class="flex items-center space-x-1">
                            <div class="w-2 h-2 rounded-full bg-green-500"></div>
                            <span class="text-xs text-gray-500">Ingresos: ${totalIngresos.toLocaleString()}</span>
                        </div>
                        <div class="flex items-center space-x-1">
                            <div class="w-2 h-2 rounded-full bg-red-500"></div>
                            <span class="text-xs text-gray-500">Gastos: ${totalGastos.toLocaleString()}</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Transactions Table -->
        <section aria-label="Historial de Transacciones" role="region" class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-5 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-center gap-4">
                <h3 class="text-lg font-bold text-gray-900">Transacciones Recientes</h3>
                <div class="flex space-x-2 w-full sm:w-auto">
                    <input type="text" placeholder="Buscar..." aria-label="Buscar transacciones" class="w-full sm:w-64 px-4 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all">
                    <select aria-label="Filtrar por categoría" class="px-4 py-2 border border-gray-200 rounded-lg text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all text-gray-600">
                        <option value="">Todas</option>
                        <option value="Ingreso">Ingresos</option>
                        <option value="Gasto">Gastos</option>
                    </select>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" aria-live="polite">
                    <thead>
                        <tr class="bg-gray-50/50 text-gray-500 text-xs uppercase tracking-wider">
                            <th scope="col" class="px-6 py-4 font-semibold rounded-tl-lg">Descripción</th>
                            <th scope="col" class="px-6 py-4 font-semibold">Categoría</th>
                            <th scope="col" class="px-6 py-4 font-semibold">Fecha</th>
                            <th scope="col" class="px-6 py-4 font-semibold">Estado</th>
                            <th scope="col" class="px-6 py-4 font-semibold text-right rounded-tr-lg">Monto</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        {transactions.map((tx) => (
                            <tr class="hover:bg-gray-50/80 transition-colors group">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="font-medium text-gray-900 group-hover:text-blue-600 transition-colors">{tx.description}</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                        {tx.category}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-gray-500">
                                    {new Date(tx.date).toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${tx.status === 'Completado' ? 'bg-green-50 text-green-700' : 'bg-yellow-50 text-yellow-700'}`}>
                                        <span class={`w-1.5 h-1.5 rounded-full mr-1.5 ${tx.status === 'Completado' ? 'bg-green-500' : 'bg-yellow-500'}`}></span>
                                        {tx.status}
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right font-semibold">
                                    <span class={tx.amount > 0 ? 'text-green-600' : 'text-gray-900'}>
                                        {tx.amount > 0 ? '+' : ''}{tx.amount.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' })}
                                    </span>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            
            <div class="px-6 py-4 border-t border-gray-100 bg-gray-50/30 flex justify-between items-center">
                <span class="text-xs text-gray-500">Mostrando {transactions.length} resultados</span>
                <div class="flex space-x-1">
                    <button aria-label="Página anterior" disabled class="px-3 py-1 border border-gray-200 rounded text-sm text-gray-400 bg-white cursor-not-allowed">Anterior</button>
                    <button aria-label="Página siguiente" class="px-3 py-1 border border-gray-200 rounded text-sm text-gray-700 bg-white hover:bg-gray-50 transition-colors">Siguiente</button>
                </div>
            </div>
        </section>

    </div>
</Layout>

<script is:inline>
    // ─── Proteger Historial: Redirigir a /login si no ha iniciado sesión ───
    const token = localStorage.getItem('financeai_token');
    if (!token) {
        window.location.href = '/';
    }
</script>
