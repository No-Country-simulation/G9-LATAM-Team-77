---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';
---

<Layout title="Historial de Análisis | FinanceAI" description="Consulta tu registro histórico de evaluaciones de salud financiera almacenadas por FinanceAI.">
    <!-- Guardia de Protección de Ruta Seguro -->
    <script is:inline>
        if (!localStorage.getItem('financeai_token')) {
            window.location.replace('/login');
        }
        window.addEventListener('pageshow', function(e) {
            if (e.persisted && !localStorage.getItem('financeai_token')) {
                window.location.replace('/login');
            }
        });
    </script>

    <div class="w-full max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6 md:py-8 flex flex-col gap-5 font-inter">

        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-gray-200 dark:border-gray-800 pb-4">
            <div>
                <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-gray-900 dark:text-white font-josefin">
                    Historial de Evaluaciones
                </h1>
                <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 font-inter">
                    Registro real de análisis de salud financiera asociados a tu cuenta.
                </p>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" id="btnExportHistorialCsv" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm shadow-emerald-600/20 cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Exportar CSV
                </button>
                <a href="/dashboard" class="px-3.5 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-xl text-xs font-bold transition">
                    &larr; Volver al Dashboard
                </a>
            </div>
        </div>

        <!-- Metric Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div class="p-4 bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm">
                <p class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Total de Evaluaciones</p>
                <p id="totalEvaluacionesCount" class="text-2xl font-black text-gray-900 dark:text-white font-mono mt-1">0</p>
            </div>
            <div class="p-4 bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm">
                <p class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Salud Financiera Promedio</p>
                <p id="promedioSaludScore" class="text-2xl font-black text-emerald-600 dark:text-emerald-400 font-mono mt-1">--</p>
            </div>
            <div class="p-4 bg-white dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm">
                <p class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Último Estado Registrado</p>
                <p id="ultimoEstadoBadge" class="text-sm font-bold text-blue-600 dark:text-blue-400 mt-2">Sin registros</p>
            </div>
        </div>

        <!-- Search & Filter Controls -->
        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
            <div class="relative flex-1 max-w-md">
                <input type="text" id="searchInput" placeholder="Buscar por perfil o notas…" class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white" />
                <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5 sm:top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <div class="flex items-center gap-2">
                <select id="filterPerfil" class="px-3 py-2 text-xs bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl text-gray-700 dark:text-gray-300 font-semibold focus:outline-none focus:ring-2 focus:ring-blue-600">
                    <option value="ALL">Todos los perfiles</option>
                    <option value="Excelente">Excelente / Saludable</option>
                    <option value="Moderado">Moderado</option>
                    <option value="Riesgo">En riesgo / Crítico</option>
                </select>
                <button id="btnReloadHistory" type="button" class="p-2 text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl transition cursor-pointer" title="Recargar">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                </button>
            </div>
        </div>

        <!-- Table Container -->
        <div class="bg-white dark:bg-gray-900 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs sm:text-sm">
                    <thead class="bg-gray-50 dark:bg-gray-800/60 border-b border-gray-100 dark:border-gray-800 text-[11px] uppercase font-bold text-gray-500 dark:text-gray-400">
                        <tr>
                            <th class="px-4 py-3">Fecha y Hora</th>
                            <th class="px-4 py-3">Ingreso Base</th>
                            <th class="px-4 py-3">Total Gastos</th>
                            <th class="px-4 py-3">Ahorro Estimado</th>
                            <th class="px-4 py-3">Endeudamiento</th>
                            <th class="px-4 py-3 text-center">Salud Financiera</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody" class="divide-y divide-gray-100 dark:divide-gray-800">
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
                                <div class="flex flex-col items-center gap-2">
                                    <div class="w-6 h-6 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
                                    <span>Cargando historial de evaluaciones…</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</Layout>

<script define:vars={{ API_URL }}>
    (function () {
        const token = localStorage.getItem('financeai_token');
        let historyData = [];
        let activeCurrency = 'HNL';
        let activeCurrencySymbol = 'L';

        const tableBody = document.getElementById('historyTableBody');
        const countDisplay = document.getElementById('totalEvaluacionesCount');
        const avgDisplay = document.getElementById('promedioSaludScore');
        const lastStatusDisplay = document.getElementById('ultimoEstadoBadge');
        const searchInput = document.getElementById('searchInput');
        const filterPerfil = document.getElementById('filterPerfil');
        const btnReload = document.getElementById('btnReloadHistory');
        const btnExportCsv = document.getElementById('btnExportHistorialCsv');

        function clearSessionAndRedirect() {
            localStorage.removeItem('financeai_token');
            localStorage.removeItem('financeai_user');
            window.location.replace('/login');
        }

        async function loadProfile() {
            if (!token) return;
            const response = await fetch(`${API_URL}/api/v1/users/profile`, {
                headers: { 'Authorization': `Bearer ${token}`, Accept: 'application/json' }
            });
            if (response.status === 401) return clearSessionAndRedirect();
            if (!response.ok) return;
            const profile = await response.json();
            activeCurrency = profile.codigoMoneda || 'HNL';
            activeCurrencySymbol = profile.simboloMoneda || 'L';
        }

        async function loadHistory() {
            if (!token) return;
            try {
                const res = await fetch(`${API_URL}/api/v1/historial-analisis`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });

                if (res.status === 401) return clearSessionAndRedirect();
                if (res.ok) {
                    historyData = await res.json();
                    renderTable(historyData);
                    updateMetrics(historyData);
                } else {
                    throw new Error();
                }
            } catch {
                if (tableBody) {
                    tableBody.innerHTML = `
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
                                <p class="text-sm font-semibold">No se encontraron evaluaciones registradas aún.</p>
                                <a href="/dashboard" class="mt-2 inline-block text-xs text-blue-600 dark:text-blue-400 font-bold hover:underline">Realizar un análisis en el Dashboard &rarr;</a>
                            </td>
                        </tr>
                    `;
                }
            }
        }
        loadProfile().catch(() => {}).finally(loadHistory);
        btnReload?.addEventListener('click', loadHistory);

        function updateMetrics(items) {
            if (!Array.isArray(items) || items.length === 0) {
                if (countDisplay) countDisplay.textContent = '0';
                if (avgDisplay) avgDisplay.textContent = '--';
                if (lastStatusDisplay) lastStatusDisplay.textContent = 'Sin registros';
                return;
            }

            if (countDisplay) countDisplay.textContent = items.length.toString();

            let totalScores = 0;
            items.forEach(it => {
                const prob = Number(it.probabilidad || 0);
                const score = prob > 1 ? prob : Math.round(prob * 100);
                totalScores += score;
            });
            const avg = Math.round(totalScores / items.length);
            if (avgDisplay) avgDisplay.textContent = `${avg}/100`;

            const lastItem = items[0];
            const perfil = lastItem.perfilFinanciero || 'No disponible';
            if (lastStatusDisplay) {
                lastStatusDisplay.textContent = perfil;
                if (perfil.toLowerCase().includes('excelente') || perfil.toLowerCase().includes('saludable')) {
                    lastStatusDisplay.className = 'text-sm font-bold text-emerald-600 dark:text-emerald-400 mt-2';
                } else if (perfil.toLowerCase().includes('moderado')) {
                    lastStatusDisplay.className = 'text-sm font-bold text-amber-600 dark:text-amber-400 mt-2';
                } else {
                    lastStatusDisplay.className = 'text-sm font-bold text-red-600 dark:text-red-400 mt-2';
                }
            }
        }

        function renderTable(items) {
            if (!tableBody) return;
            if (!Array.isArray(items) || items.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
                            <p class="text-sm font-semibold">No hay análisis que coincidan con la búsqueda.</p>
                        </td>
                    </tr>
                `;
                return;
            }

            const fmt = (v) => `${activeCurrencySymbol} ${Number(v || 0).toLocaleString('es-HN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);

            tableBody.innerHTML = items.map(item => {
                const dateStr = item.fechaHora ? new Date(item.fechaHora).toLocaleString('es-HN') : 'Reciente';
                const ingreso = fmt(item.ingresoMensual);
                const gastos = fmt(item.totalGastos);
                const ahorro = fmt(item.ahorroEstimado);
                const endeudamiento = `${Number(item.nivelEndeudamiento || 0)}%`;

                const prob = Number(item.probabilidad || 0);
                const score = prob > 1 ? prob : Math.round(prob * 100);
                const perfil = item.perfilFinanciero || 'No disponible';

                let badgeClass = 'bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800';
                if (score < 45 || perfil.toLowerCase().includes('riesgo')) {
                    badgeClass = 'bg-red-100 dark:bg-red-950 text-red-700 dark:text-red-300 border-red-300 dark:border-red-800';
                } else if (score < 75 || perfil.toLowerCase().includes('moderado')) {
                    badgeClass = 'bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300 border-amber-300 dark:border-amber-800';
                }

                return `
                    <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-800/40 transition-colors">
                        <td class="px-4 py-3 font-mono text-xs text-gray-600 dark:text-gray-300">${escapeHtml(dateStr)}</td>
                        <td class="px-4 py-3 font-mono font-semibold text-gray-900 dark:text-white">${ingreso}</td>
                        <td class="px-4 py-3 font-mono text-red-600 dark:text-red-400">${gastos}</td>
                        <td class="px-4 py-3 font-mono text-emerald-600 dark:text-emerald-400 font-semibold">${ahorro}</td>
                        <td class="px-4 py-3 font-mono text-gray-600 dark:text-gray-300">${endeudamiento}</td>
                        <td class="px-4 py-3 text-center">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold border ${badgeClass}">
                                <span>${score}/100</span>
                                <span>·</span>
                                <span>${escapeHtml(perfil)}</span>
                            </span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // ─── Filtros & Búsqueda ───
        function applyFilters() {
            const query = (searchInput?.value || '').toLowerCase().trim();
            const perfilVal = filterPerfil?.value || 'ALL';

            const filtered = historyData.filter(item => {
                const matchQuery = !query || (item.perfilFinanciero && item.perfilFinanciero.toLowerCase().includes(query)) || (item.fechaHora && item.fechaHora.includes(query));
                let matchPerfil = true;
                const profile = String(item.perfilFinanciero || '').toLowerCase();
                if (perfilVal === 'Excelente') matchPerfil = profile.includes('excelente') || profile.includes('saludable');
                else if (perfilVal === 'Moderado') matchPerfil = profile.includes('moderado');
                else if (perfilVal === 'Riesgo') matchPerfil = profile.includes('riesgo') || profile.includes('crítico') || profile.includes('critico');
                return matchQuery && matchPerfil;
            });

            renderTable(filtered);
        }

        searchInput?.addEventListener('input', applyFilters);
        filterPerfil?.addEventListener('change', applyFilters);

        // ─── Exportar historial real como CSV ───
        btnExportCsv?.addEventListener('click', () => {
            if (!historyData.length) {
                if (window.showToast) window.showToast('Sin datos', 'No hay análisis para exportar.', 'ℹ️');
                return;
            }
            const csvCell = (value) => `"${String(value ?? '').replace(/"/g, '""')}"`;
            const headers = ['Fecha', 'Perfil', 'Score', 'Ingreso', 'Gastos', 'Ahorro', 'Endeudamiento', 'Frecuencia'];
            const rows = historyData.map((item) => {
                const probability = Number(item.probabilidad || 0);
                const score = probability > 1 ? probability : Math.round(probability * 100);
                return [item.fechaHora, item.perfilFinanciero, score, item.ingresoMensual, item.totalGastos, item.ahorroEstimado, item.nivelEndeudamiento, item.frecuenciaAhorro];
            });
            const csv = '\uFEFF' + [headers, ...rows].map((row) => row.map(csvCell).join(',')).join('\r\n');
            const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
            const link = document.createElement('a');
            link.href = url;
            link.download = `FinanceAI_historial_${activeCurrency}.csv`;
            link.click();
            URL.revokeObjectURL(url);
            if (window.showToast) window.showToast('Historial exportado', 'El archivo CSV se descargó correctamente.', '✅');
        });
    })();
</script>
