---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
const hasServerSession = !!session;
---

<Layout title="Historial Financiero | FinanceAI">
    <!-- Guardia de Protección de Ruta Seguro -->
    <script define:vars={{ hasServerSession }}>
        if (!hasServerSession && !localStorage.getItem('financeai_token')) {
            window.location.replace('/login');
        }
    </script>

    <!-- Chart.js CDN -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <div class="w-full max-w-7xl mx-auto px-4 py-6 md:py-8 flex flex-col gap-6 font-inter">
        
        <!-- Header Section -->
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-200 dark:border-gray-800 pb-4">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white tracking-tight font-josefin">Historial Financiero</h1>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Evolución temporal con picos y tendencias, filtros de calendario por mes/rango y gestión del historial.</p>
            </div>
            
            <!-- Actions -->
            <div class="flex items-center flex-wrap gap-2.5">
                <button id="btnExportExcel" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold shadow-sm transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Exportar a Excel
                </button>
                <button id="btnExportPdf" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-gray-900 dark:bg-gray-100 hover:bg-black dark:hover:bg-white text-white dark:text-gray-900 rounded-xl text-xs font-semibold shadow-sm transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                    Imprimir Reporte
                </button>
                <button id="btnOpenClearHistoryModal" class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-red-50 dark:bg-red-950/40 hover:bg-red-100 dark:hover:bg-red-900/60 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800/60 rounded-xl text-xs font-semibold transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    Borrar Todo el Historial
                </button>
            </div>
        </header>

        <!-- KPI Summary Cards -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </div>
                <div>
                    <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider">Total Ingresos</span>
                    <h3 id="statTotalIngresos" class="text-2xl font-bold text-gray-900 dark:text-white">$0</h3>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
                </div>
                <div>
                    <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider">Total Gastos</span>
                    <h3 id="statTotalGastos" class="text-2xl font-bold text-gray-900 dark:text-white">$0</h3>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </div>
                <div>
                    <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider">Balance Neto</span>
                    <h3 id="statBalanceNeto" class="text-2xl font-bold text-gray-900 dark:text-white">$0</h3>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                </div>
                <div>
                    <span class="text-xs text-gray-500 font-semibold uppercase tracking-wider">Transacciones</span>
                    <h3 id="statTotalTransacciones" class="text-2xl font-bold text-gray-900 dark:text-white">0</h3>
                </div>
            </div>
        </section>

        <!-- GRÁFICA MULTI-LÍNEA CON PICOS Y FLUCTUACIONES TEMPORALES -->
        <section class="bg-white dark:bg-gray-900 p-6 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-gray-100 dark:border-gray-800 pb-3">
                <div>
                    <h2 class="text-lg font-bold text-gray-900 dark:text-white font-josefin flex items-center gap-2">
                        <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
                        Evolución Comparativa y Fluctuación de Flujos
                    </h2>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Líneas de gastos, necesidades, estilo de vida e ingresos con picos y valles temporales.</p>
                </div>

                <!-- Selector de Granularidad de Tiempo -->
                <div class="flex items-center gap-1.5 p-1 bg-gray-100 dark:bg-gray-800 rounded-2xl text-xs font-semibold">
                    <button id="btnGranularityDay" class="px-3 py-1.5 rounded-xl bg-white dark:bg-gray-900 text-blue-600 dark:text-blue-400 shadow-sm transition">Por Día</button>
                    <button id="btnGranularityWeek" class="px-3 py-1.5 rounded-xl text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition">Por Semana</button>
                    <button id="btnGranularityMonth" class="px-3 py-1.5 rounded-xl text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition">Por Mes</button>
                </div>
            </div>

            <!-- Canvas de la Gráfica de Picos -->
            <div class="h-72 w-full relative">
                <canvas id="multiLinePeaksChart"></canvas>
            </div>
        </section>

        <!-- FILTROS AVANZADOS CON CALENDARIOS (Mes Específico & Rango Inicio-Fin limitado a 2 años) -->
        <section class="bg-white dark:bg-gray-900 p-5 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
                <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                    Filtrar Histórico (Máximo 2 Años Atrás)
                </h3>
                <button id="btnResetFilters" class="text-xs text-blue-600 hover:underline">Restablecer filtros</button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 text-xs">
                
                <!-- 1. Calendario de Mes Específico -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">
                        Seleccionar Mes
                    </label>
                    <input type="month" id="filterMonthPicker"
                        class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-medium focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>

                <!-- 2. Rango Específico: Fecha Inicio -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">
                        Rango: Fecha Inicio
                    </label>
                    <input type="date" id="filterDateStart"
                        class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-medium focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>

                <!-- 3. Rango Específico: Fecha Fin -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">
                        Rango: Fecha Fin
                    </label>
                    <input type="date" id="filterDateEnd"
                        class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-medium focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>

                <!-- 4. Tipo de Flujo -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">Tipo de Flujo</label>
                    <select id="filterType" class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white outline-none">
                        <option value="all">Ingresos y Gastos</option>
                        <option value="INCOME">Solo Ingresos</option>
                        <option value="EXPENSE">Solo Gastos</option>
                    </select>
                </div>

                <!-- 5. Categoría -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">Categoría</label>
                    <select id="filterCategory" class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white outline-none">
                        <option value="all">Todas las Categorías</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- Gráfica de Distribución por Categoría y Tabla de Transacciones -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Donut Categorías (4 Cols) -->
            <div class="lg:col-span-4 bg-white dark:bg-gray-900 p-6 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex flex-col justify-between">
                <h3 class="text-sm font-bold text-gray-900 dark:text-white font-josefin mb-3">Distribución por Categorías</h3>
                <div class="h-56 relative flex items-center justify-center">
                    <canvas id="categoryDonutChart"></canvas>
                </div>
                <div id="categoryLegend" class="mt-4 space-y-1.5 text-xs max-h-32 overflow-y-auto pr-1"></div>
            </div>

            <!-- Tabla de Transacciones (8 Cols) -->
            <div class="lg:col-span-8 bg-white dark:bg-gray-900 rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden flex flex-col">
                <div class="p-5 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center">
                    <h3 class="text-sm font-bold text-gray-900 dark:text-white font-josefin">Movimientos Registrados</h3>
                    <span id="txFilteredCount" class="text-xs text-gray-500">Mostrando 0 transacciones</span>
                </div>

                <div class="overflow-x-auto flex-grow max-h-[380px] overflow-y-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-gray-50 dark:bg-gray-800/60 text-gray-500 font-semibold border-b border-gray-100 dark:border-gray-800 sticky top-0">
                            <tr>
                                <th class="p-3.5">Fecha</th>
                                <th class="p-3.5">Descripción</th>
                                <th class="p-3.5">Categoría</th>
                                <th class="p-3.5 text-right">Monto</th>
                            </tr>
                        </thead>
                        <tbody id="txTableBody" class="divide-y divide-gray-100 dark:divide-gray-800/60">
                            <!-- Filas dinámicas -->
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>

    <!-- Modal para Confirmar Borrado de Todo el Historial -->
    <div id="clearHistoryModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-gray-900/80 backdrop-blur-md">
        <div class="bg-white dark:bg-gray-900 w-full max-w-sm rounded-3xl p-6 shadow-2xl border border-gray-200 dark:border-gray-800 animate-scale-in text-center space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-red-100 dark:bg-red-950/60 text-red-600 dark:text-red-400 mx-auto flex items-center justify-center text-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white font-josefin">¿Borrar todo el historial?</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 leading-relaxed">
                    Esta acción eliminará permanentemente todas las transacciones registradas de todos los meses y años.
                </p>
            </div>
            <div class="flex gap-2.5 pt-2">
                <button id="btnCancelClearHistory" class="flex-1 py-2.5 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-semibold rounded-xl text-xs hover:bg-gray-200 dark:hover:bg-gray-700 transition">
                    Cancelar
                </button>
                <button id="btnConfirmClearHistory" class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl text-xs shadow-sm transition">
                    Sí, Borrar Todo
                </button>
            </div>
        </div>
    </div>
</Layout>

<script define:vars={{ API_URL }}>
    const userCurrency = localStorage.getItem('financeai_preferred_currency') || 'USD';
    let rawTransactions = [];
    let filteredTransactions = [];
    let currentGranularity = 'day';

    let multiLineChartInstance = null;
    let categoryDonutInstance = null;

    // Configuración de Límites de Fecha: 2 años atrás hasta la fecha de hoy
    const now = new Date();
    const todayISO = now.toISOString().slice(0, 10);
    
    const twoYearsAgoDate = new Date(now.getFullYear() - 2, now.getMonth(), now.getDate());
    const minAllowedISO = twoYearsAgoDate.toISOString().slice(0, 10);

    const filterMonthPicker = document.getElementById('filterMonthPicker');
    const filterDateStart = document.getElementById('filterDateStart');
    const filterDateEnd = document.getElementById('filterDateEnd');

    if (filterMonthPicker) {
        filterMonthPicker.min = minAllowedISO.slice(0, 7);
        filterMonthPicker.max = todayISO.slice(0, 7);
    }
    if (filterDateStart) {
        filterDateStart.min = minAllowedISO;
        filterDateStart.max = todayISO;
    }
    if (filterDateEnd) {
        filterDateEnd.min = minAllowedISO;
        filterDateEnd.max = todayISO;
    }

    // Colores oficiales para las líneas con picos
    const LINE_COLORS = {
        total: '#EF4444',       // Rojo
        ingresos: '#10B981',    // Verde esmeralda
        necesidades: '#3B82F6', // Azul cielo
        deseos: '#F59E0B'       // Ámbar
    };

    // Dataset base de ejemplo para inicialización si no se ha borrado
    const INITIAL_SAMPLE_TRANSACTIONS = [
        { id: 101, description: 'Sueldo Quincenal Base', amount: 4500, category: 'Ingresos', type: 'INCOME', date: '2026-08-01' },
        { id: 102, description: 'Renta Depto', amount: 1200, category: 'Vivienda', type: 'EXPENSE', date: '2026-08-03' },
        { id: 103, description: 'Supermercado Mensual', amount: 650, category: 'Alimentación', type: 'EXPENSE', date: '2026-08-06' },
        { id: 104, description: 'Gasolina y Transporte', amount: 420, category: 'Transporte', type: 'EXPENSE', date: '2026-08-10' },
        { id: 105, description: 'Servicios de Luz y Agua', amount: 180, category: 'Servicios', type: 'EXPENSE', date: '2026-08-13' },
        { id: 106, description: 'Ingreso Extra Consultoría', amount: 800, category: 'Ingresos', type: 'INCOME', date: '2026-08-15' },
        { id: 107, description: 'Cursos y Libros', amount: 500, category: 'Educación', type: 'EXPENSE', date: '2026-08-18' },
        { id: 108, description: 'Cena y Salidas', amount: 260, category: 'Entretenimiento', type: 'EXPENSE', date: '2026-08-20' },
        { id: 109, description: 'Farmacia y Vitaminas', amount: 140, category: 'Salud y bienestar', type: 'EXPENSE', date: '2026-07-24' },
        { id: 110, description: 'Ropa y Accesorios', amount: 310, category: 'Compras', type: 'EXPENSE', date: '2026-07-28' },
        { id: 111, description: 'Ingreso Nómina Julio', amount: 4200, category: 'Ingresos', type: 'INCOME', date: '2026-07-01' },
        { id: 112, description: 'Mantenimiento Vehicular', amount: 750, category: 'Transporte', type: 'EXPENSE', date: '2026-07-15' }
    ];

    // Cargar datos acumulativos
    async function loadData() {
        const token = localStorage.getItem('financeai_token');
        let fetchedTx = [];

        if (token) {
            try {
                const res = await fetch(`${API_URL}/api/v1/transactions`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    fetchedTx = await res.json();
                }
            } catch (e) {
                console.warn("Fallo fetch transacciones:", e);
            }
        }

        const isHistoryExplicitlyCleared = localStorage.getItem('financeai_history_cleared') === 'true';

        if (Array.isArray(fetchedTx) && fetchedTx.length > 0) {
            rawTransactions = fetchedTx.map(t => ({
                id: t.id,
                description: t.description || t.descripcion || 'Transacción',
                amount: parseFloat(t.amount || t.monto || 0),
                category: t.category || t.categoria || 'Otros',
                type: t.type || (parseFloat(t.amount || t.monto) < 0 ? 'EXPENSE' : 'INCOME'),
                date: (t.date || t.fecha || todayISO).toString().slice(0, 10)
            }));
        } else {
            const savedLocal = localStorage.getItem('financeai_all_transactions');
            if (savedLocal) {
                try {
                    rawTransactions = JSON.parse(savedLocal);
                } catch (_) {
                    rawTransactions = isHistoryExplicitlyCleared ? [] : INITIAL_SAMPLE_TRANSACTIONS;
                }
            } else {
                rawTransactions = isHistoryExplicitlyCleared ? [] : INITIAL_SAMPLE_TRANSACTIONS;
                if (!isHistoryExplicitlyCleared) {
                    localStorage.setItem('financeai_all_transactions', JSON.stringify(INITIAL_SAMPLE_TRANSACTIONS));
                }
            }
        }

        populateCategoryFilter();
        applyFilters();
    }

    function populateCategoryFilter() {
        const catSelect = document.getElementById('filterCategory');
        const categories = [...new Set(rawTransactions.map(t => t.category || 'Otros'))].sort();
        catSelect.innerHTML = '<option value="all">Todas las Categorías</option>' + 
            categories.map(c => `<option value="${c}">${c}</option>`).join('');
    }

    function applyFilters() {
        const selectedMonth = filterMonthPicker?.value; // "YYYY-MM"
        const startDate = filterDateStart?.value;       // "YYYY-MM-DD"
        const endDate = filterDateEnd?.value;           // "YYYY-MM-DD"
        const type = document.getElementById('filterType').value;
        const category = document.getElementById('filterCategory').value;

        filteredTransactions = rawTransactions.filter(t => {
            const tDate = (t.date || todayISO).slice(0, 10);

            // Filtro por tipo
            if (type !== 'all' && t.type !== type) return false;
            // Filtro por categoría
            if (category !== 'all' && (t.category || 'Otros') !== category) return false;

            // Filtro por mes específico de calendario
            if (selectedMonth && !tDate.startsWith(selectedMonth)) {
                return false;
            }

            // Filtro por rango de fechas (Inicio y Fin)
            if (startDate && tDate < startDate) return false;
            if (endDate && tDate > endDate) return false;

            return true;
        });

        renderKPIs();
        renderTable();
        renderMultiLinePeaksChart();
        renderCategoryDonut();
    }

    function renderKPIs() {
        let ingresos = 0;
        let gastos = 0;

        filteredTransactions.forEach(t => {
            const amt = parseFloat(t.amount) || 0;
            if (t.type === 'INCOME') ingresos += amt;
            else gastos += amt;
        });

        const balance = ingresos - gastos;

        document.getElementById('statTotalIngresos').textContent = `${userCurrency} ${ingresos.toLocaleString()}`;
        document.getElementById('statTotalGastos').textContent = `${userCurrency} ${gastos.toLocaleString()}`;
        document.getElementById('statBalanceNeto').textContent = `${userCurrency} ${balance.toLocaleString()}`;
        document.getElementById('statTotalTransacciones').textContent = filteredTransactions.length.toString();
        document.getElementById('txFilteredCount').textContent = `Mostrando ${filteredTransactions.length} de ${rawTransactions.length} transacciones`;
    }

    function renderTable() {
        const tbody = document.getElementById('txTableBody');
        if (filteredTransactions.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="p-8 text-center text-gray-400">
                        No se encontraron transacciones con los filtros seleccionados.
                    </td>
                </tr>
            `;
            return;
        }

        tbody.innerHTML = filteredTransactions.map(t => {
            const isIncome = t.type === 'INCOME';
            const amountFormatted = `${isIncome ? '+' : '-'}${userCurrency} ${Number(t.amount).toLocaleString()}`;
            const colorClass = isIncome ? 'text-emerald-600 dark:text-emerald-400 font-bold' : 'text-rose-600 dark:text-rose-400 font-bold';

            return `
                <tr class="hover:bg-gray-50/60 dark:hover:bg-gray-800/40 transition">
                    <td class="p-3.5 text-gray-500 font-mono text-[11px]">${t.date}</td>
                    <td class="p-3.5 font-semibold text-gray-900 dark:text-white">${t.description || 'Sin descripción'}</td>
                    <td class="p-3.5">
                        <span class="inline-block px-2.5 py-0.5 rounded-lg text-[10px] font-semibold bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300">
                            ${t.category || 'Otros'}
                        </span>
                    </td>
                    <td class="p-3.5 text-right ${colorClass}">${amountFormatted}</td>
                </tr>
            `;
        }).join('');
    }

    // ─── GRÁFICA MULTI-LÍNEA CON PICOS Y FLUCTUACIONES ───
    function renderMultiLinePeaksChart() {
        const ctx = document.getElementById('multiLinePeaksChart')?.getContext('2d');
        if (!ctx) return;

        if (multiLineChartInstance) multiLineChartInstance.destroy();

        // Agrupar por Granularidad (Día, Semana, Mes)
        const grouped = {};
        filteredTransactions.forEach(t => {
            let key = t.date;
            if (currentGranularity === 'week') {
                const d = new Date(t.date + 'T00:00:00');
                key = `Sem ${Math.ceil(d.getDate() / 7)} (${d.getMonth() + 1}/${d.getFullYear()})`;
            } else if (currentGranularity === 'month') {
                const d = new Date(t.date + 'T00:00:00');
                key = `${d.toLocaleString('es-ES', { month: 'short' })} ${d.getFullYear()}`;
            }

            if (!grouped[key]) {
                grouped[key] = { totalGastos: 0, ingresos: 0, necesidades: 0, deseos: 0 };
            }

            const amt = parseFloat(t.amount) || 0;
            if (t.type === 'INCOME') {
                grouped[key].ingresos += amt;
            } else {
                grouped[key].totalGastos += amt;
                const cat = t.category || 'Otros';
                if (['Vivienda', 'Alimentación', 'Transporte', 'Servicios', 'Salud y bienestar', 'Educación'].includes(cat)) {
                    grouped[key].necesidades += amt;
                } else {
                    grouped[key].deseos += amt;
                }
            }
        });

        const labels = Object.keys(grouped).sort();
        const dataTotalGastos = labels.map(l => grouped[l].totalGastos);
        const dataIngresos = labels.map(l => grouped[l].ingresos);
        const dataNecesidades = labels.map(l => grouped[l].necesidades);
        const dataDeseos = labels.map(l => grouped[l].deseos);

        multiLineChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels.length > 0 ? labels : ['Sin datos'],
                datasets: [
                    {
                        label: `Total Gastos (${userCurrency})`,
                        data: dataTotalGastos.length > 0 ? dataTotalGastos : [0],
                        borderColor: LINE_COLORS.total,
                        backgroundColor: 'rgba(239, 68, 68, 0.08)',
                        borderWidth: 3,
                        pointBackgroundColor: LINE_COLORS.total,
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 6,
                        pointHoverRadius: 8,
                        tension: 0.35,
                        fill: false
                    },
                    {
                        label: `Ingresos (${userCurrency})`,
                        data: dataIngresos.length > 0 ? dataIngresos : [0],
                        borderColor: LINE_COLORS.ingresos,
                        borderWidth: 2.5,
                        borderDash: [4, 4],
                        pointBackgroundColor: LINE_COLORS.ingresos,
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        tension: 0.25,
                        fill: false
                    },
                    {
                        label: `Necesidades Básicas (${userCurrency})`,
                        data: dataNecesidades.length > 0 ? dataNecesidades : [0],
                        borderColor: LINE_COLORS.necesidades,
                        borderWidth: 2,
                        pointBackgroundColor: LINE_COLORS.necesidades,
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1.5,
                        pointRadius: 4,
                        tension: 0.3,
                        fill: false
                    },
                    {
                        label: `Estilo de Vida (${userCurrency})`,
                        data: dataDeseos.length > 0 ? dataDeseos : [0],
                        borderColor: LINE_COLORS.deseos,
                        borderWidth: 2,
                        pointBackgroundColor: LINE_COLORS.deseos,
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1.5,
                        pointRadius: 4,
                        tension: 0.3,
                        fill: false
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { intersect: false, mode: 'index' },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { font: { family: 'Josefin Sans', size: 11 } }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: {
                        grid: { color: 'rgba(156, 163, 175, 0.1)' },
                        ticks: { callback: v => userCurrency + ' ' + v }
                    }
                }
            }
        });
    }

    // Donut Categorías
    function renderCategoryDonut() {
        const ctx = document.getElementById('categoryDonutChart')?.getContext('2d');
        if (!ctx) return;

        if (categoryDonutInstance) categoryDonutInstance.destroy();

        const catTotals = {};
        filteredTransactions.filter(t => t.type === 'EXPENSE').forEach(t => {
            const cat = t.category || 'Otros';
            catTotals[cat] = (catTotals[cat] || 0) + (parseFloat(t.amount) || 0);
        });

        const labels = Object.keys(catTotals);
        const data = Object.values(catTotals);
        const palette = ['#3B82F6', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899', '#06B6D4', '#64748B'];

        categoryDonutInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels.length > 0 ? labels : ['Sin gastos'],
                datasets: [{
                    data: data.length > 0 ? data : [1],
                    backgroundColor: labels.length > 0 ? palette.slice(0, labels.length) : ['#94A3B8'],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                cutout: '70%'
            }
        });

        // Leyenda
        const leg = document.getElementById('categoryLegend');
        if (labels.length > 0) {
            leg.innerHTML = labels.map((l, i) => `
                <div class="flex justify-between items-center text-[11px] text-gray-600 dark:text-gray-300">
                    <span class="flex items-center gap-1.5">
                        <span class="w-2.5 h-2.5 rounded-full" style="background-color: ${palette[i % palette.length]}"></span>
                        ${l}
                    </span>
                    <strong>${userCurrency} ${data[i].toLocaleString()}</strong>
                </div>
            `).join('');
        } else {
            leg.innerHTML = '<p class="text-center text-gray-400 text-xs">Sin datos registrados</p>';
        }
    }

    // Botones de Granularidad
    const btnDay = document.getElementById('btnGranularityDay');
    const btnWeek = document.getElementById('btnGranularityWeek');
    const btnMonth = document.getElementById('btnGranularityMonth');

    function setGranularity(mode) {
        currentGranularity = mode;
        [btnDay, btnWeek, btnMonth].forEach(b => {
            b.className = 'px-3 py-1.5 rounded-xl text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition';
        });
        if (mode === 'day') btnDay.className = 'px-3 py-1.5 rounded-xl bg-white dark:bg-gray-900 text-blue-600 dark:text-blue-400 shadow-sm transition';
        if (mode === 'week') btnWeek.className = 'px-3 py-1.5 rounded-xl bg-white dark:bg-gray-900 text-blue-600 dark:text-blue-400 shadow-sm transition';
        if (mode === 'month') btnMonth.className = 'px-3 py-1.5 rounded-xl bg-white dark:bg-gray-900 text-blue-600 dark:text-blue-400 shadow-sm transition';
        renderMultiLinePeaksChart();
    }

    btnDay?.addEventListener('click', () => setGranularity('day'));
    btnWeek?.addEventListener('click', () => setGranularity('week'));
    btnMonth?.addEventListener('click', () => setGranularity('month'));

    // Filtros listeners
    filterMonthPicker?.addEventListener('change', () => {
        // Al seleccionar un mes específico, limpiar rango para evitar conflicto
        if (filterDateStart) filterDateStart.value = '';
        if (filterDateEnd) filterDateEnd.value = '';
        applyFilters();
    });

    filterDateStart?.addEventListener('change', () => {
        if (filterMonthPicker) filterMonthPicker.value = '';
        applyFilters();
    });

    filterDateEnd?.addEventListener('change', () => {
        if (filterMonthPicker) filterMonthPicker.value = '';
        applyFilters();
    });

    document.getElementById('filterType')?.addEventListener('change', applyFilters);
    document.getElementById('filterCategory')?.addEventListener('change', applyFilters);

    document.getElementById('btnResetFilters')?.addEventListener('click', () => {
        if (filterMonthPicker) filterMonthPicker.value = '';
        if (filterDateStart) filterDateStart.value = '';
        if (filterDateEnd) filterDateEnd.value = '';
        document.getElementById('filterType').value = 'all';
        document.getElementById('filterCategory').value = 'all';
        applyFilters();
    });

    // Modal para Borrar Todo el Historial
    const clearHistoryModal = document.getElementById('clearHistoryModal');
    document.getElementById('btnOpenClearHistoryModal')?.addEventListener('click', () => {
        clearHistoryModal.classList.remove('hidden');
    });

    document.getElementById('btnCancelClearHistory')?.addEventListener('click', () => {
        clearHistoryModal.classList.add('hidden');
    });

    document.getElementById('btnConfirmClearHistory')?.addEventListener('click', () => {
        rawTransactions = [];
        filteredTransactions = [];
        localStorage.setItem('financeai_all_transactions', JSON.stringify([]));
        localStorage.setItem('financeai_dashboard_txns', JSON.stringify([]));
        localStorage.setItem('financeai_history_cleared', 'true');
        
        clearHistoryModal.classList.add('hidden');
        populateCategoryFilter();
        applyFilters();

        window.showToast?.('Historial Eliminado', 'Todas las transacciones históricas han sido borradas.', '🗑️');
    });

    // Exportar Excel
    document.getElementById('btnExportExcel')?.addEventListener('click', () => {
        if (filteredTransactions.length === 0) {
            window.showToast?.('Exportación', 'No hay datos para exportar con los filtros actuales.', '⚠️');
            return;
        }
        const headers = ["ID", "Fecha", "Descripcion", "Categoria", "Tipo", "Monto", "Moneda"];
        const rows = filteredTransactions.map(t => [
            t.id, t.date, `"${(t.description || '').replace(/"/g, '""')}"`, `"${t.category || ''}"`, t.type, t.amount, userCurrency
        ]);
        const csvContent = "\uFEFF" + [headers.join(','), ...rows.map(r => r.join(','))].join('\r\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Reporte_Financiero_FinanceAI_${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        URL.revokeObjectURL(url);
        window.showToast?.('¡Excel Descargado!', 'El reporte se generó correctamente.', '📊');
    });

    // Exportar PDF
    document.getElementById('btnExportPdf')?.addEventListener('click', () => {
        window.print();
    });

    // Iniciar carga
    loadData();
</script>
