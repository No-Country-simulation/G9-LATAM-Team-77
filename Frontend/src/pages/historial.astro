---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
const hasServerSession = !!session;

const OFFICIAL_RATES_TABLE = [
    { name: 'Dólar estadounidense', code: 'USD', usdValue: '$1.00', symbol: '$', rateToUSD: 1.00, oneUSDEquiv: '$1.00 USD' },
    { name: 'Peso mexicano', code: 'MXN', usdValue: '$0.0591', symbol: '$', rateToUSD: 0.0591, oneUSDEquiv: '$16.92 MXN' },
    { name: 'Euro', code: 'EUR', usdValue: '$1.1687', symbol: '€', rateToUSD: 1.1687, oneUSDEquiv: '€0.8557 EUR' },
    { name: 'Colón costarricense', code: 'CRC', usdValue: '$0.0022', symbol: '₡', rateToUSD: 0.0022, oneUSDEquiv: '₡454.55 CRC' },
    { name: 'Peso colombiano', code: 'COP', usdValue: '$0.000326', symbol: '$', rateToUSD: 0.000326, oneUSDEquiv: '$3,067.48 COP' },
    { name: 'Peso argentino', code: 'ARS', usdValue: '$0.000667', symbol: '$', rateToUSD: 0.000667, oneUSDEquiv: '$1,499.25 ARS' },
    { name: 'Peso chileno', code: 'CLP', usdValue: '$0.001093', symbol: '$', rateToUSD: 0.001093, oneUSDEquiv: '$914.91 CLP' },
    { name: 'Sol peruano', code: 'PEN', usdValue: '$0.2982', symbol: 'S/', rateToUSD: 0.2982, oneUSDEquiv: 'S/ 3.35 PEN' },
    { name: 'Lempira hondureño', code: 'HNL', usdValue: '$0.0404', symbol: 'L', rateToUSD: 0.0404, oneUSDEquiv: 'L 24.75 HNL' },
    { name: 'Real brasileño', code: 'BRL', usdValue: '$0.1770', symbol: 'R$', rateToUSD: 0.1770, oneUSDEquiv: 'R$ 5.65 BRL' }
];
---

<Layout title="Historial Financiero | FinanceAI" description="Evolución temporal de transacciones, análisis de picos y fluctuaciones de flujo y conversor multidivisa en tiempo real.">
    <!-- Guardia de Protección de Ruta Seguro -->
    <script define:vars={{ hasServerSession }}>
        if (!hasServerSession && !localStorage.getItem('financeai_token')) {
            window.location.replace('/login');
        }
        window.addEventListener('pageshow', function(e) {
            if (e.persisted && !hasServerSession && !localStorage.getItem('financeai_token')) {
                window.location.replace('/login');
            }
        });
    </script>

    <div class="w-full max-w-7xl mx-auto px-3 sm:px-4 py-4 sm:py-6 md:py-8 flex flex-col gap-4 sm:gap-6 font-inter">
        
        <!-- Header Section -->
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-3 sm:gap-4 border-b border-gray-200 dark:border-gray-800 pb-4">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white tracking-tight font-josefin">Historial Financiero</h1>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Evolución temporal, filtros de calendario por mes y rango de tiempo.</p>
            </div>
            
            <!-- Actions (Borrar Historial) -->
            <div class="flex items-center flex-wrap gap-2 sm:gap-2.5">
                <button type="button" id="btnOpenClearHistoryModal" class="inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 sm:py-2.5 bg-red-50 dark:bg-red-950/40 hover:bg-red-100 dark:hover:bg-red-900/60 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800/60 rounded-xl text-xs font-semibold transition cursor-pointer">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    Borrar Historial
                </button>
            </div>
        </header>

        <!-- Barra de Conversión Rápida de Monedas y Tabla de Equivalencias -->
        <section class="bg-white dark:bg-gray-900 p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm space-y-4">
            
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-2xl bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-gray-900 dark:text-white">Conversor de Moneda</h3>
                            <button type="button" id="btnToggleRatesTable" class="text-[11px] font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1 cursor-pointer bg-blue-50 dark:bg-blue-950/40 px-2 py-0.5 rounded-lg border border-blue-200 dark:border-blue-800/50">
                                <span>Ver Tabla de Equivalencias</span>
                                <svg id="iconChevronRates" class="w-3 h-3 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                            </button>
                        </div>
                        <p id="activeRateNotice" class="text-[11px] text-gray-500 mt-0.5">Visualizando en: <strong id="currentCurrencyLabel" class="text-blue-600 dark:text-blue-400">USD</strong> (1 USD = $1.00 USD)</p>
                    </div>
                </div>

                <!-- Botones de Cambio Rápido de Moneda -->
                <div class="flex items-center flex-wrap gap-1.5" id="currencyButtonsGroup">
                    {OFFICIAL_RATES_TABLE.map(c => (
                        <button type="button" class="btn-currency-pill px-3 py-1.5 rounded-xl text-xs font-bold border transition-all duration-200 cursor-pointer" data-currency={c.code}>
                            {c.code}
                        </button>
                    ))}
                </div>
            </div>

            <!-- TABLA DE EQUIVALENCIAS OFICIALES (Visible / Plegable sin estorbar) -->
            <div id="ratesTableContainer" class="hidden pt-3 border-t border-gray-100 dark:border-gray-800 animate-fade-in">
                <div class="overflow-x-auto rounded-2xl border border-gray-100 dark:border-gray-800/80 bg-gray-50/50 dark:bg-gray-800/30">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-gray-100/70 dark:bg-gray-800/80 text-gray-600 dark:text-gray-300 font-semibold border-b border-gray-200 dark:border-gray-700">
                            <tr>
                                <th class="py-2.5 px-4">Moneda</th>
                                <th class="py-2.5 px-3">Código</th>
                                <th class="py-2.5 px-4 font-mono">Equivalencia en USD</th>
                                <th class="py-2.5 px-4 text-right">Tipo de Cambio</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-800/60 font-inter">
                            {OFFICIAL_RATES_TABLE.map(row => (
                                <tr class="hover:bg-white dark:hover:bg-gray-800/50 transition">
                                    <td class="py-2.5 px-4 font-medium text-gray-900 dark:text-white flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                                        {row.name}
                                    </td>
                                    <td class="py-2.5 px-3">
                                        <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-bold bg-gray-200/70 dark:bg-gray-700 text-gray-800 dark:text-gray-200">
                                            {row.code}
                                        </span>
                                    </td>
                                    <td class="py-2.5 px-4 font-mono font-bold text-blue-600 dark:text-blue-400">
                                        {row.usdValue}
                                    </td>
                                    <td class="py-2.5 px-4 text-right text-gray-500 font-medium">
                                        1 USD = {row.oneUSDEquiv}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>

        </section>

        <!-- KPI Summary Cards -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
            <div class="bg-white dark:bg-gray-900 p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex items-center gap-3.5 sm:gap-4">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </div>
                <div>
                    <span class="text-[10px] sm:text-xs text-gray-500 font-semibold uppercase tracking-wider">Total Ingresos</span>
                    <h3 id="statTotalIngresos" class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">$0</h3>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-900 p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex items-center gap-3.5 sm:gap-4">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
                </div>
                <div>
                    <span class="text-[10px] sm:text-xs text-gray-500 font-semibold uppercase tracking-wider">Total Gastos</span>
                    <h3 id="statTotalGastos" class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">$0</h3>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-900 p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex items-center gap-3.5 sm:gap-4">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </div>
                <div>
                    <span class="text-[10px] sm:text-xs text-gray-500 font-semibold uppercase tracking-wider">Balance Neto</span>
                    <h3 id="statBalanceNeto" class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">$0</h3>
                </div>
            </div>

            <div class="bg-white dark:bg-gray-900 p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex items-center gap-3.5 sm:gap-4">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                </div>
                <div>
                    <span class="text-[10px] sm:text-xs text-gray-500 font-semibold uppercase tracking-wider">Transacciones</span>
                    <h3 id="statTotalTransacciones" class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">0</h3>
                </div>
            </div>
        </section>

        <!-- FILTROS AVANZADOS DEL HISTÓRICO (Ubicado Arriba con Calendario Personalizado) -->
        <section class="bg-white dark:bg-gray-900 p-4 sm:p-5 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-gray-100 dark:border-gray-800 pb-3">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-gray-900 dark:text-white">Filtrar Histórico (Máximo 2 Años Atrás)</h3>
                </div>
                <div class="flex items-center gap-3">
                    <button type="button" id="btnShowAllTxns" class="text-xs font-bold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1 cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                        Ver Todas
                    </button>
                    <button type="button" id="btnResetFilters" class="text-xs text-gray-500 hover:text-gray-900 dark:hover:text-white cursor-pointer">Restablecer</button>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5 sm:gap-3 text-xs">
                
                <!-- 1. Selector de Mes Personalizado Glassmorphic -->
                <div class="relative">
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">
                        Seleccionar Mes
                    </label>
                    <button type="button" id="btnCustomMonthTrigger" class="w-full flex items-center justify-between px-3 py-2.5 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-medium text-left focus:ring-2 focus:ring-blue-500 outline-none transition">
                        <span id="customMonthDisplay" class="truncate">Todos los Meses</span>
                        <svg class="w-4 h-4 text-gray-400 flex-shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </button>

                    <!-- Popover Desplegable de Meses (Modo Claro / Oscuro) -->
                    <div id="customMonthDropdown" class="hidden absolute top-full left-0 mt-2 z-50 w-64 sm:w-72 max-w-[calc(100vw-32px)] bg-white dark:bg-gray-900/95 backdrop-blur-2xl border border-gray-200 dark:border-gray-700 shadow-2xl rounded-2xl p-4 animate-scale-in">
                        <div class="flex items-center justify-between pb-3 border-b border-gray-100 dark:border-gray-800 mb-3">
                            <button type="button" id="btnPrevYear" class="p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition">&lt;</button>
                            <span id="customYearLabel" class="font-bold text-sm text-gray-900 dark:text-white font-josefin">2026</span>
                            <button type="button" id="btnNextYear" class="p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition">&gt;</button>
                        </div>
                        <div class="grid grid-cols-3 gap-2" id="customMonthsGrid">
                            <!-- 12 Tiles de meses generados dinámicamente -->
                        </div>
                    </div>
                </div>

                <!-- 2. Rango Específico: Fecha Inicio -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">
                        Rango: Fecha Inicio
                    </label>
                    <input type="date" id="filterDateStart"
                        class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-medium focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>

                <!-- 3. Rango Específico: Fecha Fin -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">
                        Rango: Fecha Fin
                    </label>
                    <input type="date" id="filterDateEnd"
                        class="w-full px-3 py-2 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white font-medium focus:ring-2 focus:ring-blue-500 outline-none" />
                </div>

                <!-- 4. Tipo de Flujo -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">Tipo de Flujo</label>
                    <select id="filterType" class="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white outline-none">
                        <option value="all">Ingresos y Gastos</option>
                        <option value="INCOME">Solo Ingresos</option>
                        <option value="EXPENSE">Solo Gastos</option>
                    </select>
                </div>

                <!-- 5. Categoría -->
                <div>
                    <label class="block text-[11px] font-semibold text-gray-600 dark:text-gray-400 mb-1">Categoría</label>
                    <select id="filterCategory" class="w-full px-3 py-2.5 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl dark:text-white outline-none">
                        <option value="all">Todas las Categorías</option>
                    </select>
                </div>
            </div>
        </section>

        <!-- GRÁFICA MULTI-LÍNEA CON PICOS Y FLUCTUACIONES TEMPORALES -->
        <section class="bg-white dark:bg-gray-900 p-4 sm:p-6 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm space-y-4">
            <div class="border-b border-gray-100 dark:border-gray-800 pb-3">
                <h2 class="text-base sm:text-lg font-bold text-gray-900 dark:text-white font-josefin flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"/></svg>
                    Evolución Comparativa y Fluctuación de Flujos
                </h2>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Líneas de gastos, necesidades, estilo de vida e ingresos con picos y valles temporales.</p>
            </div>

            <!-- Canvas de la Gráfica de Picos -->
            <div class="h-64 sm:h-72 lg:h-80 w-full relative">
                <canvas id="multiLinePeaksChart"></canvas>
            </div>
        </section>

        <!-- Gráfica de Distribución por Categoría y Tabla de Transacciones -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6">
            
            <!-- Donut Categorías (4 Cols) -->
            <div class="lg:col-span-4 bg-white dark:bg-gray-900 p-4 sm:p-6 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm flex flex-col justify-between">
                <h3 class="text-sm font-bold text-gray-900 dark:text-white font-josefin mb-3">Distribución por Categorías</h3>
                <div class="h-48 sm:h-56 relative flex items-center justify-center">
                    <canvas id="categoryDonutChart"></canvas>
                </div>
                <div id="categoryLegend" class="mt-4 space-y-1.5 text-xs max-h-32 overflow-y-auto pr-1"></div>
            </div>

            <!-- Tabla de Transacciones (8 Cols) -->
            <div class="lg:col-span-8 bg-white dark:bg-gray-900 rounded-2xl sm:rounded-3xl border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden flex flex-col">
                <div class="p-4 sm:p-5 border-b border-gray-100 dark:border-gray-800 flex justify-between items-center">
                    <h3 class="text-sm font-bold text-gray-900 dark:text-white font-josefin">Movimientos Registrados</h3>
                    <span id="txFilteredCount" class="text-xs text-gray-500">Mostrando 0 transacciones</span>
                </div>

                <div class="overflow-x-auto flex-grow max-h-[380px] overflow-y-auto">
                    <table class="w-full text-left text-xs min-w-[520px]">
                        <thead class="bg-gray-100/90 dark:bg-gray-800/90 text-gray-600 dark:text-gray-300 font-semibold border-b border-gray-200 dark:border-gray-800 sticky top-0 z-10 shadow-sm backdrop-blur-sm">
                            <tr>
                                <th class="p-3.5 whitespace-nowrap w-28">Fecha</th>
                                <th class="p-3.5 min-w-[140px]">Descripción</th>
                                <th class="p-3.5 whitespace-nowrap w-32">Categoría</th>
                                <th class="p-3.5 text-right whitespace-nowrap w-36">Monto</th>
                            </tr>
                        </thead>
                        <tbody id="txTableBody" class="divide-y divide-gray-100 dark:divide-gray-800/60">
                            <!-- Filas dinámicas -->
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </div>

    <!-- Modal para Confirmar Borrado de Todo el Historial -->
    <div id="clearHistoryModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-gray-900/80 backdrop-blur-md">
        <div class="bg-white dark:bg-gray-900 w-full max-w-sm rounded-3xl p-6 shadow-2xl border border-gray-200 dark:border-gray-800 text-center space-y-4 animate-scale-in font-inter">
            <div class="w-12 h-12 rounded-2xl bg-red-100 dark:bg-red-950/60 text-red-600 dark:text-red-400 mx-auto flex items-center justify-center text-xl">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </div>
            <div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white font-josefin">¿Borrar todo el historial?</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 leading-relaxed">
                    Esta acción eliminará permanentemente todas las transacciones registradas de todos los meses y años.
                </p>
            </div>
            <div class="flex gap-2.5 pt-2">
                <button type="button" id="btnCancelClearHistory" class="flex-1 py-2.5 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-semibold rounded-xl text-xs hover:bg-gray-200 dark:hover:bg-gray-700 transition cursor-pointer">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmClearHistory" class="flex-1 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl text-xs shadow-sm transition cursor-pointer">
                    Sí, Borrar Todo
                </button>
            </div>
        </div>
    </div>
</Layout>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

<script>
    import Chart from 'chart.js/auto';
    if (typeof (window as any).Chart === 'undefined') {
        (window as any).Chart = Chart;
    }
</script>

<script define:vars={{ API_URL }}>
    function getChartLib() {
        if (typeof window !== 'undefined' && window.Chart) {
            return window.Chart;
        }
        if (typeof Chart !== 'undefined') {
            return Chart;
        }
        return null;
    }
    // Moneda base predeterminada en perfil
    const profileBaseCurrency = (localStorage.getItem('financeai_preferred_currency') || 'USD').toUpperCase();
    let currentViewingCurrency = profileBaseCurrency;

    // Matriz Oficial de Equivalencias en USD
    const OFFICIAL_USD_VALUES = {
        USD: 1.00,
        MXN: 0.0591,
        EUR: 1.1687,
        CRC: 0.0022,
        COP: 0.000326,
        ARS: 0.000667,
        CLP: 0.001093,
        PEN: 0.2982,
        HNL: 0.0404,
        BRL: 0.1770
    };

    // Símbolos de monedas
    const CURRENCY_SYMBOLS_MAP = {
        USD: '$',
        MXN: '$',
        EUR: '€',
        CRC: '₡',
        COP: '$',
        ARS: '$',
        CLP: '$',
        PEN: 'S/',
        HNL: 'L',
        BRL: 'R$'
    };

    /**
     * Convierte un monto de una moneda a otra usando la matriz oficial de equivalencias en USD
     */
    function convertAmount(amount, fromCur, toCur) {
        if (!amount || isNaN(amount)) return 0;
        const from = (fromCur || profileBaseCurrency || 'USD').toUpperCase();
        const to = (toCur || 'USD').toUpperCase();
        if (from === to) return Number(amount);

        const fromVal = OFFICIAL_USD_VALUES[from] || 1.0;
        const toVal = OFFICIAL_USD_VALUES[to] || 1.0;

        const inUSD = Number(amount) * fromVal;
        const converted = inUSD / toVal;
        return Math.round(converted * 100) / 100;
    }

    let rawTransactions = [];
    let filteredTransactions = [];

    let multiLineChartInstance = null;
    let categoryDonutInstance = null;

    const now = new Date();
    const todayISO = now.toISOString().slice(0, 10);
    const twoYearsAgoDate = new Date(now.getFullYear() - 2, now.getMonth(), now.getDate());
    const minAllowedISO = twoYearsAgoDate.toISOString().slice(0, 10);

    const filterDateStart = document.getElementById('filterDateStart');
    const filterDateEnd = document.getElementById('filterDateEnd');

    if (filterDateStart) {
        filterDateStart.min = minAllowedISO;
        filterDateStart.max = todayISO;
    }
    if (filterDateEnd) {
        filterDateEnd.min = minAllowedISO;
        filterDateEnd.max = todayISO;
    }

    const LINE_COLORS = {
        total: '#EF4444',       // Rojo
        ingresos: '#10B981',    // Verde esmeralda
        necesidades: '#3B82F6', // Azul cielo
        deseos: '#F59E0B'       // Ámbar
    };

    const INITIAL_SAMPLE_TRANSACTIONS = [
        { id: 101, description: 'Sueldo Quincenal Base', amount: 4500, originalCurrency: 'USD', category: 'Ingresos', type: 'INCOME', date: '2026-08-01' },
        { id: 102, description: 'Renta Depto', amount: 1200, originalCurrency: 'USD', category: 'Vivienda', type: 'EXPENSE', date: '2026-08-03' },
        { id: 103, description: 'Supermercado Mensual', amount: 650, originalCurrency: 'USD', category: 'Alimentación', type: 'EXPENSE', date: '2026-08-06' },
        { id: 104, description: 'Gasolina y Transporte', amount: 420, originalCurrency: 'USD', category: 'Transporte', type: 'EXPENSE', date: '2026-08-10' },
        { id: 105, description: 'Servicios de Luz y Agua', amount: 180, originalCurrency: 'USD', category: 'Servicios', type: 'EXPENSE', date: '2026-08-13' },
        { id: 106, description: 'Ingreso Extra Consultoría', amount: 800, originalCurrency: 'USD', category: 'Ingresos', type: 'INCOME', date: '2026-08-15' },
        { id: 107, description: 'Cursos y Libros', amount: 500, originalCurrency: 'USD', category: 'Educación', type: 'EXPENSE', date: '2026-08-18' },
        { id: 108, description: 'Cena y Salidas', amount: 260, originalCurrency: 'USD', category: 'Entretenimiento', type: 'EXPENSE', date: '2026-08-20' },
        { id: 109, description: 'Farmacia y Vitaminas', amount: 140, originalCurrency: 'USD', category: 'Salud y bienestar', type: 'EXPENSE', date: '2026-07-24' },
        { id: 110, description: 'Ropa y Accesorios', amount: 310, originalCurrency: 'USD', category: 'Compras', type: 'EXPENSE', date: '2026-07-28' },
        { id: 111, description: 'Ingreso Nómina Julio', amount: 4200, originalCurrency: 'USD', category: 'Ingresos', type: 'INCOME', date: '2026-07-01' },
        { id: 112, description: 'Mantenimiento Vehicular', amount: 750, originalCurrency: 'USD', category: 'Transporte', type: 'EXPENSE', date: '2026-07-15' }
    ];

    async function loadData() {
        const token = localStorage.getItem('financeai_token');
        let fetchedTx = [];

        if (token) {
            try {
                const res = await fetch(`${API_URL}/api/v1/transactions`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    fetchedTx = await res.json();
                }
            } catch (e) {
                console.warn("Fallo fetch transacciones:", e);
            }
        }

        const isHistoryExplicitlyCleared = localStorage.getItem('financeai_history_cleared') === 'true';

        if (Array.isArray(fetchedTx) && fetchedTx.length > 0) {
            rawTransactions = fetchedTx.map(t => ({
                id: t.id,
                description: t.description || t.descripcion || 'Transacción',
                amount: parseFloat(t.amount || t.monto || t.valor || 0),
                originalCurrency: t.originalCurrency || t.moneda || profileBaseCurrency,
                category: t.category || t.categoria || t.descripcion || 'Otros',
                type: t.type || (t.category === 'Ingresos' || t.categoria === 'Ingresos' || parseFloat(t.amount || t.monto) > 0 ? 'INCOME' : 'EXPENSE'),
                date: (t.date || t.fecha || todayISO).toString().slice(0, 10)
            }));
        } else {
            const savedLocal = localStorage.getItem('financeai_all_transactions');
            if (savedLocal) {
                try {
                    const parsed = JSON.parse(savedLocal);
                    rawTransactions = Array.isArray(parsed) ? parsed.map(t => ({
                        id: t.id,
                        description: t.description || t.descripcion || 'Transacción',
                        amount: parseFloat(t.amount || t.monto || t.valor || 0),
                        originalCurrency: t.originalCurrency || t.moneda || profileBaseCurrency,
                        category: t.category || t.categoria || t.descripcion || 'Otros',
                        type: t.type || (t.category === 'Ingresos' || t.categoria === 'Ingresos' ? 'INCOME' : 'EXPENSE'),
                        date: (t.date || t.fecha || todayISO).toString().slice(0, 10)
                    })) : [];
                } catch (_) {
                    rawTransactions = [];
                }
            } else {
                rawTransactions = [];
            }
        }

        initRatesTableToggle();
        bindCurrencyButtonEvents();
        updateCurrencyButtonsUI();
        initCustomMonthPicker();
        populateCategoryFilter();
        applyFilters();
    }

    function initRatesTableToggle() {
        const btn = document.getElementById('btnToggleRatesTable');
        const container = document.getElementById('ratesTableContainer');
        const chevron = document.getElementById('iconChevronRates');

        if (btn && container) {
            btn.onclick = () => {
                const isHidden = container.classList.contains('hidden');
                if (isHidden) {
                    container.classList.remove('hidden');
                    if (chevron) chevron.style.transform = 'rotate(180deg)';
                } else {
                    container.classList.add('hidden');
                    if (chevron) chevron.style.transform = 'rotate(0deg)';
                }
            };
        }
    }

    function updateCurrencyButtonsUI() {
        document.querySelectorAll('.btn-currency-pill').forEach(btn => {
            const cur = btn.getAttribute('data-currency');
            if (cur === currentViewingCurrency) {
                btn.className = 'btn-currency-pill px-3.5 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white border-blue-600 shadow-md scale-105 transition-all cursor-pointer';
            } else {
                btn.className = 'btn-currency-pill px-3 py-1.5 rounded-xl text-xs font-bold bg-gray-50 dark:bg-gray-800 text-gray-700 dark:text-gray-300 border-gray-200 dark:border-gray-700 hover:border-blue-400 transition-all cursor-pointer';
            }
        });

        const curLabel = document.getElementById('currentCurrencyLabel');
        if (curLabel) curLabel.textContent = currentViewingCurrency;

        const rateNotice = document.getElementById('activeRateNotice');
        if (rateNotice) {
            const usdVal = OFFICIAL_USD_VALUES[currentViewingCurrency] || 1.0;
            const oneUSDInTarget = (1.0 / usdVal).toLocaleString('es-MX', { maximumFractionDigits: 4 });
            rateNotice.innerHTML = `Visualizando en: <strong class="text-blue-600 dark:text-blue-400">${currentViewingCurrency}</strong> (1 ${currentViewingCurrency} = $${usdVal} USD | 1 USD = ${oneUSDInTarget} ${currentViewingCurrency})`;
        }
    }

    function bindCurrencyButtonEvents() {
        document.querySelectorAll('.btn-currency-pill').forEach(btn => {
            btn.onclick = () => {
                const selected = btn.getAttribute('data-currency');
                if (selected) {
                    currentViewingCurrency = selected;
                    updateCurrencyButtonsUI();
                    applyFilters();
                    window.showToast?.('Moneda Actualizada', `Visualizando historial en ${currentViewingCurrency} con conversión oficial en vivo.`, '💱');
                }
            };
        });
    }

    // Selector de Mes
    let customSelectedMonth = null;
    let customPickerYear = now.getFullYear();

    const MONTH_ABBR = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
    const btnCustomMonthTrigger = document.getElementById('btnCustomMonthTrigger');
    const customMonthDropdown = document.getElementById('customMonthDropdown');
    const customMonthDisplay = document.getElementById('customMonthDisplay');
    const customYearLabel = document.getElementById('customYearLabel');
    const customMonthsGrid = document.getElementById('customMonthsGrid');

    function initCustomMonthPicker() {
        renderCustomMonthsGrid();

        if (btnCustomMonthTrigger) {
            btnCustomMonthTrigger.onclick = (e) => {
                e.stopPropagation();
                customMonthDropdown?.classList.toggle('hidden');
            };
        }

        const prevBtn = document.getElementById('btnPrevYear');
        if (prevBtn) {
            prevBtn.onclick = (e) => {
                e.stopPropagation();
                if (customPickerYear > now.getFullYear() - 2) {
                    customPickerYear--;
                    renderCustomMonthsGrid();
                }
            };
        }

        const nextBtn = document.getElementById('btnNextYear');
        if (nextBtn) {
            nextBtn.onclick = (e) => {
                e.stopPropagation();
                if (customPickerYear < now.getFullYear()) {
                    customPickerYear++;
                    renderCustomMonthsGrid();
                }
            };
        }

        document.addEventListener('click', (e) => {
            if (!customMonthDropdown?.contains(e.target) && e.target !== btnCustomMonthTrigger) {
                customMonthDropdown?.classList.add('hidden');
            }
        });
    }

    function renderCustomMonthsGrid() {
        if (!customYearLabel || !customMonthsGrid) return;
        customYearLabel.textContent = customPickerYear.toString();

        const currentYear = now.getFullYear();
        const currentMonth = now.getMonth();

        customMonthsGrid.innerHTML = MONTH_ABBR.map((mName, idx) => {
            const mStr = String(idx + 1).padStart(2, '0');
            const targetVal = `${customPickerYear}-${mStr}`;
            
            const isFuture = (customPickerYear === currentYear && idx > currentMonth) || (customPickerYear > currentYear);
            const isTooOld = customPickerYear < currentYear - 2;
            const isDisabled = isFuture || isTooOld;
            const isSelected = customSelectedMonth === targetVal;

            return `
                <button type="button" class="month-tile py-2 px-1 text-xs font-semibold rounded-xl transition-all ${
                    isSelected 
                        ? 'bg-blue-600 text-white font-bold shadow-md'
                        : isDisabled
                            ? 'text-gray-300 dark:text-gray-700 cursor-not-allowed bg-transparent'
                            : 'text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-800/80 hover:bg-blue-50 dark:hover:bg-blue-900/40 hover:text-blue-600 cursor-pointer'
                }" data-month="${targetVal}" ${isDisabled ? 'disabled' : ''}>
                    ${mName}
                </button>
            `;
        }).join('');

        document.querySelectorAll('.month-tile:not([disabled])').forEach(btn => {
            btn.onclick = (e) => {
                e.stopPropagation();
                customSelectedMonth = btn.getAttribute('data-month');
                const parts = customSelectedMonth.split('-');
                const monthName = MONTH_ABBR[parseInt(parts[1]) - 1];
                if (customMonthDisplay) customMonthDisplay.textContent = `${monthName} ${parts[0]}`;
                customMonthDropdown?.classList.add('hidden');
                
                if (filterDateStart) filterDateStart.value = '';
                if (filterDateEnd) filterDateEnd.value = '';
                
                renderCustomMonthsGrid();
                applyFilters();
            };
        });
    }

    function populateCategoryFilter() {
        const catSelect = document.getElementById('filterCategory');
        if (!catSelect) return;
        const categories = [...new Set(rawTransactions.map(t => t.category || 'Otros'))].sort();
        catSelect.innerHTML = '<option value="all">Todas las Categorías</option>' + 
            categories.map(c => `<option value="${c}">${c}</option>`).join('');
    }

    function applyFilters() {
        const startDate = filterDateStart?.value;
        const endDate = filterDateEnd?.value;
        const type = document.getElementById('filterType')?.value || 'all';
        const category = document.getElementById('filterCategory')?.value || 'all';

        filteredTransactions = rawTransactions.filter(t => {
            const tDate = (t.date || todayISO).slice(0, 10);

            if (type !== 'all' && t.type !== type) return false;
            if (category !== 'all' && (t.category || 'Otros') !== category) return false;

            if (customSelectedMonth && !tDate.startsWith(customSelectedMonth)) {
                return false;
            }

            if (startDate && tDate < startDate) return false;
            if (endDate && tDate > endDate) return false;

            return true;
        });

        renderKPIs();
        renderTable();
        renderMultiLinePeaksChart();
        renderCategoryDonut();
    }

    function renderKPIs() {
        let ingresos = 0;
        let gastos = 0;

        filteredTransactions.forEach(t => {
            const rawAmt = parseFloat(t.amount) || 0;
            const originCur = t.originalCurrency || profileBaseCurrency;
            const convertedAmt = convertAmount(rawAmt, originCur, currentViewingCurrency);

            if (t.type === 'INCOME') ingresos += convertedAmt;
            else gastos += convertedAmt;
        });

        const balance = ingresos - gastos;
        const symbol = CURRENCY_SYMBOLS_MAP[currentViewingCurrency] || '$';

        const elIngresos = document.getElementById('statTotalIngresos');
        const elGastos = document.getElementById('statTotalGastos');
        const elBalance = document.getElementById('statBalanceNeto');
        const elTotalTx = document.getElementById('statTotalTransacciones');
        const elTxCount = document.getElementById('txFilteredCount');

        if (elIngresos) elIngresos.textContent = `${symbol} ${Math.round(ingresos).toLocaleString('es-MX')} ${currentViewingCurrency}`;
        if (elGastos) elGastos.textContent = `${symbol} ${Math.round(gastos).toLocaleString('es-MX')} ${currentViewingCurrency}`;
        if (elBalance) elBalance.textContent = `${symbol} ${Math.round(balance).toLocaleString('es-MX')} ${currentViewingCurrency}`;
        if (elTotalTx) elTotalTx.textContent = filteredTransactions.length.toString();
        if (elTxCount) elTxCount.textContent = `Mostrando ${filteredTransactions.length} de ${rawTransactions.length} transacciones`;
    }

    function renderTable() {
        const tbody = document.getElementById('txTableBody');
        if (!tbody) return;

        if (filteredTransactions.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="p-8 text-center text-gray-400">
                        No se encontraron transacciones con los filtros seleccionados.
                    </td>
                </tr>
            `;
            return;
        }

        const symbol = CURRENCY_SYMBOLS_MAP[currentViewingCurrency] || '$';

        tbody.innerHTML = filteredTransactions.map(t => {
            const isIncome = t.type === 'INCOME';
            const rawAmt = parseFloat(t.amount) || 0;
            const originCur = t.originalCurrency || profileBaseCurrency;
            const convertedAmt = convertAmount(rawAmt, originCur, currentViewingCurrency);

            const sign = isIncome ? '+' : '-';
            const formattedVal = `${sign}${symbol}${convertedAmt.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            const colorClass = isIncome ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400';

            return `
                <tr class="hover:bg-gray-50/60 dark:hover:bg-gray-800/40 transition">
                    <td class="p-3.5 text-gray-500 dark:text-gray-400 font-mono text-[11px] whitespace-nowrap">${t.date || ''}</td>
                    <td class="p-3.5 font-semibold text-gray-900 dark:text-white">${t.description || 'Sin descripción'}</td>
                    <td class="p-3.5 whitespace-nowrap">
                        <span class="inline-block px-2.5 py-0.5 rounded-lg text-[10px] font-semibold bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-200/60 dark:border-gray-700/60">
                            ${t.category || 'Otros'}
                        </span>
                    </td>
                    <td class="p-3.5 text-right whitespace-nowrap font-mono">
                        <span class="inline-flex items-baseline justify-end gap-1 font-bold text-xs sm:text-sm ${colorClass}">
                            <span class="tracking-tight">${formattedVal}</span>
                            <span class="text-[10px] font-semibold opacity-70">${currentViewingCurrency}</span>
                        </span>
                    </td>
                </tr>
            `;
        }).join('');
    }

    // Gráfica Multi-Línea
    function renderMultiLinePeaksChart() {
        const ctx = document.getElementById('multiLinePeaksChart')?.getContext('2d');
        if (!ctx) return;

        const ChartLib = getChartLib();
        if (!ChartLib) {
            setTimeout(renderMultiLinePeaksChart, 100);
            return;
        }

        if (multiLineChartInstance) multiLineChartInstance.destroy();

        const grouped = {};
        filteredTransactions.forEach(t => {
            const key = t.date;
            if (!grouped[key]) {
                grouped[key] = { totalGastos: 0, ingresos: 0, necesidades: 0, deseos: 0 };
            }

            const rawAmt = parseFloat(t.amount) || 0;
            const originCur = t.originalCurrency || profileBaseCurrency;
            const amt = convertAmount(rawAmt, originCur, currentViewingCurrency);

            if (t.type === 'INCOME') {
                grouped[key].ingresos += amt;
            } else {
                grouped[key].totalGastos += amt;
                const cat = t.category || 'Otros';
                if (['Vivienda', 'Alimentación', 'Transporte', 'Servicios', 'Salud y bienestar', 'Educación'].includes(cat)) {
                    grouped[key].necesidades += amt;
                } else {
                    grouped[key].deseos += amt;
                }
            }
        });

        const labels = Object.keys(grouped).sort();
        const dataTotalGastos = labels.map(l => grouped[l].totalGastos);
        const dataIngresos = labels.map(l => grouped[l].ingresos);
        const dataNecesidades = labels.map(l => grouped[l].necesidades);
        const dataDeseos = labels.map(l => grouped[l].deseos);

        const isMobile = window.innerWidth < 640;
        multiLineChartInstance = new ChartLib(ctx, {
            type: 'line',
            data: {
                labels: labels.length > 0 ? labels : ['Sin datos'],
                datasets: [
                    {
                        label: `Total Gastos (${currentViewingCurrency})`,
                        data: dataTotalGastos.length > 0 ? dataTotalGastos : [0],
                        borderColor: LINE_COLORS.total,
                        backgroundColor: 'rgba(239, 68, 68, 0.08)',
                        borderWidth: isMobile ? 2 : 3,
                        pointBackgroundColor: LINE_COLORS.total,
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1.5,
                        pointRadius: isMobile ? 3 : 5,
                        pointHoverRadius: isMobile ? 5 : 7,
                        tension: 0.35,
                        fill: false
                    },
                    {
                        label: `Ingresos (${currentViewingCurrency})`,
                        data: dataIngresos.length > 0 ? dataIngresos : [0],
                        borderColor: LINE_COLORS.ingresos,
                        borderWidth: isMobile ? 2 : 2.5,
                        borderDash: [4, 4],
                        pointBackgroundColor: LINE_COLORS.ingresos,
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1.5,
                        pointRadius: isMobile ? 3 : 4.5,
                        pointHoverRadius: isMobile ? 5 : 6.5,
                        tension: 0.25,
                        fill: false
                    },
                    {
                        label: `Necesidades Básicas (${currentViewingCurrency})`,
                        data: dataNecesidades.length > 0 ? dataNecesidades : [0],
                        borderColor: LINE_COLORS.necesidades,
                        borderWidth: 1.75,
                        pointBackgroundColor: LINE_COLORS.necesidades,
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1.5,
                        pointRadius: isMobile ? 2.5 : 4,
                        tension: 0.3,
                        fill: false
                    },
                    {
                        label: `Estilo de Vida (${currentViewingCurrency})`,
                        data: dataDeseos.length > 0 ? dataDeseos : [0],
                        borderColor: LINE_COLORS.deseos,
                        borderWidth: 1.75,
                        pointBackgroundColor: LINE_COLORS.deseos,
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 1.5,
                        pointRadius: isMobile ? 2.5 : 4,
                        tension: 0.3,
                        fill: false
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { intersect: false, mode: 'index' },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            font: { family: 'Josefin Sans', size: isMobile ? 10 : 11 },
                            boxWidth: isMobile ? 10 : 14,
                            boxHeight: isMobile ? 8 : 10,
                            padding: isMobile ? 8 : 14
                        }
                    },
                    tooltip: {
                        padding: 10,
                        cornerRadius: 10,
                        titleFont: { family: 'Josefin Sans', size: 11, weight: 'bold' },
                        bodyFont: { family: 'Inter', size: 11 }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            autoSkip: true,
                            maxTicksLimit: isMobile ? 5 : 10,
                            maxRotation: 35,
                            minRotation: 0,
                            font: { family: 'Inter', size: isMobile ? 9 : 10 }
                        }
                    },
                    y: {
                        grace: '15%',
                        grid: { color: 'rgba(156, 163, 175, 0.1)' },
                        ticks: {
                            font: { family: 'Inter', size: isMobile ? 9 : 10 },
                            callback: v => currentViewingCurrency + ' ' + Number(v).toLocaleString('es-MX')
                        }
                    }
                }
            }
        });
    }

    // Donut Categorías
    function renderCategoryDonut() {
        const ctx = document.getElementById('categoryDonutChart')?.getContext('2d');
        if (!ctx) return;

        const ChartLib = getChartLib();
        if (!ChartLib) {
            setTimeout(renderCategoryDonut, 100);
            return;
        }

        if (categoryDonutInstance) categoryDonutInstance.destroy();

        const catTotals = {};
        filteredTransactions.filter(t => t.type === 'EXPENSE').forEach(t => {
            const cat = t.category || 'Otros';
            const rawAmt = parseFloat(t.amount) || 0;
            const originCur = t.originalCurrency || profileBaseCurrency;
            const convertedAmt = convertAmount(rawAmt, originCur, currentViewingCurrency);
            catTotals[cat] = (catTotals[cat] || 0) + convertedAmt;
        });

        const labels = Object.keys(catTotals);
        const data = Object.values(catTotals);
        const palette = ['#3B82F6', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899', '#06B6D4', '#64748B'];

        categoryDonutInstance = new ChartLib(ctx, {
            type: 'doughnut',
            data: {
                labels: labels.length > 0 ? labels : ['Sin gastos'],
                datasets: [{
                    data: data.length > 0 ? data : [1],
                    backgroundColor: labels.length > 0 ? palette.slice(0, labels.length) : ['#94A3B8'],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                cutout: '70%'
            }
        });

        const leg = document.getElementById('categoryLegend');
        const symbol = CURRENCY_SYMBOLS_MAP[currentViewingCurrency] || '$';
        if (leg) {
            if (labels.length > 0) {
                leg.innerHTML = labels.map((l, i) => `
                    <div class="flex justify-between items-center text-[11px] text-gray-600 dark:text-gray-300">
                        <span class="flex items-center gap-1.5">
                            <span class="w-2.5 h-2.5 rounded-full" style="background-color: ${palette[i % palette.length]}"></span>
                            ${l}
                        </span>
                        <strong>${symbol} ${Math.round(data[i]).toLocaleString('es-MX')} ${currentViewingCurrency}</strong>
                    </div>
                `).join('');
            } else {
                leg.innerHTML = '<p class="text-center text-gray-400 text-xs">Sin datos registrados</p>';
            }
        }
    }

    if (filterDateStart) {
        filterDateStart.onchange = () => {
            customSelectedMonth = null;
            if (customMonthDisplay) customMonthDisplay.textContent = 'Todos los Meses';
            applyFilters();
        };
    }

    if (filterDateEnd) {
        filterDateEnd.onchange = () => {
            customSelectedMonth = null;
            if (customMonthDisplay) customMonthDisplay.textContent = 'Todos los Meses';
            applyFilters();
        };
    }

    const selFilterType = document.getElementById('filterType');
    if (selFilterType) selFilterType.onchange = applyFilters;

    const selFilterCat = document.getElementById('filterCategory');
    if (selFilterCat) selFilterCat.onchange = applyFilters;

    const btnShowAll = document.getElementById('btnShowAllTxns');
    if (btnShowAll) {
        btnShowAll.onclick = () => {
            customSelectedMonth = null;
            if (customMonthDisplay) customMonthDisplay.textContent = 'Todos los Meses';
            if (filterDateStart) filterDateStart.value = '';
            if (filterDateEnd) filterDateEnd.value = '';
            if (selFilterType) selFilterType.value = 'all';
            if (selFilterCat) selFilterCat.value = 'all';
            applyFilters();
            window.showToast?.('Vista Completa', 'Mostrando todas las transacciones históricas acumuladas.', '📊');
        };
    }

    const btnReset = document.getElementById('btnResetFilters');
    if (btnReset) {
        btnReset.onclick = () => {
            customSelectedMonth = null;
            if (customMonthDisplay) customMonthDisplay.textContent = 'Todos los Meses';
            if (filterDateStart) filterDateStart.value = '';
            if (filterDateEnd) filterDateEnd.value = '';
            if (selFilterType) selFilterType.value = 'all';
            if (selFilterCat) selFilterCat.value = 'all';
            applyFilters();
        };
    }

    const clearHistoryModal = document.getElementById('clearHistoryModal');
    const btnOpenClear = document.getElementById('btnOpenClearHistoryModal');
    if (btnOpenClear) {
        btnOpenClear.onclick = () => clearHistoryModal?.classList.remove('hidden');
    }

    const btnCancelClear = document.getElementById('btnCancelClearHistory');
    if (btnCancelClear) {
        btnCancelClear.onclick = () => clearHistoryModal?.classList.add('hidden');
    }

    const btnConfirmClear = document.getElementById('btnConfirmClearHistory');
    if (btnConfirmClear) {
        btnConfirmClear.onclick = () => {
            rawTransactions = [];
            filteredTransactions = [];
            localStorage.setItem('financeai_all_transactions', JSON.stringify([]));
            localStorage.setItem('financeai_dashboard_txns', JSON.stringify([]));
            localStorage.setItem('financeai_history_cleared', 'true');
            
            clearHistoryModal?.classList.add('hidden');
            populateCategoryFilter();
            applyFilters();
            window.dispatchEvent(new CustomEvent('financeai_global_balance_updated'));

            window.showToast?.('Historial Eliminado', 'Todas las transacciones históricas han sido borradas.', '🗑️');
        };
    }

    loadData();
</script>
