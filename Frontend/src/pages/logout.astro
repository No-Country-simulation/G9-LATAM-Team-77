---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cerrar Sesión | FinanceAI">
	<div class="w-full flex-grow flex items-center justify-center min-h-[calc(100vh-73px)] relative overflow-hidden bg-gray-50 dark:bg-gray-950 font-inter px-4 py-12">
		
        <!-- Fondo difuminado decorativo con efecto de interfaz financiera -->
        <div class="absolute inset-0 bg-gradient-to-br from-blue-900/20 via-gray-950/80 to-gray-950 pointer-events-none"></div>
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/15 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-purple-600/15 rounded-full blur-3xl pointer-events-none"></div>

		<div class="relative z-10 bg-white/90 dark:bg-gray-900/90 backdrop-blur-2xl rounded-3xl shadow-2xl p-8 sm:p-10 max-w-md w-full mx-auto border border-gray-200 dark:border-gray-800 text-center animate-scale-in">
			<!-- Icono de Salida -->
			<div class="w-16 h-16 mx-auto bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-2xl flex items-center justify-center mb-5 shadow-inner border border-gray-200 dark:border-gray-700">
				<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
			</div>
			
            <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white mb-2 font-josefin">¿Cerrar Sesión?</h2>
			
            <p class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm mb-6 leading-relaxed">
				¿Estás seguro de que deseas salir de tu cuenta? Tendrás que volver a iniciar sesión para acceder a tus análisis financieros.
			</p>
			
			<div class="space-y-2.5">
				<button id="btnConfirmSignout" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-xl transition shadow-md hover:shadow-lg text-xs sm:text-sm">
					Sí, salir de mi cuenta
				</button>
				<button onclick="window.history.back()" class="w-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 font-semibold py-2.5 px-4 rounded-xl transition text-xs sm:text-sm">
					Cancelar
				</button>
			</div>
		</div>
	</div>
</Layout>

<script>
    document.getElementById('btnConfirmSignout')?.addEventListener('click', async () => {
        const btn = document.getElementById('btnConfirmSignout');
        if (btn) {
            btn.textContent = 'Cerrando sesión...';
            btn.classList.add('opacity-70', 'cursor-not-allowed');
        }

        // Limpieza total del almacenamiento local y sesión
        localStorage.clear();
        sessionStorage.clear();

        try {
            const { signOut } = await import("auth-astro/client");
            await signOut({ callbackUrl: '/login' });
        } catch (e) {
            console.error("Fallo al ejecutar signOut:", e);
            window.location.href = '/login';
        }
    });
</script>
