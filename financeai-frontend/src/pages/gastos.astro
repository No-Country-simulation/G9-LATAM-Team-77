---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ingreso de Gastos | FinanceAl">
    <div class="w-full max-w-6xl mx-auto p-6 md:p-8 flex flex-col lg:flex-row gap-8">
        
        <!-- Left Side: Formulario -->
        <div class="w-full lg:w-7/12">
            <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-200">
                <h2 class="text-xl font-bold mb-1">Registrar gasto</h2>
                <p class="text-gray-400 text-xs mb-8">Completa los datos para registrar un nuevo gasto en tu historial</p>

                <form class="space-y-6">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-2">Monto del gasto <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <span class="text-gray-500 font-medium">$</span>
                            </div>
                            <input type="number" step="0.01" class="w-full pl-8 pr-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-shadow text-sm" placeholder="0.00" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 mb-2">Descripción</label>
                        <input type="text" placeholder="Ej: Almuerzo de negocios, transporte, etc." class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-shadow text-sm" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-2">Categoría <span class="text-red-500">*</span></label>
                            <select class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent text-gray-500 text-sm appearance-none bg-white">
                                <option>Selecciona una categoría</option>
                                <option>Alimentación</option>
                                <option>Transporte</option>
                                <option>Salud</option>
                                <option>Educación</option>
                                <option>Ocio</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-700 mb-2">Fecha</label>
                            <input type="date" value="2026-07-28" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent text-gray-700 text-sm" />
                        </div>
                    </div>

                    <button type="button" class="w-full mt-4 bg-[#1e40af] text-white rounded-lg py-3 font-medium hover:bg-blue-800 transition-colors text-sm">
                        Registrar Gasto
                    </button>
                </form>
            </div>
        </div>

        <!-- Right Side: Sidebar -->
        <div class="w-full lg:w-5/12 space-y-4">
            <!-- Stats Row -->
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
                    <p class="text-[10px] text-gray-500 font-bold mb-1">Gastos del mes</p>
                    <p class="text-2xl font-bold text-gray-900">$7,200</p>
                </div>
                <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-200">
                    <p class="text-[10px] text-gray-500 font-bold mb-1">Presupuesto restante</p>
                    <p class="text-2xl font-bold text-[#059669]">$2,800</p>
                </div>
            </div>

            <!-- Gastos recientes -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                <h3 class="font-bold text-sm mb-4 text-gray-800">Gastos recientes</h3>
                <div class="space-y-4">
                    <div class="flex justify-between items-center border-b border-gray-50 pb-3">
                        <div class="flex items-center space-x-4">
                            <div class="w-10 h-10 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center font-bold text-xs">AL</div>
                            <div>
                                <p class="font-bold text-xs text-gray-800">Almuerzo de trabajo</p>
                                <p class="text-[10px] text-gray-400">Alimentación · Hoy</p>
                            </div>
                        </div>
                        <span class="font-bold text-red-500 text-xs">$38.50</span>
                    </div>
                    <div class="flex justify-between items-center border-b border-gray-50 pb-3">
                        <div class="flex items-center space-x-4">
                            <div class="w-10 h-10 bg-purple-50 text-purple-600 rounded-lg flex items-center justify-center font-bold text-xs">TR</div>
                            <div>
                                <p class="font-bold text-xs text-gray-800">Uber al aeropuerto</p>
                                <p class="text-[10px] text-gray-400">Transporte · Ayer</p>
                            </div>
                        </div>
                        <span class="font-bold text-red-500 text-xs">$24.00</span>
                    </div>
                    <div class="flex justify-between items-center border-b border-gray-50 pb-3">
                        <div class="flex items-center space-x-4">
                            <div class="w-10 h-10 bg-orange-50 text-orange-600 rounded-lg flex items-center justify-center font-bold text-xs">ED</div>
                            <div>
                                <p class="font-bold text-xs text-gray-800">Curso de finanzas</p>
                                <p class="text-[10px] text-gray-400">Educación · 26 Ene</p>
                            </div>
                        </div>
                        <span class="font-bold text-red-500 text-xs">$120.00</span>
                    </div>
                     <div class="flex justify-between items-center">
                        <div class="flex items-center space-x-4">
                            <div class="w-10 h-10 bg-green-50 text-green-600 rounded-lg flex items-center justify-center font-bold text-xs">SA</div>
                            <div>
                                <p class="font-bold text-xs text-gray-800">Farmacia</p>
                                <p class="text-[10px] text-gray-400">Salud · 25 Ene</p>
                            </div>
                        </div>
                        <span class="font-bold text-red-500 text-xs">$15.80</span>
                    </div>
                </div>
            </div>

            <!-- Por categoria -->
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
                <h3 class="font-bold text-sm mb-4 text-gray-800">Por categoría (Enero)</h3>
                <div class="space-y-4">
                    <div>
						<div class="flex justify-between text-[11px] mb-1">
							<span class="text-gray-500">Alimentación</span><span class="font-bold text-gray-900">$2,736</span>
						</div>
						<div class="w-full bg-gray-100 h-1 rounded-full"><div class="bg-blue-600 h-1 rounded-full" style="width: 60%"></div></div>
					</div>
                    <div>
						<div class="flex justify-between text-[11px] mb-1">
							<span class="text-gray-500">Transporte</span><span class="font-bold text-gray-900">$1,296</span>
						</div>
						<div class="w-full bg-gray-100 h-1 rounded-full"><div class="bg-indigo-500 h-1 rounded-full" style="width: 35%"></div></div>
					</div>
                    <div>
						<div class="flex justify-between text-[11px] mb-1">
							<span class="text-gray-500">Entretenimiento</span><span class="font-bold text-gray-900">$1,008</span>
						</div>
						<div class="w-full bg-gray-100 h-1 rounded-full"><div class="bg-pink-500 h-1 rounded-full" style="width: 25%"></div></div>
					</div>
                    <div>
						<div class="flex justify-between text-[11px] mb-1">
							<span class="text-gray-500">Suscripciones</span><span class="font-bold text-gray-900">$720</span>
						</div>
						<div class="w-full bg-gray-100 h-1 rounded-full"><div class="bg-red-500 h-1 rounded-full" style="width: 15%"></div></div>
					</div>
                </div>
            </div>
        </div>

    </div>
</Layout>
