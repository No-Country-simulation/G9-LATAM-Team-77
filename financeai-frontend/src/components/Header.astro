---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/^\/|\/$/g, '');
---

<header class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 px-6 py-4 flex items-center justify-between sticky top-0 z-50 transition-colors duration-300">
    <div class="flex items-center space-x-10">
        <!-- Logo -->
        <div class="flex items-center space-x-2.5">
            <div class="flex space-x-1">
                <div class="w-2.5 h-2.5 rounded-full bg-blue-600"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-red-500"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
            </div>
            <span class="font-bold text-lg tracking-tight text-gray-900 dark:text-white">FinanceAl</span>
        </div>

        {currentPath !== 'login' && (
            <nav class="hidden md:flex space-x-6 text-sm font-medium">
                <a href="/"
                    class="pb-4 border-b-2 border-blue-600 text-gray-900 dark:text-white -mb-4 transition-colors">
                    Dashboard
                </a>
            </nav>
        )}
    </div>

    <!-- Dark mode toggle -->
    <button id="themeToggle"
        aria-label="Cambiar tema"
        class="relative w-10 h-10 flex items-center justify-center rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200 text-gray-600 dark:text-gray-300">

        <!-- Sun icon (shown in dark mode) -->
        <svg id="iconSun" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
        </svg>

        <!-- Moon icon (shown in light mode) -->
        <svg id="iconMoon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
                d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"/>
        </svg>
    </button>
</header>

<script is:inline>
    document.getElementById('themeToggle').addEventListener('click', () => {
        const html = document.documentElement;
        if (html.classList.contains('dark')) {
            html.classList.remove('dark');
            localStorage.setItem('theme', 'light');
        } else {
            html.classList.add('dark');
            localStorage.setItem('theme', 'dark');
        }
    });
</script>
