# Copie este archivo como .env y reemplace los valores de ejemplo.
# Nunca suba el archivo .env al repositorio.

# Integracion Backend -> Data Science
PYTHON_COMMAND=../../financeai-data-science/.venv/Scripts/python.exe
DATA_SCIENCE_SCRIPT=../../financeai-data-science/src/predict.py
DATA_SCIENCE_TIMEOUT_SECONDS=30

# Origenes Frontend permitidos, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4321

DB_URL=jdbc:mysql://localhost:3306/financeia?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=tu_usuario_mysql
DB_PASSWORD=tu_contrasena_mysql
JWT_SECRET=reemplaza_con_una_clave_jwt_segura_de_al_menos_32_caracteres
